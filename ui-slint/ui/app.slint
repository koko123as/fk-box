// FK-box main window (Rust + Slint), after compose/BoxApp.kt, ui/Navigator.kt,
// pages/HomePage.kt, ui/Popup.kt and ui/Dialog.kt: the splash and startup
// error, the home destinations on a navigation bar (phone) or rail (wider),
// the routes over them, the popup menu, the dialog and the snackbar.
// Rust (src/app.rs, src/nav.rs, src/pages/*.rs) owns all state.

import { Theme, TextRole, Scheme } from "theme.slint";
import { Icons, Glyph } from "icons.slint";
import { Nav, MenuItem, BarAction, Route, Keyword } from "globals.slint";
import { App, Dash, Proxies, Profiles, Records, Settings, Pages, PageData, ModeItem, Note, KeyValue, NodeRow, GroupRow, ProfileRow, LogRow, ConnectionRow, SettingRow } from "data.slint";
import { Icon, T, Spinner, ProgressBar, Button, Field, Radio, EmptyState, RouteSurface } from "kit.slint";
import { HomePage } from "home.slint";
import { RouteHost } from "routes.slint";
import { Look, Swatch } from "pages/appearance.slint";

export { Theme, Scheme, TextRole, Nav, MenuItem, BarAction, Route, Keyword, Glyph, Icons }
export { Look, Swatch }
export { App, Dash, Proxies, Profiles, Records, Settings, Pages, PageData, ModeItem, Note, KeyValue, NodeRow, GroupRow, ProfileRow, LogRow, ConnectionRow, SettingRow }

// SplashScreen
component Splash inherits Rectangle {
    VerticalLayout {
        alignment: center;
        spacing: 16px;
        Image {
            source: @image-url("box_icon.png");
            width: 96px;
            height: 96px;
            x: (parent.width - self.width) / 2;
        }
        T { text: "FK-box"; role: TextRole.title3; horizontal-alignment: center; }
        Rectangle { height: 16px; }
        HorizontalLayout {
            alignment: center;
            ProgressBar { width: 120px; }
        }
    }
}

// The popup menu (CommonPopupBox's DropdownMenu): at the pressed point,
// kept inside the window; a tap outside closes it.
component MenuLayer inherits Rectangle {
    TouchArea { clicked => { Nav.menu-dismiss(); } }
    property <length> menu-width: min(280px, root.width - 16px);
    menu := Rectangle {
        width: root.menu-width;
        height: min(lay.preferred-height, root.height - Nav.inset-top - Nav.inset-bottom - 16px);
        x: clamp(Nav.menu-x - (Nav.menu-x > root.width / 2 ? self.width : 0px), 8px, root.width - self.width - 8px);
        y: clamp(Nav.menu-y, Nav.inset-top + 8px, root.height - self.height - Nav.inset-bottom - 8px);
        border-radius: 4px;
        background: Theme.s.surface-container;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 2px;
        TouchArea { }
        Flickable {
            content-height: lay.preferred-height;
            lay := VerticalLayout {
                padding-top: 8px;
                padding-bottom: 8px;
                for item[i] in Nav.menu-items: VerticalLayout {
                    if item.divider || (item.section != "" && i > 0): Rectangle {
                        height: 17px;
                        Rectangle { height: 1px; background: Theme.s.outline-variant; }
                    }
                    if item.section != "" && item.label == "": T {
                        text: item.section;
                        role: TextRole.caption1;
                        emphasized: true;
                        color: Theme.s.primary;
                        x: 12px;
                        height: self.preferred-height + 12px;
                        vertical-alignment: bottom;
                    }
                    if item.label != "": Rectangle {
                        height: 48px;
                        property <color> fg: !item.enabled ? Theme.s.on-surface.with-alpha(0.38) : item.danger ? Theme.s.error : Theme.s.on-surface;
                        Rectangle { background: ta.pressed ? Theme.s.on-surface.with-alpha(0.1) : transparent; }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 12px;
                            if item.has-glyph: Icon { glyph: item.glyph; size: 20px; color: fg; y: (parent.height - 20px) / 2; }
                            T { text: item.label; color: fg; horizontal-stretch: 1; }
                            if item.submenu: Icon { glyph: Icons.chevron-forward; size: 20px; color: fg; y: (parent.height - 20px) / 2; }
                            if !item.submenu && item.checked: Icon { glyph: Icons.check; size: 20px; color: Theme.s.primary; y: (parent.height - 20px) / 2; }
                        }
                        ta := TouchArea {
                            enabled: item.enabled;
                            clicked => { Nav.menu-pick(i); }
                        }
                    }
                }
            }
        }
    }
}

// CommonDialog / InputDialog: a Material 3 AlertDialog.
component DialogLayer inherits Rectangle {
    background: Theme.s.scrim.with-alpha(0.32);
    TouchArea { clicked => { Nav.dialog-dismiss(); } }
    property <length> bottom: Nav.keyboard-height > 0 ? Nav.keyboard-height : Nav.inset-bottom;
    card := Rectangle {
        width: min(560px, root.width - 48px);
        height: min(lay.preferred-height, root.height - Nav.inset-top - root.bottom - 48px);
        x: (root.width - self.width) / 2;
        y: max(Nav.inset-top + 24px, (root.height - root.bottom - self.height) / 2);
        border-radius: 28px;
        background: Theme.s.surface-container-high;
        TouchArea { }
        lay := VerticalLayout {
            padding: 24px;
            spacing: 16px;
            T { text: Nav.dialog-title; role: TextRole.title3; wrap: word-wrap; overflow: clip; }
            if Nav.dialog-message != "" || Nav.dialog-options.length > 0: Flickable {
                vertical-stretch: 1;
                min-height: min(body.preferred-height, 80px);
                preferred-height: min(body.preferred-height, 420px);
                content-height: body.preferred-height;
                body := VerticalLayout {
                    spacing: 0px;
                    if Nav.dialog-message != "": TextInput {
                        text: Nav.dialog-message;
                        read-only: true;
                        wrap: word-wrap;
                        single-line: false;
                        font-size: Theme.size(TextRole.subheadline);
                        font-family: Nav.dialog-mono ? Theme.mono : Theme.font-family;
                        color: Theme.s.on-surface-variant;
                    }
                    for o[i] in Nav.dialog-options: Rectangle {
                        height: 48px;
                        HorizontalLayout {
                            spacing: 16px;
                            Radio { selected: i == Nav.dialog-option; y: (parent.height - self.height) / 2; }
                            T { text: o; horizontal-stretch: 1; }
                        }
                        TouchArea { clicked => { Nav.dialog-pick(i); } }
                    }
                }
            }
            if Nav.dialog-input: VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    spacing: 8px;
                    f := Field {
                        text <=> Nav.dialog-text;
                        hint: Nav.dialog-hint;
                        invalid: Nav.dialog-error != "";
                        multiline: Nav.dialog-multiline;
                        field-min: Nav.dialog-multiline ? 160px : 56px;
                        input-type: Nav.dialog-number ? InputType.number : InputType.text;
                        horizontal-stretch: 1;
                        edited(t) => { Nav.dialog-edited(t); }
                        accepted(t) => { Nav.dialog-action(Nav.dialog-actions.length - 1, t); }
                        init => { self.focus-input(); }
                    }
                    if Nav.dialog-suffix != "": T { text: Nav.dialog-suffix; color: Theme.s.on-surface-variant; horizontal-stretch: 0; }
                }
                if Nav.dialog-error != "": T { text: Nav.dialog-error; role: TextRole.caption1; color: Theme.s.error; x: 16px; wrap: word-wrap; }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                for a[i] in Nav.dialog-actions: Button {
                    label: a;
                    kind: 2;
                    text-color: i == Nav.dialog-actions.length - 1 && Nav.dialog-danger ? Theme.s.error : Theme.s.primary;
                    clicked => { Nav.dialog-action(i, Nav.dialog-text); }
                }
            }
        }
    }
}

// The snackbar, above the navigation bar.
component Snackbar inherits Rectangle {
    border-radius: 4px;
    background: Theme.s.inverse-surface;
    height: txt.preferred-height + 28px;
    txt := T {
        x: 16px;
        width: parent.width - 32px;
        text: Nav.toast;
        role: TextRole.subheadline;
        color: Theme.s.on-inverse-surface;
        wrap: word-wrap;
        overflow: clip;
    }
    TouchArea { clicked => { Nav.dismiss-toast(); } }
}

export component AppWindow inherits Window {
    title: "FK-box";
    background: Theme.s.surface;
    default-font-family: Theme.font-family;

    init => {
        Nav.width = self.width;
        Nav.height = self.height;
        fs.focus();
    }
    changed width => { Nav.width = self.width; }
    changed height => { Nav.height = self.height; }
    property <length> top-inset: self.safe-area-insets.top;
    property <length> bottom-inset: self.safe-area-insets.bottom;
    property <length> left-inset: self.safe-area-insets.left;
    property <length> right-inset: self.safe-area-insets.right;
    property <length> keyboard: self.virtual-keyboard-size.height > 0 ? max(0px, self.height - self.virtual-keyboard-position.y) : 0px;
    changed top-inset => { Nav.inset-top = self.top-inset; }
    changed bottom-inset => { Nav.inset-bottom = self.bottom-inset; }
    changed left-inset => { Nav.inset-left = self.left-inset; }
    changed right-inset => { Nav.inset-right = self.right-inset; }
    changed keyboard => { Nav.keyboard-height = self.keyboard; }
    property <int> focus-tick: Nav.focus-tick;
    changed focus-tick => { fs.focus(); }

    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Back || event.text == Key.Escape) {
                return Nav.back() ? EventResult.accept : EventResult.reject;
            }
            EventResult.reject
        }

        Rectangle {
            y: Nav.inset-top;
            x: Nav.inset-left;
            width: parent.width - Nav.inset-left - Nav.inset-right;
            height: parent.height - Nav.inset-top;

            if !Nav.ready && Nav.startup-error == "": Splash { }
            if !Nav.ready && Nav.startup-error != "": EmptyState {
                glyph: Icons.info;
                title: Nav.startup-error;
                action-label: @tr("Retry");
                action => { Nav.retry-startup(); }
            }
            if Nav.ready: HomePage { }
            if Nav.ready: RouteHost { }
        }

        if Nav.menu-open: MenuLayer { }
        if Nav.dialog-open: DialogLayer { }
        if Nav.toast != "": Snackbar {
            x: 16px + Nav.inset-left;
            width: min(560px, parent.width - 32px - Nav.inset-left - Nav.inset-right);
            y: parent.height - self.height - 16px - max(Nav.keyboard-height, Nav.inset-bottom + (Nav.mobile ? 80px : 0px));
        }
    }
}
