// FK-box main window (Rust + Slint, Material Design 3): the splash and
// startup error, the home destinations on the floating navigation bar (compact) or
// rail (medium and wider), the routes over them, the M3 menu, the basic
// dialog and the snackbar.
// Rust (src/app.rs, src/nav.rs, src/pages/*.rs) owns all state.

import { Theme, TextRole, Scheme } from "theme.slint";
import { Icons, Glyph } from "icons.slint";
import { Nav, MenuItem, BarAction, Route, Keyword, NativeIme, NativeImeSpec, Motion } from "globals.slint";
import { App, Dash, Proxies, Profiles, Pages, PageData, ModeItem, Note, KeyValue, DashCell, DashRow, ServiceItem, NodeRow, GroupRow, ProfileRow, SettingRow } from "data.slint";
import { Mid, Icon, T, Spinner, ProgressBar, Button, Field, Radio, EmptyState, StateLayer, Ripple, Surface, Tap, Appear } from "kit.slint";
import { HomePage } from "home.slint";
import { RouteHost } from "routes.slint";
import { Look, Swatch } from "pages/appearance.slint";

export { Theme, Scheme, TextRole, Nav, Motion, MenuItem, BarAction, Route, Keyword, Glyph, Icons, NativeIme, NativeImeSpec }
export { Look, Swatch }
export { App, Dash, Proxies, Profiles, Pages, PageData, ModeItem, Note, KeyValue, DashCell, DashRow, ServiceItem, NodeRow, GroupRow, ProfileRow, SettingRow }

// SplashScreen
component Splash inherits Rectangle {
    VerticalLayout {
        alignment: center;
        spacing: 16px;
        HorizontalLayout {
            alignment: center;
            Image {
                source: @image-url("box_icon.png");
                width: 96px;
                height: 96px;
            }
        }
        T { text: "fk-box"; role: TextRole.headline-small; horizontal-alignment: center; }
        Rectangle { height: 16px; }
        HorizontalLayout {
            alignment: center;
            ProgressBar { width: 120px; }
        }
    }
}

// The M3 menu: at the pressed point, kept inside the window; a tap outside
// closes it. Extra-small corners on the opaque surface-container role with a
// level 2 shadow (it overlaps the page), 8 dp vertical padding, 48 dp items with a
// 24 dp leading icon and the label in label-large, and a state layer.
component MenuLayer inherits Rectangle {
    TouchArea { clicked => { Nav.menu-dismiss(); } }
    property <length> menu-width: min(280px, root.width - 16px);
    menu := Surface {
        width: root.menu-width;
        height: min(lay.preferred-height, root.height - Nav.inset-top - Nav.inset-bottom - 16px);
        x: clamp(Nav.menu-x - (Nav.menu-x > root.width / 2 ? self.width : 0px), 8px, root.width - self.width - 8px);
        y: clamp(Nav.menu-y, Nav.inset-top + 8px, root.height - self.height - Nav.inset-bottom - 8px);
        border-radius: Theme.corner-extra-small;
        level: 2;
        elevation: 2;
        accessible-role: list;
        TouchArea { }
        Flickable {
            content-height: lay.preferred-height;
            lay := VerticalLayout {
                padding-top: 8px;
                padding-bottom: 8px;
                for item[i] in Nav.menu-items: VerticalLayout {
                    if item.divider || (item.section != "" && i > 0): Rectangle {
                        height: 17px;
                        Rectangle { height: 1px; background: Theme.s.outline-variant; }
                    }
                    if item.section != "" && item.label == "": T {
                        text: item.section;
                        role: TextRole.title-small;
                        color: Theme.s.primary;
                        x: 12px;
                        height: self.preferred-height + 12px;
                        vertical-alignment: bottom;
                    }
                    if item.label != "": Rectangle {
                        height: 48px;
                        property <color> fg: !item.enabled ? Theme.s.on-surface.with-alpha(Theme.disabled-content) : item.danger ? Theme.s.error : Theme.s.on-surface;
                        property <color> icon-fg: !item.enabled ? Theme.s.on-surface.with-alpha(Theme.disabled-content) : item.danger ? Theme.s.error : Theme.s.on-surface-variant;
                        accessible-role: list-item;
                        accessible-label: item.label;
                        accessible-checked: item.checked;
                        accessible-enabled: item.enabled;
                        accessible-action-default => { if (item.enabled) { Nav.menu-pick(i); } }
                        StateLayer { enabled: item.enabled; ink: parent.fg; pressed: ta.pressed; hover: ta.has-hover; }
                        mrip := Ripple { enabled: item.enabled; ink: parent.fg; }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 12px;
                            if item.has-glyph: Icon { glyph: item.glyph; size: 24px; color: icon-fg; y: (parent.height - 24px) / 2; }
                            T { text: item.label; role: TextRole.label-large; color: fg; horizontal-stretch: 1; }
                            if item.submenu: Icon { glyph: Icons.chevron-forward; size: 24px; color: icon-fg; y: (parent.height - 24px) / 2; }
                            if !item.submenu && item.checked: Icon { glyph: Icons.check; size: 24px; color: Theme.s.primary; y: (parent.height - 24px) / 2; }
                        }
                        ta := TouchArea {
                            enabled: item.enabled;
                            clicked => { Nav.menu-pick(i); }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) { mrip.down(self.mouse-x, self.mouse-y); }
                                else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { mrip.up(); }
                            }
                            changed pressed => { if (!self.pressed) { mrip.up(); } }
                            changed has-hover => { if (!self.has-hover) { mrip.up(); } }
                        }
                    }
                }
            }
        }
    }
}

// The M3 basic dialog: extra-large corners on the opaque
// surface-container-high role over a 32 % scrim, 24 dp padding, the headline in headline-small, supporting text
// in body-medium, choices as radio rows, an outlined text field, and text
// buttons at the end (the last confirms; `dialog-danger` paints it in error).
//
// It grows in from `motion-dialog-scale` as it fades in and, once closed,
// only fades out at the size it had (FlClash showFloatingDialog), on a
// critically damped curve over `motion-dialog`; the scrim fades with it.
// While it leaves (`leaving`) it shows what it last showed and takes no input.
component DialogLayer inherits Rectangle {
    in property <bool> leaving;
    property <duration> start: animation-tick();
    property <bool> moving: true;
    property <float> t: root.moving ? Theme.progress(animation-tick(), root.start, Theme.motion-dialog) : 1;
    property <float> shown: root.leaving ? 1 - Theme.ease-spring(root.t) : Theme.ease-spring(root.t);
    property <float> held: 1;
    property <float> grow: root.leaving ? root.held : Theme.motion-dialog-scale + (1 - Theme.motion-dialog-scale) * Theme.ease-spring(root.t);
    changed leaving => {
        root.held = root.leaving ? Theme.motion-dialog-scale + (1 - Theme.motion-dialog-scale) * Theme.ease-spring(root.t) : 1;
        root.start = animation-tick();
        root.moving = true;
        if (done.running) { done.restart(); } else { done.start(); }
    }
    done := Timer {
        interval: Theme.motion-dialog + 16ms;
        triggered => {
            self.stop();
            root.moving = false;
        }
    }
    background: Theme.s.scrim.with-alpha(0.32 * root.shown);
    TouchArea { enabled: !root.leaving; clicked => { Nav.dialog-dismiss(); } }
    property <length> bottom: Nav.keyboard-height > 0 ? Nav.keyboard-height : Nav.inset-bottom;
    card := Surface {
        width: clamp(root.width - 48px, min(280px, root.width - 16px), 560px);
        height: min(lay.preferred-height, root.height - Nav.inset-top - root.bottom - 48px);
        x: (root.width - self.width) / 2;
        y: max(Nav.inset-top + 24px, (root.height - root.bottom - self.height) / 2);
        border-radius: Theme.corner-extra-large;
        level: 3;
        opacity: root.shown;
        transform-scale: root.grow;
        accessible-role: groupbox;
        accessible-label: Nav.dialog-title;
        TouchArea { }
        // Swallows taps while the dialog fades out.
        if root.leaving: TouchArea { z: 10; }
        lay := VerticalLayout {
            padding: 24px;
            spacing: 16px;
            T { text: Nav.dialog-title; role: TextRole.headline-small; wrap: word-wrap; overflow: clip; }
            if Nav.dialog-message != "" || Nav.dialog-options.length > 0: Flickable {
                vertical-stretch: 1;
                min-height: min(body.preferred-height, 80px);
                preferred-height: min(body.preferred-height, 420px);
                content-height: body.preferred-height;
                body := VerticalLayout {
                    spacing: 0px;
                    if Nav.dialog-message != "": TextInput {
                        text: Nav.dialog-message;
                        read-only: true;
                        wrap: word-wrap;
                        single-line: false;
                        font-size: Theme.size(TextRole.body-medium);
                        letter-spacing: Theme.tracking(TextRole.body-medium);
                        font-family: Nav.dialog-mono ? Theme.mono : Theme.font-family;
                        color: Theme.s.on-surface-variant;
                    }
                    for o[i] in Nav.dialog-options: Rectangle {
                        height: 56px;
                        accessible-role: radio-button;
                        accessible-label: o;
                        accessible-checked: i == Nav.dialog-option;
                        accessible-action-default => { Nav.dialog-pick(i); }
                        Tap { border-radius: Theme.corner-small; clicked => { Nav.dialog-pick(i); } }
                        HorizontalLayout {
                            spacing: 8px;
                            Mid { Radio { selected: i == Nav.dialog-option; } }
                            T { text: o; role: TextRole.body-large; horizontal-stretch: 1; }
                        }
                    }
                }
            }
            if Nav.dialog-input: VerticalLayout {
                spacing: 4px;
                padding-top: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    f := Field {
                        text <=> Nav.dialog-text;
                        invalid: Nav.dialog-error != "";
                        multiline: Nav.dialog-multiline;
                        container: Theme.s.surface-container-high;
                        field-min: Nav.dialog-multiline ? 160px : 56px;
                        input-type: Nav.dialog-number ? InputType.number : InputType.text;
                        horizontal-stretch: 1;
                        edited(t) => { Nav.dialog-edited(t); }
                        accepted(t) => { Nav.dialog-action(Nav.dialog-actions.length - 1, t); }
                        init => { self.focus-input(); }
                    }
                    if Nav.dialog-suffix != "": T { text: Nav.dialog-suffix; color: Theme.s.on-surface-variant; horizontal-stretch: 0; }
                }
                // Supporting text: the error names the problem (not color alone).
                if Nav.dialog-error != "": HorizontalLayout {
                    padding-left: 16px;
                    spacing: 4px;
                    Mid { Icon { glyph: Icons.info; size: 16px; color: Theme.s.error; } }
                    T { text: Nav.dialog-error; role: TextRole.body-small; color: Theme.s.error; wrap: word-wrap; horizontal-stretch: 1; }
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                padding-top: 8px;
                for a[i] in Nav.dialog-actions: Button {
                    label: a;
                    kind: 2;
                    text-color: i == Nav.dialog-actions.length - 1 && Nav.dialog-danger ? Theme.s.error : Theme.s.primary;
                    clicked => { Nav.dialog-action(i, Nav.dialog-text); }
                }
            }
        }
    }
}

// The M3 snackbar: inverse-surface, extra-small corners, body-medium, a
// level 3 shadow; above the floating navigation bar. A tap dismisses it.
component Snackbar inherits Rectangle {
    border-radius: Theme.corner-extra-small;
    background: Theme.s.inverse-surface;
    drop-shadow-blur: Theme.shadow-blur(3);
    drop-shadow-offset-y: Theme.shadow-offset(3);
    drop-shadow-color: Theme.shadow-color(3);
    height: max(48px, txt.preferred-height + 28px);
    accessible-role: AccessibleRole.text;
    accessible-label: Nav.toast;
    txt := T {
        x: 16px;
        width: parent.width - 32px;
        text: Nav.toast;
        role: TextRole.body-medium;
        color: Theme.s.on-inverse-surface;
        wrap: word-wrap;
        overflow: clip;
    }
    TouchArea { clicked => { Nav.dismiss-toast(); } }
}

export component AppWindow inherits Window {
    title: "fk-box";
    background: Theme.s.surface;
    default-font-family: Theme.font-family;

    init => {
        Nav.width = self.width;
        Nav.height = self.height;
        fs.focus();
    }
    changed width => { Nav.width = self.width; }
    changed height => { Nav.height = self.height; }
    // 1phx follows the window's scale factor, so these are recomputed when it
    // changes after the host sent its insets.
    property <length> top-inset: Nav.host-insets ? Nav.host-top-px * 1phx : self.safe-area-insets.top;
    property <length> bottom-inset: Nav.host-insets ? Nav.host-bottom-px * 1phx : self.safe-area-insets.bottom;
    property <length> left-inset: Nav.host-insets ? Nav.host-left-px * 1phx : self.safe-area-insets.left;
    property <length> right-inset: Nav.host-insets ? Nav.host-right-px * 1phx : self.safe-area-insets.right;
    property <length> keyboard: self.virtual-keyboard-size.height > 0 ? max(0px, self.height - self.virtual-keyboard-position.y) : 0px;
    changed top-inset => { Nav.inset-top = self.top-inset; }
    changed bottom-inset => { Nav.inset-bottom = self.bottom-inset; }
    changed left-inset => { Nav.inset-left = self.left-inset; }
    changed right-inset => { Nav.inset-right = self.right-inset; }
    changed keyboard => { Nav.keyboard-height = self.keyboard; }
    // The closed dialog stays while it fades out (DialogLayer).
    property <bool> dialog-open: Nav.dialog-open;
    property <bool> dialog-leaving;
    changed dialog-open => {
        root.dialog-leaving = !Nav.dialog-open && Theme.motion-on;
        if (root.dialog-leaving) {
            if (dialog-left.running) { dialog-left.restart(); } else { dialog-left.start(); }
        }
    }
    dialog-left := Timer {
        running: false;
        interval: Theme.motion-dialog + 16ms;
        triggered => {
            self.stop();
            root.dialog-leaving = false;
        }
    }
    property <int> focus-tick: Nav.focus-tick;
    changed focus-tick => { fs.focus(); }

    // Whether the last Back press closed something: its release is accepted
    // too, or Android's NativeActivity takes the unhandled release as its own
    // Back and finishes the activity (back to the launcher).
    property <bool> back-taken;
    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Back || event.text == Key.Escape) {
                root.back-taken = Nav.back();
                return root.back-taken ? EventResult.accept : EventResult.reject;
            }
            EventResult.reject
        }
        key-released(event) => {
            if (event.text == Key.Back || event.text == Key.Escape) {
                let taken = root.back-taken;
                root.back-taken = false;
                return taken ? EventResult.accept : EventResult.reject;
            }
            EventResult.reject
        }

        Rectangle {
            y: Nav.inset-top;
            x: Nav.inset-left;
            width: parent.width - Nav.inset-left - Nav.inset-right;
            height: parent.height - Nav.inset-top;

            if !Nav.ready && Nav.startup-error == "": Splash { }
            if !Nav.ready && Nav.startup-error != "": Appear { EmptyState {
                glyph: Icons.info;
                title: Nav.startup-error;
                action-label: @tr("Retry");
                action => { Nav.retry-startup(); }
            } }
            if Nav.ready: Appear { HomePage { } }
            if Nav.ready: RouteHost { }
        }

        if Nav.menu-open: MenuLayer { }
        if Nav.dialog-open || root.dialog-leaving: DialogLayer { leaving: !Nav.dialog-open; }
        if Nav.toast != "": Snackbar {
            x: 16px + Nav.inset-left;
            width: min(560px, parent.width - 32px - Nav.inset-left - Nav.inset-right);
            // Above the floating bar, and down with it when it slides away.
            y: parent.height - self.height - 16px - max(Nav.keyboard-height, Nav.mobile ? Nav.home-bottom : Nav.inset-bottom);
            animate y { duration: Theme.motion-medium; easing: Theme.easing-standard; }
        }
    }
}
