// FK-box main window (Rust + Slint). The pages read plain rows prepared by
// src/lib.rs from BoxBridge events; every action goes back through callbacks.

import { Button, LineEdit, ListView, ScrollView, Palette } from "std-widgets.slint";

export struct ProfileRow {
    id: string,
    name: string,
    detail: string,
    usage: string,
    usage-ratio: float,
    remote: bool,
    selected: bool,
}

export struct NodeRow {
    tag: string,
    kind: string,
    delay: string,
    // 0 untested, 1 fast, 2 slow, 3 timeout
    level: int,
    selected: bool,
}

export struct GroupRow {
    tag: string,
    kind: string,
    selected: string,
    selectable: bool,
    expanded: bool,
    items: [NodeRow],
}

export struct LogRow {
    level: string,
    message: string,
}

global Theme {
    out property <length> radius: 16px;
    out property <length> pad: 16px;
    out property <color> good: #2e9d5b;
    out property <color> warn: #d28b1e;
    out property <color> bad: #d64545;
    out property <color> card: Palette.alternate-background;
    out property <color> muted: Palette.foreground.with-alpha(0.6);
}

component Card inherits Rectangle {
    background: Theme.card;
    border-radius: Theme.radius;
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 32px;
    border-radius: 16px;
    background: active ? Palette.accent-background : Theme.card;
    border-width: active ? 0 : 1px;
    border-color: Palette.border;
    min-width: label.preferred-width + 24px;
    label := Text {
        text: root.text;
        color: active ? Palette.accent-foreground : Palette.foreground;
        font-size: 13px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    TouchArea { clicked => { root.clicked(); } }
}

component IconButton inherits Rectangle {
    in property <string> text;
    in property <color> tint: Palette.accent-background;
    callback clicked();
    height: 36px;
    min-width: label.preferred-width + 24px;
    border-radius: 18px;
    background: touch.pressed ? tint.with-alpha(0.25) : tint.with-alpha(0.12);
    label := Text {
        text: root.text;
        color: root.tint;
        font-size: 14px;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component PageTitle inherits HorizontalLayout {
    in property <string> text;
    padding-left: Theme.pad;
    padding-right: Theme.pad;
    padding-top: 12px;
    padding-bottom: 8px;
    Text {
        text: root.text;
        font-size: 24px;
        font-weight: 700;
        color: Palette.foreground;
        vertical-alignment: center;
    }
}

component Stat inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 2px;
    Text { text: root.label; font-size: 12px; color: Theme.muted; }
    Text { text: root.value; font-size: 17px; font-weight: 600; color: Palette.foreground; }
}

component HomePage inherits VerticalLayout {
    in property <string> status;
    in property <string> status-text;
    in property <string> profile-name;
    in property <string> upload;
    in property <string> download;
    in property <string> memory;
    in property <string> uptime;
    in property <string> mode;
    in property <[string]> modes;
    in property <string> versions;
    in property <bool> busy;
    callback toggle();
    callback set-mode(string);
    callback open-profiles();

    property <bool> running: status == "Started";

    PageTitle { text: "FK-box"; }
    ScrollView {
        VerticalLayout {
            padding: Theme.pad;
            padding-top: 4px;
            spacing: 12px;

            Card {
                VerticalLayout {
                    padding: 20px;
                    spacing: 16px;
                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                            width: 12px;
                            height: 12px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 6px;
                            background: root.running ? Theme.good : (root.status == "Stopped" ? Theme.muted : Theme.warn);
                        }
                        Text {
                            text: root.status-text;
                            font-size: 18px;
                            font-weight: 600;
                            color: Palette.foreground;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        height: 56px;
                        border-radius: 28px;
                        background: root.busy ? Theme.muted : (root.running ? Theme.bad : Palette.accent-background);
                        Text {
                            text: root.busy ? "请稍候…" : (root.running ? "停止" : "启动");
                            color: Palette.accent-foreground;
                            font-size: 18px;
                            font-weight: 700;
                        }
                        TouchArea {
                            enabled: !root.busy;
                            clicked => { root.toggle(); }
                        }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 6px;
                    Text { text: "当前配置"; font-size: 12px; color: Theme.muted; }
                    HorizontalLayout {
                        Text {
                            text: root.profile-name == "" ? "未选择" : root.profile-name;
                            font-size: 17px;
                            font-weight: 600;
                            color: Palette.foreground;
                            overflow: elide;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        IconButton { text: "切换"; clicked => { root.open-profiles(); } }
                    }
                }
            }

            Card {
                HorizontalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Stat { label: "上传"; value: root.upload; horizontal-stretch: 1; }
                    Stat { label: "下载"; value: root.download; horizontal-stretch: 1; }
                    Stat { label: "内存"; value: root.memory; horizontal-stretch: 1; }
                }
            }

            if root.running && root.uptime != "": Card {
                HorizontalLayout {
                    padding: 16px;
                    Stat { label: "已运行"; value: root.uptime; }
                }
            }

            if root.modes.length > 0: Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text { text: "出站模式"; font-size: 12px; color: Theme.muted; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        for m in root.modes: Chip {
                            text: m;
                            active: m == root.mode;
                            clicked => { root.set-mode(m); }
                        }
                    }
                }
            }

            Text {
                text: root.versions;
                font-size: 11px;
                color: Theme.muted;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}

component ProfilesPage inherits VerticalLayout {
    in property <[ProfileRow]> profiles;
    callback select(string);
    callback update(string);
    callback remove(string, string);
    callback add();

    HorizontalLayout {
        padding-right: Theme.pad;
        PageTitle { text: "配置"; horizontal-stretch: 1; }
        IconButton { text: "＋ 订阅"; y: 12px; clicked => { root.add(); } }
    }
    if root.profiles.length == 0: Text {
        text: "还没有配置。点右上角添加订阅链接。";
        color: Theme.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
        vertical-stretch: 1;
    }
    if root.profiles.length > 0: ListView {
        vertical-stretch: 1;
        for p in root.profiles: VerticalLayout {
            padding-left: Theme.pad;
            padding-right: Theme.pad;
            padding-bottom: 10px;
            Card {
                border-width: p.selected ? 2px : 0;
                border-color: Palette.accent-background;
                TouchArea { clicked => { root.select(p.id); } }
                VerticalLayout {
                    padding: 14px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: p.name;
                            font-size: 16px;
                            font-weight: 600;
                            color: Palette.foreground;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if p.selected: Text { text: "使用中"; font-size: 12px; color: Palette.accent-background; }
                    }
                    Text { text: p.detail; font-size: 12px; color: Theme.muted; overflow: elide; }
                    if p.usage != "": VerticalLayout {
                        spacing: 4px;
                        Rectangle {
                            height: 6px;
                            border-radius: 3px;
                            background: Palette.border;
                            Rectangle {
                                x: 0;
                                width: parent.width * clamp(p.usage-ratio, 0, 1);
                                height: parent.height;
                                border-radius: 3px;
                                background: p.usage-ratio > 0.9 ? Theme.bad : Palette.accent-background;
                            }
                        }
                        Text { text: p.usage; font-size: 12px; color: Theme.muted; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        if p.remote: IconButton { text: "更新"; clicked => { root.update(p.id); } }
                        IconButton { text: "删除"; tint: Theme.bad; clicked => { root.remove(p.id, p.name); } }
                    }
                }
            }
        }
    }
}

component ProxiesPage inherits VerticalLayout {
    in property <[GroupRow]> groups;
    in property <bool> running;
    callback toggle-group(string);
    callback test(string);
    callback choose(string, string);

    PageTitle { text: "代理"; }
    if !root.running || root.groups.length == 0: Text {
        text: root.running ? "当前配置没有代理组。" : "启动后显示代理组。";
        color: Theme.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
        vertical-stretch: 1;
    }
    if root.running && root.groups.length > 0: ListView {
        vertical-stretch: 1;
        for g in root.groups: VerticalLayout {
            padding-left: Theme.pad;
            padding-right: Theme.pad;
            padding-bottom: 10px;
            Card {
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            TouchArea {
                                clicked => { root.toggle-group(g.tag); }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: g.tag; font-size: 16px; font-weight: 600; color: Palette.foreground; overflow: elide; }
                                    Text { text: g.kind + " · " + g.selected; font-size: 12px; color: Theme.muted; overflow: elide; }
                                }
                            }
                        }
                        IconButton { text: "测速"; clicked => { root.test(g.tag); } }
                        IconButton { text: g.expanded ? "收起" : "展开"; tint: Palette.foreground; clicked => { root.toggle-group(g.tag); } }
                    }
                    if g.expanded: VerticalLayout {
                        spacing: 6px;
                        for n in g.items: Rectangle {
                            height: 48px;
                            border-radius: 12px;
                            background: n.selected ? Palette.accent-background.with-alpha(0.15) : transparent;
                            border-width: n.selected ? 1px : 0;
                            border-color: Palette.accent-background;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text { text: n.tag; font-size: 14px; color: Palette.foreground; overflow: elide; }
                                    Text { text: n.kind; font-size: 11px; color: Theme.muted; }
                                }
                                Text {
                                    text: n.delay;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    color: n.level == 1 ? Theme.good : n.level == 2 ? Theme.warn : n.level == 3 ? Theme.bad : Theme.muted;
                                }
                            }
                            TouchArea {
                                enabled: g.selectable;
                                clicked => { root.choose(g.tag, n.tag); }
                            }
                        }
                    }
                }
            }
        }
    }
}

component LogsPage inherits VerticalLayout {
    in property <[LogRow]> logs;
    callback clear();

    HorizontalLayout {
        padding-right: Theme.pad;
        PageTitle { text: "日志"; horizontal-stretch: 1; }
        IconButton { text: "清空"; y: 12px; clicked => { root.clear(); } }
    }
    if root.logs.length == 0: Text {
        text: "暂无日志。";
        color: Theme.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
        vertical-stretch: 1;
    }
    if root.logs.length > 0: ListView {
        vertical-stretch: 1;
        for l in root.logs: HorizontalLayout {
            padding-left: Theme.pad;
            padding-right: Theme.pad;
            padding-bottom: 6px;
            spacing: 8px;
            Text {
                text: l.level;
                width: 48px;
                font-size: 11px;
                font-weight: 600;
                color: l.level == "ERROR" || l.level == "FATAL" || l.level == "PANIC" ? Theme.bad : l.level == "WARN" ? Theme.warn : Theme.muted;
            }
            Text {
                text: l.message;
                font-size: 12px;
                color: Palette.foreground;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
    }
}

component NavItem inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> active;
    callback clicked();
    horizontal-stretch: 1;
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Rectangle {
            height: 30px;
            width: 56px;
            x: (parent.width - self.width) / 2;
            border-radius: 15px;
            background: root.active ? Palette.accent-background.with-alpha(0.18) : transparent;
            Text { text: root.glyph; font-size: 16px; color: root.active ? Palette.accent-background : Theme.muted; }
        }
        Text {
            text: root.label;
            font-size: 12px;
            horizontal-alignment: center;
            color: root.active ? Palette.accent-background : Theme.muted;
        }
    }
    TouchArea { clicked => { root.clicked(); } }
}

export component AppWindow inherits Window {
    title: "FK-box";
    background: Palette.background;

    in-out property <int> tab: 0;
    in property <bool> ready;
    in property <string> startup-error;
    in property <string> status: "Stopped";
    in property <string> status-text: "未连接";
    in property <bool> busy;
    in property <string> profile-name;
    in property <string> upload: "0 B/s";
    in property <string> download: "0 B/s";
    in property <string> memory: "-";
    in property <string> uptime;
    in property <string> mode;
    in property <[string]> modes;
    in property <string> versions;
    in property <[ProfileRow]> profiles;
    in property <[GroupRow]> groups;
    in property <[LogRow]> logs;
    in-out property <string> toast;
    in-out property <bool> adding;
    in-out property <string> add-name;
    in-out property <string> add-url;
    in-out property <string> confirm-delete-id;
    in-out property <string> confirm-delete-name;

    callback tab-changed(int);
    callback retry();
    callback toggle-service();
    callback set-mode(string);
    callback select-profile(string);
    callback update-profile(string);
    callback delete-profile(string);
    callback add-profile(string, string);
    callback toggle-group(string);
    callback test-group(string);
    callback select-node(string, string);
    callback clear-logs();
    callback dismiss-toast();

    function go(index: int) {
        root.tab = index;
        root.tab-changed(index);
    }

    VerticalLayout {
        padding-top: root.safe-area-insets.top;
        padding-left: root.safe-area-insets.left;
        padding-right: root.safe-area-insets.right;

        if !root.ready: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 16px;
            padding: 32px;
            Text {
                text: root.startup-error == "" ? "FK-box 正在启动…" : "启动失败：" + root.startup-error;
                horizontal-alignment: center;
                wrap: word-wrap;
                color: root.startup-error == "" ? Theme.muted : Theme.bad;
            }
            if root.startup-error != "": HorizontalLayout {
                alignment: center;
                IconButton { text: "重试"; clicked => { root.retry(); } }
            }
        }

        if root.ready: Rectangle {
            vertical-stretch: 1;
            if root.tab == 0: HomePage {
                width: parent.width;
                height: parent.height;
                status: root.status;
                status-text: root.status-text;
                busy: root.busy;
                profile-name: root.profile-name;
                upload: root.upload;
                download: root.download;
                memory: root.memory;
                uptime: root.uptime;
                mode: root.mode;
                modes: root.modes;
                versions: root.versions;
                toggle => { root.toggle-service(); }
                set-mode(m) => { root.set-mode(m); }
                open-profiles => { root.go(2); }
            }
            if root.tab == 1: ProxiesPage {
                width: parent.width;
                height: parent.height;
                groups: root.groups;
                running: root.status == "Started";
                toggle-group(t) => { root.toggle-group(t); }
                test(t) => { root.test-group(t); }
                choose(g, n) => { root.select-node(g, n); }
            }
            if root.tab == 2: ProfilesPage {
                width: parent.width;
                height: parent.height;
                profiles: root.profiles;
                select(id) => { root.select-profile(id); }
                update(id) => { root.update-profile(id); }
                remove(id, name) => {
                    root.confirm-delete-name = name;
                    root.confirm-delete-id = id;
                }
                add => {
                    root.add-name = "";
                    root.add-url = "";
                    root.adding = true;
                }
            }
            if root.tab == 3: LogsPage {
                width: parent.width;
                height: parent.height;
                logs: root.logs;
                clear => { root.clear-logs(); }
            }
        }

        if root.ready: Rectangle {
            height: 68px + root.safe-area-insets.bottom;
            background: Theme.card;
            HorizontalLayout {
                padding-bottom: root.safe-area-insets.bottom;
                NavItem { glyph: "⌂"; label: "首页"; active: root.tab == 0; clicked => { root.go(0); } }
                NavItem { glyph: "⇄"; label: "代理"; active: root.tab == 1; clicked => { root.go(1); } }
                NavItem { glyph: "☰"; label: "配置"; active: root.tab == 2; clicked => { root.go(2); } }
                NavItem { glyph: "≡"; label: "日志"; active: root.tab == 3; clicked => { root.go(3); } }
            }
        }
    }

    if root.toast != "": Rectangle {
        x: 16px;
        y: root.height - self.height - 88px - root.safe-area-insets.bottom;
        width: root.width - 32px;
        height: toast-text.preferred-height + 24px;
        border-radius: 12px;
        background: #323232;
        toast-text := Text {
            x: 16px;
            width: parent.width - 32px;
            text: root.toast;
            color: white;
            wrap: word-wrap;
            vertical-alignment: center;
        }
        TouchArea { clicked => { root.dismiss-toast(); } }
    }

    if root.confirm-delete-id != "": Rectangle {
        background: #00000080;
        TouchArea { clicked => { root.confirm-delete-id = ""; } }
        Card {
            x: 24px;
            width: root.width - 48px;
            height: confirm-layout.preferred-height;
            y: (root.height - self.height) / 2;
            background: Palette.background;
            TouchArea {}
            confirm-layout := VerticalLayout {
                padding: 20px;
                spacing: 16px;
                Text { text: "删除配置"; font-size: 18px; font-weight: 700; color: Palette.foreground; }
                Text { text: "确定删除「" + root.confirm-delete-name + "」？"; wrap: word-wrap; color: Palette.foreground; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    IconButton { text: "取消"; tint: Palette.foreground; clicked => { root.confirm-delete-id = ""; } }
                    IconButton {
                        text: "删除";
                        tint: Theme.bad;
                        clicked => {
                            root.delete-profile(root.confirm-delete-id);
                            root.confirm-delete-id = "";
                        }
                    }
                }
            }
        }
    }

    if root.adding: Rectangle {
        background: #00000080;
        TouchArea { clicked => { root.adding = false; } }
        Card {
            x: 24px;
            width: root.width - 48px;
            height: add-layout.preferred-height;
            y: min((root.height - self.height) / 2, root.virtual-keyboard-position.y > 0 ? root.virtual-keyboard-position.y - self.height - 16px : root.height);
            background: Palette.background;
            TouchArea {}
            add-layout := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: "添加订阅"; font-size: 18px; font-weight: 700; color: Palette.foreground; }
                LineEdit { placeholder-text: "名称"; text <=> root.add-name; }
                LineEdit { placeholder-text: "订阅链接 https://…"; text <=> root.add-url; input-type: text; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    IconButton { text: "取消"; tint: Palette.foreground; clicked => { root.adding = false; } }
                    IconButton {
                        text: "保存";
                        clicked => { root.add-profile(root.add-name, root.add-url); }
                    }
                }
            }
        }
    }
}
