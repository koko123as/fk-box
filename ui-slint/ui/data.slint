// Page state prepared in Rust (src/pages/*.rs) from BoxBridge events, one
// global per page, so each page reads only what it shows (BoxController's
// fields, compose/BoxController.kt).

import { Glyph } from "icons.slint";
import { BarAction, Keyword } from "globals.slint";

// Values the whole app reads (BoxController.running, remote, transitioning, …).
export global App {
    in property <bool> running;
    in property <bool> transitioning;
    in property <bool> remote;
    in property <string> remote-name;
    in property <int> profile-count;
}

// ---------------------------------------------------------------------------
// Dashboard (pages/DashboardPage.kt, StatusPanel.kt)
// ---------------------------------------------------------------------------

export struct ModeItem { key: string, mode: string, label: string, glyph: Glyph }

export struct Note { message: string, url: string }

export struct KeyValue { key: string, value: string }

// A dashboard grid row on wider windows: each card and the columns it takes.
export struct DashCell { card: string, span: int }
export struct DashRow { cells: [DashCell] }
// A service status row: the target, its latency or failure, the tone of its
// dot (0 idle, 1 available, 2 restricted, 3 failed) and a check in progress.
export struct ServiceItem { id: string, label: string, status: string, tone: int, loading: bool }

export global Dash {
    // The cards shown, in order ("Status", "Network speed", …).
    in property <[string]> cards;
    // Wider windows: the cards packed into rows of 2, 3 and 4 grid columns
    // (dashboard.rs pack()); the page shows the one its width fits.
    in property <[DashRow]> grid2;
    in property <[DashRow]> grid3;
    in property <[DashRow]> grid4;
    in property <bool> editing;
    // The editor's working list (DashboardEditorState).
    in property <[KeyValue]> edit-shown;
    in property <[KeyValue]> edit-hidden;
    in property <bool> saving;
    in property <bool> apply-required;
    in property <[Note]> deprecated;

    // Status panel
    in property <string> status-label;
    in property <bool> start-enabled;
    in property <bool> start-busy;
    in property <string> egress-ip;
    in property <string> egress-country;
    in property <bool> egress-loading;
    in property <bool> egress-skeleton;
    in property <bool> egress-failed;
    in property <bool> egress-can-retry;
    in property <string> egress-type;
    in property <string> egress-quality;
    in property <int> egress-quality-tone;
    in property <string> organization;
    in property <bool> organization-loading;
    in property <string> runtime: "—";
    in property <[KeyValue]> egress-rows;

    // Network speed
    in property <string> up-figure: "0";
    in property <string> up-unit: "B";
    in property <string> up-total: "0 B";
    in property <string> up-line;
    in property <string> up-area;
    in property <string> down-figure: "0";
    in property <string> down-unit: "B";
    in property <string> down-total: "0 B";
    in property <string> down-line;
    in property <string> down-area;
    // The highest rate in the charted window, as "12.3 KB".
    in property <string> up-peak: "0 B";
    in property <string> down-peak: "0 B";
    // The tiles' chart area in logical px (both tiles are the same size); the
    // paths are drawn in it, so Rust needs it (chart-resized).
    in-out property <length> chart-w;
    in-out property <length> chart-h;
    callback chart-resized();

    // Outbound mode
    in property <[ModeItem]> modes;
    in property <string> mode;

    // Current profile
    in property <bool> has-profile;
    in property <string> profile-name;
    in property <string> profile-core;
    in property <bool> profile-remote;
    in property <bool> profile-updating;
    in property <string> profile-updated;
    in property <string> profile-days;
    in property <int> profile-days-tone;
    in property <string> profile-source;
    in property <bool> profile-usage;
    in property <string> usage-used;
    in property <string> usage-total;
    in property <float> usage-ratio;
    in property <string> usage-percent;
    in property <bool> stats-loading;
    in property <string> stat-groups: "—";
    in property <string> stat-outbounds: "—";
    in property <string> stat-rules: "—";

    // Proxy groups
    in property <int> group-count;
    in property <int> timeout-count;
    in property <[string]> group-letters;
    in property <int> group-rest;

    // Memory
    in property <bool> memory-empty: true;
    in property <bool> memory-remote;
    in property <bool> memory-running;
    in property <string> memory-figure: "—";
    in property <string> memory-unit;
    in property <string> memory-app: "—";
    in property <string> memory-core: "—";
    in property <float> memory-app-weight;
    in property <float> memory-core-weight;
    in property <[KeyValue]> memory-app-rows;
    in property <[KeyValue]> memory-core-rows;
    in property <[string]> memory-core-percents;
    in property <bool> releasing;

    // Intranet IP
    in property <bool> lan-loading: true;
    in property <string> lan-address;
    in property <bool> lan-enabled;
    in property <bool> lan-can-toggle;
    in property <string> lan-subtitle;
    in property <bool> lan-can-copy;
    in property <[string]> lan-addresses;
    in property <string> lan-error;
    in property <[KeyValue]> lan-listeners;
    in property <bool> lan-changing;
    in-out property <string> lan-port: "2080";
    in property <bool> lan-port-invalid;

    // System HTTP proxy
    in property <bool> system-proxy;

    // Service status (pages/services.rs)
    in property <[ServiceItem]> services;
    in property <bool> services-checking;

    // Connection statistics: live connections, recent (closed) requests and
    // DNS lookups.
    in property <string> conn-live: "0";
    in property <string> conn-recent: "0";
    in property <string> conn-dns: "0";
}

// ---------------------------------------------------------------------------
// Proxies (pages/ProxiesPage.kt)
// ---------------------------------------------------------------------------

export struct NodeRow {
    tag: string,
    kind: string,
    delay: string,
    tested: bool,
    delay-ms: int,
    selected: bool,
    testing: bool,
}

export struct GroupRow {
    tag: string,
    kind: string,
    selected: string,
    monogram: string,
    selectable: bool,
    expanded: bool,
    testing: bool,
    // Index of the selected node in items, -1 when filtered out.
    selected-index: int,
    items: [NodeRow],
}

export global Proxies {
    in property <[GroupRow]> groups;
    // "Tabs" | "List" (proxyLayout)
    in property <bool> list;
    in-out property <int> tab;
    // proxyDensity: -1 loose, 0 standard, 1 tight (added to the column count)
    in property <int> density-adjust;
    // proxyCardSize
    in property <bool> compact;
    in property <bool> loose;
    // proxyIconStyle: "Filled" | "Plain" | "Hidden"
    in property <string> icon-style: "Filled";
    // The node shown in the details form.
    in property <[KeyValue]> details;
}

// ---------------------------------------------------------------------------
// Profiles (pages/ProfilesPage.kt, SubscriptionInfoView.kt)
// ---------------------------------------------------------------------------

export struct ProfileRow {
    id: string,
    name: string,
    core: string,
    remote: bool,
    selected: bool,
    updated: string,
    source: string,
    days: string,
    days-tone: int,
    bar-tone: int,
    has-usage: bool,
    used: string,
    total: string,
    ratio: float,
    percent: string,
    updating: bool,
    invalid: bool,
}

export global Profiles {
    in property <[ProfileRow]> rows;
    in property <bool> any-usage;
    in property <[BarAction]> bar-actions;
    // The code editor (ProfileEditor / CodeEditor)
    in property <string> editor-title;
    in property <[BarAction]> editor-actions;
    in property <bool> editor-ready;
    in property <bool> editor-busy;
    in property <bool> editor-search;
    in-out property <string> editor-find;
    in property <string> editor-error;
    in property <string> editor-note;
    in property <string> editor-lines: "1";
    in property <int> editor-select-tick;
    in property <int> editor-select-start;
    in property <int> editor-select-end;
    in property <int> editor-select-line;
    in property <int> editor-text-tick;
    in property <string> config-text;
    in property <bool> config-loading;
    // The QR code page
    in property <string> qr-path;
    in property <float> qr-size: 1;
    in property <string> qr-text;
}

// ---------------------------------------------------------------------------
// Tools and settings (pages/ToolsPage.kt, SettingsPages.kt, AppearancePage.kt, …)
// ---------------------------------------------------------------------------

export struct SettingRow {
    // section | gap | footer | item | switch | check | radio | field | editor
    // | text | error | button | progress | spacer | card | title
    kind: string,
    key: string,
    title: string,
    subtitle: string,
    value: string,
    checked: bool,
    enabled: bool,
    clickable: bool,
    chevron: bool,
    glyph: Glyph,
    has-glyph: bool,
    trailing-glyph: Glyph,
    has-trailing: bool,
    danger: bool,
    mono: bool,
    hint: string,
    number: bool,
    invalid: bool,
    loading: bool,
    progress: float,
    lines: int,
    menu: bool,
    // A password field (LabeledField secret = true).
    secret: bool,
    // An app icon (PackageIcon) in place of the glyph.
    image: image,
    has-image: bool,
    // The package whose icon the row still waits for: asked for (row-image)
    // only once the row scrolls near the viewport.
    image-key: string,
    // Built only near the viewport (rows.slint RowView); every row before it
    // in the list is lazy too. The app lists set it.
    lazy: bool,
    // The segments of a SegmentedButton row (kind "segments"), the selected one in lines.
    options: [string],
    // A record (RecordListItem): the outbound chain under its rule (detail).
    chain: [string],
    detail: string,
    // 0 alone, 1 start, 2 middle, 3 end, 4 start and end
    position: int,
}

// A Rust-built page (src/rows.rs): its bar and rows, one per route, in route order.
export struct PageData {
    id: int,
    generic: bool,
    title: string,
    actions: [BarAction],
    menu-key: string,
    loading: bool,
    searchable: bool,
    rows: [SettingRow],
    empty-title: string,
    empty-message: string,
    empty-glyph: Glyph,
    empty-action: string,
    // Extra content kinds the page shows above or instead of its rows.
    special: string,
    // FloatingFootBar: a status line over the list's foot with a chip or a button.
    foot-text: string,
    foot-glyph: Glyph,
    foot-chip: string,
    foot-button: string,
    // The title menu (titleMenuItems), the keyword strip, a list read bottom up.
    title-menu-key: string,
    keywords: [Keyword],
    reverse: bool,
}

export global Pages {
    in property <[PageData]> data;
    // The home destinations built in Rust (Tools, Requests, Logs).
    in property <PageData> tools;
    in property <PageData> requests;
    in property <PageData> logs;
}

