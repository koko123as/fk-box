// The shared Material Design 3 components (ui/m3-rewrite): text in the M3
// type roles, state layers (hover, focus, pressed) and focus rings, 48 dp
// touch targets, icon buttons, common buttons, switch, radio, checkbox,
// filter chips, segmented buttons, cards (filled, elevated, outlined), list
// items, outlined text fields, the search bar and the small top app bar.
// Colors, corners, type and spacing come from the tokens in theme.slint.

import { Theme, TextRole } from "theme.slint";
import { Icons, Glyph } from "icons.slint";
import { Nav, BarAction, Keyword, NativeIme, Motion } from "globals.slint";
import "fonts/MaterialIcons-Regular.ttf";
import "fonts/MaterialIconsOutlined-Regular.otf";

// A TextInput edited by the platform's own text field: on Android a native
// EditText is laid over `frame` while it has focus, and this one only draws
// what it shows when the editor closes (src/native_ime.rs). Set `ink` (and
// the selection colours) instead of `color`. Read-only inputs stay Slint's.
export component NativeTextInput inherits TextInput {
    in property <color> ink: Theme.s.on-surface;
    in property <length> frame-x: self.absolute-position.x;
    in property <length> frame-y: self.absolute-position.y;
    in property <length> frame-width: self.width;
    in property <length> frame-height: self.height;
    in property <bool> mono;
    // The native editor scrolled its text (only a no-wrap multi-line editor
    // laid over a viewport, the code editor, follows it).
    callback native-scrolled(length);
    property <int> native-id;
    property <bool> native-on: NativeIme.enabled && self.has-focus && self.enabled && !self.read-only;
    property <bool> owned: self.native-id != 0 && NativeIme.active == self.native-id;
    property <length> native-key: self.frame-x + 3 * self.frame-y + 7 * self.frame-width + 11 * self.frame-height;
    // The last editor this field opened, kept after it closes.
    property <int> last-id;
    property <int> native-tick: NativeIme.text-tick;
    property <int> native-accept: NativeIme.accept-tick;
    property <length> native-scroll: self.owned ? NativeIme.scroll-y : 0px;
    color: self.owned ? transparent : self.ink;
    text-cursor-width: self.owned ? 0px : 2px;
    selection-background-color: self.owned ? transparent : Theme.s.primary.with-alpha(0.3);
    selection-foreground-color: self.owned ? transparent : self.ink;
    changed native-on => {
        if (self.native-on) {
            self.native-id = NativeIme.begin({
                text: self.text,
                x: self.frame-x,
                y: self.frame-y,
                width: self.frame-width,
                height: self.frame-height,
                multiline: !self.single-line,
                wrap: self.wrap == TextWrap.word-wrap,
                align: self.horizontal-alignment == TextHorizontalAlignment.right ? 2 : self.horizontal-alignment == TextHorizontalAlignment.center ? 1 : 0,
                valign: self.vertical-alignment == TextVerticalAlignment.top ? 0 : self.vertical-alignment == TextVerticalAlignment.bottom ? 2 : 1,
                mono: self.mono,
                font-size: self.font-size,
                color: self.ink,
                input: self.input-type == InputType.password ? 1 : self.input-type == InputType.number || self.input-type == InputType.decimal ? 2 : 0,
            });
            self.last-id = self.native-id;
        } else if (self.native-id != 0) {
            NativeIme.end(self.native-id);
            self.native-id = 0;
        }
    }
    // The native editor closed (a tap outside it, Back): so does the focus.
    changed owned => {
        if (!self.owned && self.native-id != 0) {
            self.native-id = 0;
            self.clear-focus();
        }
    }
    changed native-key => {
        if (self.owned) {
            NativeIme.frame(self.native-id, self.frame-x, self.frame-y, self.frame-width, self.frame-height);
        }
    }
    changed native-tick => {
        if (self.last-id != 0 && NativeIme.event-id == self.last-id && self.text != NativeIme.text) {
            self.text = NativeIme.text;
            self.edited();
        }
    }
    changed native-accept => {
        if (self.last-id != 0 && NativeIme.event-id == self.last-id) {
            self.accepted();
        }
    }
    // The page changed the text itself (a reset, a format): the editor follows.
    changed text => {
        if (self.owned && self.text != NativeIme.text) {
            NativeIme.set-text(self.native-id, self.text);
        }
    }
    changed native-scroll => {
        if (self.owned) {
            self.native-scrolled(self.native-scroll);
        }
    }
    // Selects in the native editor too (find in the code editor).
    public function select(start: int, end: int) {
        self.set-selection-offsets(start, end);
        if (self.owned) {
            NativeIme.set-selection(self.native-id, start, end);
        }
    }
}

// AppIcon
// Read-only text whose selection is the platform's: a long press opens the
// text in a native selectable view (Nav.act "select-text"), where the system
// handles, copy and share work as in any other app.
export component SelectableText inherits Text {
    callback clicked();
    wrap: word-wrap;
    // The hold opened the viewer: the release is not a tap.
    property <bool> held;
    touch := TouchArea {
        clicked => { if (!root.held) { root.clicked(); } }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.held = false;
                hold.running = true;
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                hold.running = false;
            }
        }
        moved => { if (abs(self.mouse-x - self.pressed-x) > 12px || abs(self.mouse-y - self.pressed-y) > 12px) { hold.running = false; } }
    }
    hold := Timer {
        interval: 450ms;
        running: false;
        triggered => {
            self.running = false;
            root.held = true;
            Nav.act("select-text", root.text);
        }
    }
}

export component Icon inherits Text {
    in property <Glyph> glyph;
    in property <length> size: 24px;
    text: glyph.code;
    font-family: glyph.outlined ? "Material Icons Outlined" : "Material Icons";
    font-size: size;
    width: size;
    height: size;
    horizontal-alignment: center;
    vertical-alignment: center;
    color: Theme.s.on-surface-variant;
    accessible-role: none;
}

// Centres its child vertically inside a row layout (a layout ignores a child's own y).
export component Mid {
    VerticalLayout {
        alignment: center;
        @children
    }
}

// Text in one of the M3 type roles. `emphasized` is the role's emphasized
// variant (medium weight), used sparingly for figures and key values.
export component T inherits Text {
    in property <TextRole> role: TextRole.body-large;
    in property <bool> emphasized;
    font-size: Theme.size(role);
    font-family: Theme.font-family;
    font-weight: emphasized ? max(500, Theme.weight(role)) : Theme.weight(role);
    letter-spacing: Theme.tracking(role);
    color: Theme.s.on-surface;
    overflow: elide;
    vertical-alignment: center;
}

// The M3 state layer: the content color over its container at the hover,
// focus or pressed opacity. Fills its parent and takes its corners.
export component StateLayer inherits Rectangle {
    in property <color> ink: Theme.s.on-surface;
    in property <bool> pressed;
    in property <bool> hover;
    in property <bool> focused;
    in property <bool> enabled: true;
    background: enabled ? Theme.state(ink, pressed, hover, focused) : transparent;
    animate background { duration: Theme.motion-short; easing: Theme.easing-standard; }
}

// The M3 press ripple: a circle of the content color spreads from where the
// press landed over its surface, clipped to the surface's corners, and fades
// once the press ends. Placed like StateLayer (it fills its parent; give it
// the parent's corners). The owner's TouchArea calls `down(x, y)` (in this
// element's coordinates) from its pointer-event on a press, before any
// delayed `pressed`, so a quick tap still ripples, and `up()` on release or
// cancel. Drawn from animation-tick() only while a ripple is alive; nothing
// when motion is off (Theme.motion-on), where the state layer alone shows
// the press.
export component Ripple inherits Rectangle {
    in property <color> ink: Theme.s.on-surface;
    in property <bool> enabled: true;
    // Spread from the centre whatever the press position (icon buttons,
    // navigation destinations).
    in property <bool> centered;
    property <bool> live;
    property <bool> held;
    property <duration> start;
    property <duration> fade-from;
    property <length> cx;
    property <length> cy;
    property <length> reach: sqrt(pow(max(self.cx, self.width - self.cx) / 1px, 2) + pow(max(self.cy, self.height - self.cy) / 1px, 2)) * 1px;
    // The clip takes its corners from bindings declared here: the compiler
    // builds it from this component alone, so radii set only where a Ripple
    // is used would leave it square and the ink would show past round shapes.
    border-top-left-radius: self.border-radius;
    border-top-right-radius: self.border-radius;
    border-bottom-left-radius: self.border-radius;
    border-bottom-right-radius: self.border-radius;
    clip: true;
    accessible-role: none;
    public function down(x: length, y: length) {
        if (!self.enabled || !Theme.motion-on) {
            return;
        }
        self.cx = self.centered ? self.width / 2 : clamp(x, 0px, self.width);
        self.cy = self.centered ? self.height / 2 : clamp(y, 0px, self.height);
        self.start = animation-tick();
        self.held = true;
        self.live = true;
        end.stop();
    }
    public function up() {
        if (!self.live || !self.held) {
            return;
        }
        self.held = false;
        // A ripple shows at least half its spread before it fades.
        self.fade-from = max(animation-tick(), self.start + Theme.motion-ripple * 0.5);
        end.interval = self.fade-from - animation-tick() + Theme.motion-ripple-fade + 16ms;
        if (end.running) { end.restart(); } else { end.start(); }
    }
    end := Timer {
        running: false;
        interval: Theme.motion-ripple-fade;
        triggered => {
            self.stop();
            root.live = false;
        }
    }
    if root.live: Rectangle {
        property <duration> now: animation-tick();
        property <float> grow: Theme.ease-out(Theme.progress(self.now, root.start, Theme.motion-ripple));
        property <float> fade: root.held ? 1 : 1 - Theme.progress(self.now, root.fade-from, Theme.motion-ripple-fade);
        property <length> r: root.reach * (0.25 + 0.75 * self.grow);
        x: root.cx - self.r;
        y: root.cy - self.r;
        width: 2 * self.r;
        height: 2 * self.r;
        border-radius: self.r;
        background: root.ink.with-alpha(Theme.state-pressed * self.fade);
    }
}

// Glass: a translucent tonal surface that blurs what scrolls under it
// (Slint 1.19 `backdrop-blur`, Skia renderer; other renderers draw the tint
// alone). The only component that may blur (tools/verify_newui.py); tokens in
// theme.slint. `level` picks the tonal role of the tint, `soft` the smaller
// blur for small surfaces, `elevation` the shadow level (0–3) for a surface
// that floats, `active: false` turns it back into the opaque tonal surface
// (the top app bar before content is under it). A 1 dp edge separates it from
// the content: a white highlight inside an outline-variant hairline in light
// mode, a faint on-surface edge in dark mode.
export component Glass inherits Rectangle {
    in property <int> level: 2;
    in property <bool> active: true;
    in property <bool> soft;
    in property <bool> edge: true;
    in property <int> elevation: 0;
    // Glass that moves with the home pages (their top app bars) keeps its
    // tint but not its blur while they slide or fade (Motion.pages-moving),
    // so no blurred layer is redrawn under a moving page every frame.
    in property <bool> moves-with-pages;
    background: root.active ? Theme.glass(root.level) : Theme.level(root.level);
    backdrop-blur: root.active && !(root.moves-with-pages && Motion.pages-moving) ? (root.soft ? Theme.glass-blur-soft : Theme.glass-blur) : 0px;
    border-width: root.edge && root.active ? 1px : 0px;
    border-color: Theme.dark ? Theme.glass-edge : Theme.glass-outline;
    drop-shadow-blur: Theme.shadow-blur(root.elevation);
    drop-shadow-offset-y: Theme.shadow-offset(root.elevation);
    drop-shadow-color: Theme.shadow-color(root.elevation);
    // Set here so the corners follow a `border-radius` given where Glass is used.
    border-top-left-radius: root.border-radius;
    border-top-right-radius: root.border-radius;
    border-bottom-left-radius: root.border-radius;
    border-bottom-right-radius: root.border-radius;
    if root.edge && root.active && !Theme.dark: Rectangle {
        x: 1px;
        y: 1px;
        width: root.width - 2px;
        height: root.height - 2px;
        border-radius: max(0px, root.border-radius - 1px);
        border-width: 1px;
        border-color: Theme.glass-edge;
    }
    @children
}

// Content that fades in when it takes another's place (empty, loading and
// loaded states, the splash and the home page): the incoming half of the
// fade-through, fading in while it grows from Theme.motion-enter-scale.
// Slint removes the content an `if` drops at once, so the outgoing half is
// instant there; the home pager (home.slint) keeps its pages and fades both.
export component Appear inherits Rectangle {
    in property <duration> delay: 0ms;
    property <bool> shown;
    init => { self.shown = true; }
    opacity: self.shown ? 1 : 0;
    transform-scale: self.shown ? 1 : Theme.motion-enter-scale;
    animate opacity, transform-scale { duration: Theme.motion-enter; delay: root.delay; easing: Theme.easing-decelerate; }
    @children
}

// The M3 focus indicator: a 3 dp secondary ring 2 dp outside the control,
// shown only while the control has keyboard focus.
export component FocusRing inherits Rectangle {
    in property <bool> shown;
    in property <length> corner;
    if root.shown: Rectangle {
        x: -2px;
        y: -2px;
        width: root.width + 4px;
        height: root.height + 4px;
        border-radius: root.corner + 2px;
        border-width: 3px;
        border-color: Theme.s.secondary;
    }
}

// The M3 circular progress indicator (indeterminate).
export component Spinner inherits Rectangle {
    in property <length> size: 24px;
    in property <color> tint: Theme.s.primary;
    width: size;
    height: size;
    accessible-role: progress-indicator;
    Path {
        width: root.size;
        height: root.size;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: root.tint;
        stroke-width: root.size < 20px ? 2px : root.size < 40px ? 3px : 4px;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M 50 6 A 44 44 0 1 1 6 50";
        transform-origin: { x: root.size / 2, y: root.size / 2 };
        transform-rotation: mod(animation-tick() / Theme.motion-spin-period, 1) * 360deg;
    }
}

// The M3 linear progress indicator (indeterminate when value < 0): a 4 dp
// track in secondary-container with a gap before the active indicator.
export component ProgressBar inherits Rectangle {
    in property <float> value: -1;
    in property <color> tint: Theme.s.primary;
    height: 4px;
    border-radius: 2px;
    background: Theme.s.secondary-container;
    clip: true;
    accessible-role: progress-indicator;
    accessible-value: root.value < 0 ? "" : round(clamp(root.value, 0, 1) * 100) + "%";
    Rectangle {
        x: root.value < 0 ? (mod(animation-tick() / Theme.motion-sweep-period, 1) * 1.4 - 0.4) * root.width : 0;
        width: root.value < 0 ? root.width * 0.4 : root.width * clamp(root.value, 0, 1);
        // A determinate value moves to its new length (usage, quotas).
        animate width { duration: root.value < 0 ? 0ms : Theme.motion-medium; easing: Theme.easing-standard; }
        border-radius: 2px;
        background: root.tint;
    }
}

// M3 standard icon button: a 40 dp container (`size`) with a 24 dp icon and
// at least a 48 dp touch target; keyboard focusable with Enter or Space.
export component IconButton inherits Rectangle {
    in property <Glyph> glyph;
    in property <length> size: 40px;
    in property <length> icon-size: 24px;
    in property <color> tint: Theme.s.on-surface-variant;
    in property <bool> enabled: true;
    in property <string> tooltip;
    callback clicked();
    width: size;
    height: size;
    border-radius: min(self.width, self.height) / 2;
    accessible-role: button;
    accessible-label: tooltip;
    accessible-enabled: enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    StateLayer { border-radius: root.border-radius; ink: root.tint; enabled: root.enabled; pressed: touch.pressed; hover: touch.has-hover; focused: fs.has-focus; }
    rip := Ripple { border-radius: root.border-radius; ink: root.tint; enabled: root.enabled; centered: true; }
    Icon {
        glyph: root.glyph;
        size: root.icon-size;
        color: root.enabled ? root.tint : Theme.s.on-surface.with-alpha(Theme.disabled-content);
        animate color { duration: Theme.motion-short; easing: Theme.easing-standard; }
    }
    FocusRing { shown: fs.has-focus; corner: root.border-radius; }
    fs := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == Key.Space) { root.clicked(); return EventResult.accept; }
            EventResult.reject
        }
    }
    touch := TouchArea {
        width: max(root.width, Theme.min-target);
        height: max(root.height, Theme.min-target);
        enabled: root.enabled;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { rip.down(self.x + self.mouse-x, self.y + self.mouse-y); }
            else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { rip.up(); }
        }
    }
}

// M3 icon button variants: filled (selected, primary), tonal (secondary
// container) and standard (`grouped`, inside a toolbar or header).
export component TonalIconButton inherits Rectangle {
    in property <Glyph> glyph;
    in property <length> size: 40px;
    in property <length> icon-size: 24px;
    in property <bool> enabled: true;
    in property <bool> selected;
    in property <bool> grouped;
    in property <bool> loading;
    in property <string> tooltip;
    // Turns the icon (animated): an expand arrow pointing the other way.
    in property <angle> icon-rotation;
    callback clicked();
    property <color> ink: !root.enabled ? Theme.s.on-surface.with-alpha(Theme.disabled-content)
        : root.selected ? Theme.s.on-primary : root.grouped ? Theme.s.on-surface-variant : Theme.s.on-secondary-container;
    width: size;
    height: size;
    border-radius: size / 2;
    background: selected ? Theme.s.primary : grouped ? transparent
        : (enabled ? Theme.s.secondary-container : Theme.s.on-surface.with-alpha(Theme.disabled-container));
    animate background { duration: Theme.motion-short; easing: Theme.easing-standard; }
    accessible-role: button;
    accessible-label: tooltip;
    accessible-enabled: enabled && !loading;
    accessible-checked: selected;
    accessible-action-default => { if (root.enabled && !root.loading) { root.clicked(); } }
    StateLayer { border-radius: root.border-radius; ink: root.ink; enabled: root.enabled && !root.loading; pressed: touch.pressed; hover: touch.has-hover; focused: fs.has-focus; }
    rip := Ripple { border-radius: root.border-radius; ink: root.ink; enabled: root.enabled && !root.loading; centered: true; }
    if root.loading: Spinner { size: root.icon-size - 4px; tint: root.ink; }
    if !root.loading: Icon {
        glyph: root.glyph;
        size: root.icon-size;
        color: root.ink;
        transform-rotation: root.icon-rotation;
        animate transform-rotation { duration: Theme.motion-medium; easing: Theme.easing-standard; }
    }
    FocusRing { shown: fs.has-focus; corner: root.border-radius; }
    fs := FocusScope {
        enabled: root.enabled && !root.loading;
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == Key.Space) { root.clicked(); return EventResult.accept; }
            EventResult.reject
        }
    }
    touch := TouchArea {
        width: max(root.width, Theme.min-target);
        height: max(root.height, Theme.min-target);
        enabled: root.enabled && !root.loading;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { rip.down(self.x + self.mouse-x, self.y + self.mouse-y); }
            else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { rip.up(); }
        }
    }
}

// M3 common buttons, by emphasis: 1 filled (the one primary action of a
// region), 0 filled tonal, 3 outlined, 2 text, 4 elevated. 40 dp tall,
// full corners, label-large, 24 dp side padding (16 with a leading icon,
// 12 for text buttons); the touch target is at least 48 dp tall.
export component Button inherits Rectangle {
    in property <string> label;
    in property <Glyph> glyph;
    in property <bool> has-glyph;
    // 0 tonal, 1 filled, 2 text, 3 outlined, 4 elevated
    in property <int> kind;
    in property <bool> enabled: true;
    in property <length> button-height: 40px;
    in property <color> text-color: kind == 1 ? Theme.s.on-primary : kind == 0 ? Theme.s.on-secondary-container : Theme.s.primary;
    callback clicked();
    property <color> ink: root.enabled ? root.text-color : Theme.s.on-surface.with-alpha(Theme.disabled-content);
    height: max(button-height, label-text.preferred-height + 8px);
    min-width: max(row.preferred-width, 48px);
    border-radius: self.height / 2;
    border-width: kind == 3 ? 1px : 0;
    border-color: enabled ? Theme.s.outline-variant : Theme.s.on-surface.with-alpha(Theme.disabled-container);
    background: !enabled ? (kind == 2 || kind == 3 ? transparent : Theme.s.on-surface.with-alpha(Theme.disabled-container))
        : kind == 1 ? Theme.s.primary : kind == 0 ? Theme.s.secondary-container : kind == 4 ? Theme.s.surface-container-low : transparent;
    animate background, border-color { duration: Theme.motion-short; easing: Theme.easing-standard; }
    drop-shadow-blur: kind == 4 && enabled ? Theme.shadow-blur(1) : 0px;
    drop-shadow-offset-y: kind == 4 && enabled ? Theme.shadow-offset(1) : 0px;
    drop-shadow-color: kind == 4 && enabled ? Theme.shadow-color(1) : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    StateLayer { border-radius: root.border-radius; ink: root.text-color; enabled: root.enabled; pressed: touch.pressed; hover: touch.has-hover; focused: fs.has-focus; }
    rip := Ripple { border-radius: root.border-radius; ink: root.text-color; enabled: root.enabled; }
    row := HorizontalLayout {
        padding-left: root.kind == 2 ? 12px : root.has-glyph ? 16px : 24px;
        padding-right: root.kind == 2 ? (root.has-glyph ? 16px : 12px) : 24px;
        spacing: 8px;
        alignment: center;
        if root.has-glyph: Mid { Icon {
            glyph: root.glyph;
            size: 18px;
            color: root.ink;
        } }
        label-text := T {
            text: root.label;
            role: TextRole.label-large;
            color: root.ink;
            horizontal-alignment: center;
        }
    }
    FocusRing { shown: fs.has-focus; corner: root.border-radius; }
    fs := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == Key.Space) { root.clicked(); return EventResult.accept; }
            EventResult.reject
        }
    }
    touch := TouchArea {
        height: max(root.height, Theme.min-target);
        enabled: root.enabled;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { rip.down(self.x + self.mouse-x, self.y + self.mouse-y); }
            else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { rip.up(); }
        }
    }
}

// The M3 switch: a 52 × 32 track; unselected an outlined track with a 16 dp
// handle, selected a primary track with a 24 dp handle carrying a check
// (state is not shown by color alone); the handle grows to 28 dp while
// pressed. 48 dp touch target.
export component Switch inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 52px;
    height: 32px;
    border-radius: 16px;
    background: !enabled ? (checked ? Theme.s.on-surface.with-alpha(Theme.disabled-container) : Theme.s.surface-container-highest.with-alpha(Theme.disabled-container))
        : checked ? Theme.s.primary : Theme.s.surface-container-highest;
    animate background { duration: Theme.motion-short; easing: Theme.easing-standard; }
    border-width: checked ? 0 : 2px;
    border-color: enabled ? Theme.s.outline : Theme.s.on-surface.with-alpha(Theme.disabled-container);
    accessible-role: switch;
    accessible-checked: checked;
    accessible-enabled: enabled;
    accessible-action-default => { if (root.enabled) { root.toggled(!root.checked); } }
    handle := Rectangle {
        property <length> d: touch.pressed && root.enabled ? 28px : root.checked ? 24px : 16px;
        width: self.d;
        height: self.d;
        border-radius: self.d / 2;
        x: root.checked ? parent.width - 16px - self.d / 2 : 16px - self.d / 2;
        y: (parent.height - self.height) / 2;
        background: !root.enabled ? (root.checked ? Theme.s.surface : Theme.s.on-surface.with-alpha(Theme.disabled-content))
            : root.checked ? Theme.s.on-primary : Theme.s.outline;
        // The handle slides and grows with the M3 standard curve.
        animate x, y, width, height, border-radius { duration: Theme.motion-medium; easing: Theme.easing-standard; }
        animate background { duration: Theme.motion-short; easing: Theme.easing-standard; }
        // The 40 dp state layer around the handle.
        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 20px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: root.enabled ? Theme.state(root.checked ? Theme.s.primary : Theme.s.on-surface, touch.pressed, touch.has-hover, fs.has-focus) : transparent;
            animate background { duration: Theme.motion-short; easing: Theme.easing-standard; }
        }
        if root.checked: Icon {
            glyph: Icons.check;
            size: 16px;
            color: root.enabled ? Theme.s.primary : Theme.s.on-surface.with-alpha(Theme.disabled-content);
        }
    }
    FocusRing { shown: fs.has-focus; corner: 16px; }
    fs := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == Key.Space) { root.toggled(!root.checked); return EventResult.accept; }
            EventResult.reject
        }
    }
    touch := TouchArea {
        height: Theme.min-target;
        enabled: root.enabled;
        clicked => { root.toggled(!root.checked); }
    }
}

// The M3 radio button: a 20 dp mark in a 40 dp state-layer box (the row
// it sits in takes the tap).
export component Radio inherits Rectangle {
    in property <bool> selected;
    in property <bool> enabled: true;
    width: 40px;
    height: 40px;
    accessible-role: radio-button;
    accessible-checked: selected;
    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        border-width: 2px;
        border-color: !root.enabled ? Theme.s.on-surface.with-alpha(Theme.disabled-content) : root.selected ? Theme.s.primary : Theme.s.on-surface-variant;
        Rectangle {
            width: root.selected ? 10px : 0px;
            height: self.width;
            border-radius: self.width / 2;
            background: !root.selected ? transparent : root.enabled ? Theme.s.primary : Theme.s.on-surface.with-alpha(Theme.disabled-content);
            animate width { duration: Theme.motion-short; easing: Theme.easing-standard; }
        }
    }
}

// The M3 checkbox: an 18 dp box with 2 dp corners in a 40 dp box.
export component CheckBox inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    width: 40px;
    height: 40px;
    accessible-role: checkbox;
    accessible-checked: checked;
    Rectangle {
        width: 18px;
        height: 18px;
        border-radius: 2px;
        border-width: root.checked ? 0 : 2px;
        border-color: root.enabled ? Theme.s.on-surface-variant : Theme.s.on-surface.with-alpha(Theme.disabled-content);
        background: !root.checked ? transparent : root.enabled ? Theme.s.primary : Theme.s.on-surface.with-alpha(Theme.disabled-content);
        animate background { duration: Theme.motion-short; easing: Theme.easing-standard; }
        if root.checked: Icon { glyph: Icons.check; size: 16px; color: root.enabled ? Theme.s.on-primary : Theme.s.surface; }
    }
}

// SelectionBadge: a check (or pin) on a primary circle: the selected state
// of a card, in addition to its container color.
export component SelectionBadge inherits Rectangle {
    in property <length> size: 22px;
    in property <bool> preferred;
    width: size;
    height: size;
    border-radius: size / 2;
    background: Theme.s.primary;
    Icon {
        glyph: root.preferred ? Icons.pin : Icons.check;
        size: root.size - 6px;
        color: Theme.s.on-primary;
    }
}

// IconBadge: an icon on a filled circle (a list item's leading avatar).
export component IconBadge inherits Rectangle {
    in property <Glyph> glyph;
    in property <length> size: 40px;
    in property <color> container: Theme.s.secondary-container;
    in property <color> tint: Theme.s.on-secondary-container;
    width: size;
    height: size;
    border-radius: size / 2;
    background: container;
    Icon {
        glyph: root.glyph;
        size: root.size * 0.5;
        color: root.tint;
    }
}

// A loading placeholder for a line of text.
export component Skeleton inherits Rectangle {
    in property <length> pill-height: 16px;
    height: pill-height;
    border-radius: Theme.corner-extra-small;
    background: Theme.s.surface-container-highest;
}

// A status label (not interactive, so not an M3 chip): 0 neutral, 1 ok,
// 2 warning on their container roles, with an optional leading dot so the
// state does not rest on color alone (the label names it).
export component Chip inherits Rectangle {
    in property <string> label;
    in property <int> tone;
    in property <bool> dot;
    in property <bool> large;
    property <color> fg: tone == 1 ? Theme.s.on-success-container : tone == 2 ? Theme.s.on-warning-container : Theme.s.on-surface-variant;
    height: large ? 32px : 24px;
    border-radius: Theme.corner-small;
    // Neutral labels are outlined, so they read on any surface level.
    background: tone == 1 ? Theme.s.success-container : tone == 2 ? Theme.s.warning-container : transparent;
    border-width: tone == 1 || tone == 2 ? 0px : 1px;
    border-color: Theme.s.outline-variant;
    // Its content's width also outside a layout (a positioned chip would otherwise fill its parent).
    width: lay.preferred-width;
    horizontal-stretch: 0;
    accessible-role: AccessibleRole.text;
    accessible-label: label;
    lay := HorizontalLayout {
        padding-left: root.large ? 12px : 8px;
        padding-right: self.padding-left;
        spacing: 6px;
        alignment: start;
        if root.dot: Rectangle {
            width: 6px;
            height: 6px;
            y: (parent.height - 6px) / 2;
            border-radius: 3px;
            background: root.fg;
        }
        T {
            text: root.label;
            role: root.large ? TextRole.label-large : TextRole.label-medium;
            color: root.fg;
        }
    }
}

// The M3 filter chip (and input chip when `removable`): 32 dp, small
// corners; unselected outlined, selected secondary-container with a check.
export component FilterChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> removable;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px;
    width: lay.preferred-width;
    horizontal-stretch: 0;
    border-radius: Theme.corner-small;
    border-width: selected ? 0 : 1px;
    border-color: Theme.s.outline-variant;
    background: selected ? Theme.s.secondary-container : transparent;
    animate background { duration: Theme.motion-short; easing: Theme.easing-standard; }
    accessible-role: button;
    accessible-label: label;
    accessible-checked: selected;
    accessible-action-default => { root.clicked(); }
    StateLayer { border-radius: root.border-radius; ink: root.selected ? Theme.s.on-secondary-container : Theme.s.on-surface-variant; pressed: touch.pressed; hover: touch.has-hover; focused: fs.has-focus; }
    rip := Ripple { border-radius: root.border-radius; ink: root.selected ? Theme.s.on-secondary-container : Theme.s.on-surface-variant; enabled: root.enabled; }
    lay := HorizontalLayout {
        padding-left: root.selected && !root.removable ? 8px : 16px;
        padding-right: root.removable ? 8px : 16px;
        spacing: 8px;
        if root.selected && !root.removable: Mid { Icon { glyph: Icons.check; size: 18px; color: Theme.s.on-secondary-container; } }
        T { text: root.label; role: TextRole.label-large; color: root.selected ? Theme.s.on-secondary-container : Theme.s.on-surface-variant; }
        if root.removable: Mid { Icon { glyph: Icons.close; size: 18px; color: Theme.s.on-surface-variant; } }
    }
    FocusRing { shown: fs.has-focus; corner: root.border-radius; }
    fs := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == Key.Space) { root.clicked(); return EventResult.accept; }
            EventResult.reject
        }
    }
    touch := TouchArea {
        height: Theme.min-target;
        enabled: root.enabled;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { rip.down(self.x + self.mouse-x, self.y + self.mouse-y); }
            else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { rip.up(); }
        }
    }
}

// The M3 segmented button (single select): 40 dp, outlined, full corners at
// the ends, the selected segment secondary-container with a check.
export component SegmentedButton inherits Rectangle {
    in property <[string]> labels;
    in property <[Glyph]> glyphs;
    in property <int> selected;
    in property <bool> enabled: true;
    callback picked(int);
    height: 40px;
    border-radius: self.height / 2;
    HorizontalLayout {
        for l[i] in root.labels: seg := Rectangle {
            property <bool> on: i == root.selected;
            background: on ? Theme.s.secondary-container : transparent;
            animate background { duration: Theme.motion-short; easing: Theme.easing-standard; }
            // Equal widths; the ends carry the row's rounded corners.
            horizontal-stretch: 1;
            preferred-width: 0px;
            min-width: 48px;
            border-top-left-radius: i == 0 ? root.height / 2 : 0px;
            border-bottom-left-radius: i == 0 ? root.height / 2 : 0px;
            border-top-right-radius: i == root.labels.length - 1 ? root.height / 2 : 0px;
            border-bottom-right-radius: i == root.labels.length - 1 ? root.height / 2 : 0px;
            accessible-role: button;
            accessible-label: l;
            accessible-checked: on;
            accessible-action-default => { if (root.enabled && !seg.on) { root.picked(i); } }
            StateLayer {
                border-top-left-radius: seg.border-top-left-radius;
                border-bottom-left-radius: seg.border-bottom-left-radius;
                border-top-right-radius: seg.border-top-right-radius;
                border-bottom-right-radius: seg.border-bottom-right-radius;
                ink: seg.on ? Theme.s.on-secondary-container : Theme.s.on-surface;
                enabled: root.enabled;
                pressed: sta.pressed;
                hover: sta.has-hover;
            }
            srip := Ripple {
                border-top-left-radius: seg.border-top-left-radius;
                border-bottom-left-radius: seg.border-bottom-left-radius;
                border-top-right-radius: seg.border-top-right-radius;
                border-bottom-right-radius: seg.border-bottom-right-radius;
                ink: seg.on ? Theme.s.on-secondary-container : Theme.s.on-surface;
                enabled: root.enabled;
            }
            if i > 0: Rectangle { x: 0; width: 1px; background: Theme.s.outline; }
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                padding-left: 12px;
                padding-right: 12px;
                if seg.on: Mid { Icon { glyph: Icons.check; size: 18px; color: Theme.s.on-secondary-container; } }
                if !seg.on && i < root.glyphs.length: Mid { Icon { glyph: root.glyphs[i]; size: 18px; color: Theme.s.on-surface; } }
                T {
                    text: l;
                    role: TextRole.label-large;
                    horizontal-stretch: 0;
                    color: !root.enabled ? Theme.s.on-surface.with-alpha(Theme.disabled-content)   : seg.on ? Theme.s.on-secondary-container : Theme.s.on-surface;
                }
            }
            sta := TouchArea {
                height: max(parent.height, Theme.min-target);
                enabled: root.enabled;
                clicked => { if (!seg.on) { root.picked(i); } }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) { srip.down(self.x + self.mouse-x, self.y + self.mouse-y); }
                    else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { srip.up(); }
                }
            }
        }
    }
    Rectangle { border-radius: root.border-radius; border-width: 1px; border-color: Theme.s.outline; }
}

// A full-width M3 divider (1 dp outline-variant).
export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.s.outline-variant;
}

// Card: the M3 card variants — 0 filled (surface-container-highest),
// 1 elevated (surface-container-low with a level 1 shadow), 2 outlined
// (surface with an outline-variant border). Medium corners. A selected
// card fills with secondary-container when `fills` (the card shows a
// SelectionBadge as well); a clickable card has a state layer.
export component Card inherits Rectangle {
    in property <bool> selected;
    in property <bool> fills;
    in property <bool> error;
    in property <int> variant: 0;
    // The tonal level for nested blocks; -1 follows the variant.
    in property <int> level: -1;
    in property <bool> enabled: true;
    in property <bool> long-press-menu;
    in property <bool> interactive: true;
    callback clicked();
    callback long-pressed(length, length);
    border-radius: Theme.radius;
    clip: true;
    background: error ? Theme.s.error-container : (selected && fills) ? Theme.s.secondary-container
        : level >= 0 ? Theme.level(level)
        : variant == 1 ? Theme.s.surface-container-low : variant == 2 ? Theme.s.surface : Theme.s.surface-container-highest;
    animate background { duration: Theme.motion-short; easing: Theme.easing-standard; }
    border-width: variant == 2 && !(selected && fills) && !error ? 1px : 0px;
    border-color: Theme.s.outline-variant;
    drop-shadow-blur: variant == 1 ? Theme.shadow-blur(touch.pressed ? 1 : touch.has-hover ? 2 : 1) : 0px;
    drop-shadow-offset-y: variant == 1 ? Theme.shadow-offset(1) : 0px;
    drop-shadow-color: variant == 1 ? Theme.shadow-color(1) : transparent;
    accessible-role: button;
    accessible-checked: selected;
    accessible-action-default => { if (root.enabled && root.interactive) { root.clicked(); } }
    touch := TouchArea {
        enabled: root.enabled && root.interactive;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                hold.running = root.long-press-menu;
                rip.down(self.mouse-x, self.mouse-y);
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                hold.running = false;
                rip.up();
            }
        }
        moved => { if (abs(self.mouse-x - self.pressed-x) > 12px || abs(self.mouse-y - self.pressed-y) > 12px) { hold.running = false; } }
    }
    hold := Timer {
        interval: 450ms;
        running: false;
        triggered => {
            self.running = false;
            root.long-pressed(root.absolute-position.x + touch.mouse-x, root.absolute-position.y + touch.mouse-y);
        }
    }
    StateLayer {
        border-radius: root.border-radius;
        ink: (root.selected && root.fills) ? Theme.s.on-secondary-container : Theme.s.on-surface;
        enabled: root.enabled && root.interactive;
        pressed: touch.pressed;
        hover: touch.has-hover;
    }
    rip := Ripple {
        border-radius: root.border-radius;
        ink: (root.selected && root.fills) ? Theme.s.on-secondary-container : Theme.s.on-surface;
        enabled: root.enabled && root.interactive;
    }
    @children
}

// A dashboard panel: a filled card (content padded 16 dp) with an optional
// state layer when it opens something.
export component Panel inherits Rectangle {
    in property <bool> clickable;
    in property <length> pad: 16px;
    // Where the content sits when a grid row makes the card taller than it.
    in property <LayoutAlignment> content-alignment: start;
    callback clicked();
    background: Theme.s.surface-container-highest;
    border-radius: Theme.radius;
    clip: true;
    accessible-role: groupbox;
    accessible-action-default => { if (root.clickable) { root.clicked(); } }
    ta := TouchArea {
        enabled: root.clickable;
        // A card that opened a page grows into it (Motion container transform).
        clicked => {
            let before = Nav.routes.length;
            root.clicked();
            if (Nav.routes.length > before) {
                Motion.open-from(Nav.routes.length, root.absolute-position.x, root.absolute-position.y, root.width, root.height, Theme.radius, Theme.s.surface-container-highest);
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { prip.down(self.x + self.mouse-x, self.y + self.mouse-y); }
            else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { prip.up(); }
        }
    }
    StateLayer { enabled: root.clickable; pressed: ta.pressed; hover: ta.has-hover; }
    prip := Ripple { border-radius: root.border-radius; enabled: root.clickable; }
    VerticalLayout {
        padding: root.pad;
        padding-top: max(0px, root.pad - 4px);
        // Taller than its content in a dashboard grid row: the rest stays below.
        alignment: root.content-alignment;
        @children
    }
}

// The card header: a 20 dp icon, the title in title-medium and trailing
// content (icon buttons keep their 48 dp target inside the 48 dp row).
export component PanelTitle inherits HorizontalLayout {
    in property <string> title;
    in property <Glyph> glyph;
    min-height: max(Theme.min-target, Theme.leading(TextRole.title-medium));
    spacing: 8px;
    Mid { Icon {
        glyph: root.glyph;
        size: 20px;
        color: Theme.s.primary;
    } }
    T {
        text: root.title;
        role: TextRole.title-medium;
        horizontal-stretch: 1;
    }
    @children
}

// The M3 list item in a grouped list: rows share one surface-container-low
// container with large corners, an inset outline-variant divider between
// rows (position: 0 alone without a container, 1 first, 2 middle, 3 last,
// 4 first and last). One-line rows are 56 dp, two-line 72 dp: body-large
// headline, body-medium supporting text, a 24 dp leading icon or a 40 dp
// avatar, trailing supporting text in body-medium; a state layer when
// clickable; disabled content at 38 %.
export component ListItem inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <Glyph> leading;
    in property <bool> has-leading;
    // PackageIcon: an app's icon in place of the leading glyph.
    in property <image> leading-image;
    in property <bool> has-leading-image;
    in property <string> trailing-text;
    in property <bool> chevron;
    in property <int> position: 4;
    in property <bool> invalid;
    in property <bool> clickable;
    in property <bool> enabled: true;
    // The tonal level of the group container (1 container-low ... 4 highest).
    in property <int> level: 1;
    in property <int> title-lines: 2;
    // The subtitle's lines at most (0: as many as it wraps to); one line is
    // elided at the end.
    in property <int> subtitle-lines: 0;
    in property <color> title-color: Theme.s.on-surface;
    // ContextMenuRegion: a long press reports where it happened.
    in property <bool> long-press-menu;
    callback clicked();
    callback long-pressed(length, length);
    property <bool> top: position == 1 || position == 4;
    property <bool> bottom: position == 3 || position == 4;
    property <length> corner: Theme.corner-large;
    property <color> disabled-ink: Theme.s.on-surface.with-alpha(Theme.disabled-content);
    min-height: max(root.subtitle != "" ? 72px : 56px, lay.preferred-height);
    border-top-left-radius: top ? corner : Theme.corner-none;
    border-top-right-radius: top ? corner : Theme.corner-none;
    border-bottom-left-radius: bottom ? corner : Theme.corner-none;
    border-bottom-right-radius: bottom ? corner : Theme.corner-none;
    background: position == 0 ? transparent : invalid ? Theme.s.error-container : Theme.level(level);
    clip: true;
    accessible-role: list-item;
    accessible-label: root.title;
    accessible-description: root.subtitle;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.clickable && root.enabled) { root.clicked(); } }
    StateLayer { enabled: root.clickable && root.enabled; pressed: touch.pressed; hover: touch.has-hover; }
    rip := Ripple {
        border-top-left-radius: root.border-top-left-radius;
        border-top-right-radius: root.border-top-right-radius;
        border-bottom-left-radius: root.border-bottom-left-radius;
        border-bottom-right-radius: root.border-bottom-right-radius;
        enabled: root.clickable && root.enabled;
    }
    touch := TouchArea {
        enabled: (root.clickable || root.long-press-menu) && root.enabled;
        clicked => {
            if (root.clickable) {
                let before = Nav.routes.length;
                root.clicked();
                // A row that opened a page (its chevron says it does) grows into it.
                if (root.chevron && Nav.routes.length > before) {
                    Motion.open-from(Nav.routes.length, root.absolute-position.x, root.absolute-position.y, root.width, root.height, Theme.corner-large, Theme.level(root.level));
                }
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                hold.running = root.long-press-menu;
                rip.down(self.mouse-x, self.mouse-y);
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                hold.running = false;
                rip.up();
            }
        }
        moved => { if (abs(self.mouse-x - self.pressed-x) > 12px || abs(self.mouse-y - self.pressed-y) > 12px) { hold.running = false; } }
    }
    hold := Timer {
        interval: 450ms;
        running: false;
        triggered => {
            self.running = false;
            root.long-pressed(root.absolute-position.x + touch.mouse-x, root.absolute-position.y + touch.mouse-y);
        }
    }
    lay := HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 16px;
        if root.has-leading-image: Mid { Image {
            source: root.leading-image;
            width: 48px;
            height: 48px;
            opacity: root.enabled ? 1 : Theme.disabled-content;
        } }
        if root.has-leading && !root.has-leading-image: Mid { Icon {
            glyph: root.leading;
            color: root.enabled ? Theme.s.on-surface-variant : root.disabled-ink;
        } }
        // Custom rows (usage, fields) leave the title empty and take the width themselves.
        // Each text sits in a box as tall as the text wraps at the width the
        // row gives it: a wrapped text's own height in a nested layout was
        // measured for one line, so a long value (a profile's URL) overflowed
        // the row onto its divider.
        if root.title != "" || root.subtitle != "": VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Rectangle {
                min-width: title-text.min-width;
                preferred-width: title-text.preferred-width;
                height: min(title-text.preferred-height, root.title-lines * Theme.leading(TextRole.body-large));
                title-text := T {
                    width: parent.width;
                    height: parent.height;
                    text: root.title;
                    role: TextRole.body-large;
                    color: root.enabled ? root.title-color : root.disabled-ink;
                    wrap: root.title-lines == 1 ? no-wrap : word-wrap;
                }
            }
            if root.subtitle != "": Rectangle {
                min-width: subtitle-text.min-width;
                preferred-width: subtitle-text.preferred-width;
                height: root.subtitle-lines > 0 ? min(subtitle-text.preferred-height, root.subtitle-lines * Theme.leading(TextRole.body-medium)) : subtitle-text.preferred-height;
                subtitle-text := T {
                    width: parent.width;
                    height: parent.height;
                    text: root.subtitle;
                    role: TextRole.body-medium;
                    color: root.enabled ? Theme.s.on-surface-variant : root.disabled-ink;
                    wrap: root.subtitle-lines == 1 ? no-wrap : word-wrap;
                    // With no line limit the box is the text's full height: clip, since elide
                    // on wrapped lines drew them over each other.
                    overflow: root.subtitle-lines == 0 ? clip : elide;
                }
            }
        }
        if root.trailing-text != "": T {
            text: root.trailing-text;
            role: TextRole.body-medium;
            color: root.enabled ? Theme.s.on-surface-variant : root.disabled-ink;
            horizontal-alignment: right;
            min-width: 24px;
        }
        @children
        if root.chevron: Mid { Icon {
            glyph: Icons.chevron-forward;
            color: root.enabled ? Theme.s.on-surface-variant : root.disabled-ink;
        } }
    }
    if root.position != 0 && !root.bottom: Rectangle {
        x: root.has-leading || root.has-leading-image ? (root.has-leading-image ? 80px : 56px) : 16px;
        y: parent.height - 1px;
        width: parent.width - self.x - 16px;
        height: 1px;
        background: root.invalid ? Theme.s.error : Theme.s.outline-variant;
    }
}

// The list subheader: title-small in primary, 24 dp above (8 dp first), 8 dp below.
export component SectionTitle inherits Rectangle {
    in property <string> text;
    in property <bool> first;
    height: text == "" ? (first ? 8px : 24px) : t.preferred-height + (first ? 8px : 24px) + 8px;
    accessible-role: AccessibleRole.text;
    accessible-label: text;
    t := T {
        x: 16px;
        y: parent.height - self.height - 8px;
        width: parent.width - 32px;
        height: self.preferred-height;
        text: root.text;
        role: TextRole.title-small;
        color: Theme.s.primary;
    }
}

// Supporting text under a list (body-small, on-surface-variant).
export component Footer inherits VerticalLayout {
    in property <string> text;
    // In a layout, so the wrapped text gets its height for the real width.
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 8px;
    T {
        text: root.text;
        role: TextRole.body-small;
        color: Theme.s.on-surface-variant;
        vertical-alignment: top;
        wrap: word-wrap;
    }
}

// The 24 dp gap between list groups.
export component SectionGap inherits Rectangle { height: 24px; }

// Empty and error states: what it means, and the next action as a tonal button.
export component EmptyState inherits VerticalLayout {
    in property <string> title;
    in property <string> message;
    in property <Glyph> glyph: Icons.info;
    in property <string> action-label;
    callback action();
    padding-top: 64px;
    padding-bottom: 64px;
    padding-left: 24px;
    padding-right: 24px;
    spacing: 16px;
    alignment: center;
    HorizontalLayout {
        alignment: center;
        Icon {
            glyph: root.glyph;
            size: 48px;
            color: Theme.s.on-surface-variant;
        }
    }
    T {
        text: root.title;
        role: TextRole.title-large;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if root.message != "": T {
        text: root.message;
        role: TextRole.body-medium;
        color: Theme.s.on-surface-variant;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if root.action-label != "": HorizontalLayout {
        alignment: center;
        padding-top: 8px;
        Button {
            label: root.action-label;
            kind: 0;
            clicked => { root.action(); }
        }
    }
}

// The M3 outlined text field over the platform IME: 56 dp, extra-small
// corners, a 1 dp outline (2 dp primary when focused, error when invalid),
// the label resting on the outline in body-small. `outlined: false` is the
// bare field inside a list row or the search bar. `container` is the color
// behind the field, which masks the outline under the label.
export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> hint;
    in property <string> label;
    in property <bool> invalid;
    in property <bool> outlined: true;
    in property <bool> multiline;
    in property <bool> mono;
    in property <bool> enabled: true;
    in property <color> container: Theme.s.surface;
    in property <InputType> input-type: InputType.text;
    in property <TextHorizontalAlignment> align: TextHorizontalAlignment.left;
    callback edited(string);
    callback accepted(string);
    public function focus-input() { input.focus(); }
    // Focus with the cursor at the end (a tap beside the text, on the row).
    public function focus-end() {
        input.focus();
        input.set-selection-offsets(2147483647, 2147483647);
    }
    in property <length> field-min: outlined ? 56px : 24px;
    height: multiline ? field-min : max(field-min, input.preferred-height + (outlined ? 32px : 0px));
    border-radius: outlined ? Theme.corner-extra-small : 0;
    border-width: outlined ? (input.has-focus || invalid ? 2px : 1px) : 0;
    border-color: !enabled ? Theme.s.on-surface.with-alpha(Theme.disabled-container)
        : invalid ? Theme.s.error : input.has-focus ? Theme.s.primary : hover.has-hover ? Theme.s.on-surface : Theme.s.outline;
    accessible-role: text-input;
    accessible-label: root.label != "" ? root.label : root.hint;
    hover := TouchArea {
        enabled: root.enabled;
        clicked => { root.focus-end(); }
    }
    if root.outlined && root.label != "": Rectangle {
        x: 12px;
        y: -lab.preferred-height / 2;
        width: lab.preferred-width + 8px;
        height: lab.preferred-height;
        background: root.container;
        lab := T {
            text: root.label;
            role: TextRole.body-small;
            color: !root.enabled ? Theme.s.on-surface.with-alpha(Theme.disabled-content)
                : root.invalid ? Theme.s.error : input.has-focus ? Theme.s.primary : Theme.s.on-surface-variant;
        }
    }
    flick := Flickable {
        x: root.outlined ? 16px : 0;
        y: root.outlined ? 16px : 0;
        width: parent.width - 2 * self.x;
        height: parent.height - 2 * self.y;
        content-height: max(self.height, input.preferred-height);
        input := NativeTextInput {
            text <=> root.text;
            width: parent.width;
            height: max(flick.height, self.preferred-height);
            // The native editor covers the visible box, not the scrolled text.
            frame-x: flick.absolute-position.x;
            frame-y: flick.absolute-position.y;
            frame-width: flick.width;
            frame-height: flick.height;
            mono: root.mono;
            font-size: Theme.size(TextRole.body-large);
            font-family: root.mono ? Theme.mono : Theme.font-family;
            ink: root.enabled ? Theme.s.on-surface : Theme.s.on-surface.with-alpha(Theme.disabled-content);
            single-line: !root.multiline;
            wrap: root.multiline ? word-wrap : no-wrap;
            vertical-alignment: root.multiline ? top : center;
            horizontal-alignment: root.align;
            input-type: root.input-type;
            enabled: root.enabled;
            edited => { root.edited(self.text); }
            accepted => { root.accepted(self.text); }
        }
    }
    // Hidden while the IME composes into the empty field too: the pre-edit is
    // drawn but not yet in `text`, and the hint showed through it. Only the
    // TextInput's size sees the pre-edit.
    if root.text == "" && input.preferred-width < 1px: T {
        x: flick.x;
        y: flick.y;
        width: flick.width;
        height: root.multiline ? self.preferred-height : flick.height;
        vertical-alignment: root.multiline ? top : center;
        horizontal-alignment: root.align;
        wrap: root.multiline ? word-wrap : no-wrap;
        // Elide on wrapped lines drew them over each other; the box is the hint's full height.
        overflow: root.multiline ? clip : elide;
        text: root.hint;
        role: TextRole.body-large;
        color: Theme.s.on-surface-variant;
    }
}

// The M3 search bar: 56 dp, full corners, surface-container-high, a leading
// search icon and a trailing clear button.
export component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <color> fill: Theme.s.surface-container-high;
    callback edited(string);
    public function focus-input() { f.focus-input(); }
    height: 56px;
    border-radius: self.height / 2;
    background: fill;
    accessible-role: text-input;
    accessible-label: @tr("Search");
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 4px;
        spacing: 16px;
        Mid { Icon { glyph: Icons.search; color: Theme.s.on-surface; } }
        f := Field {
            outlined: false;
            text <=> root.text;
            hint: @tr("Search");
            horizontal-stretch: 1;
            edited(t) => { root.edited(t); }
        }
        if root.text != "": Mid { IconButton {
            glyph: Icons.clear-field;
            tooltip: @tr("Clear");
            clicked => { root.text = ""; root.edited(""); }
        } }
    }
}

// The M3 small top app bar: 64 dp, the navigation icon (back or close), the
// title in title-large (or the title menu, or the search bar), at most three
// action icons and the overflow menu. Rust folds actions into the overflow
// (foldBarActions). Filter chips (keywords) sit under the bar. Pages draw
// their scrolling content under the bar (padded by its height); once it is
// scrolled under (`scrolled`), the bar turns into glass over it.
export component TopBar inherits Glass {
    in property <string> title;
    // 0 none, 1 back, 2 close
    in property <int> leading;
    in property <[BarAction]> actions;
    // The overflow menu's key; empty for none.
    in property <string> menu-key;
    // The title menu's key (titleMenuItems).
    in property <string> title-menu-key;
    in property <bool> searchable;
    in-out property <bool> searching;
    in-out property <string> query;
    in property <bool> loading;
    in property <[Keyword]> keywords;
    in property <color> bar-color: Theme.s.surface;
    // Content is scrolled under the bar: glass tint and blur, a hairline below.
    in property <bool> scrolled;
    callback action(string);
    callback search(string);
    callback keyword(string, bool);
    height: lay.preferred-height;
    level: 2;
    active: root.scrolled;
    edge: false;
    moves-with-pages: true;
    background: root.scrolled ? Theme.glass(2) : root.bar-color;
    Rectangle {
        y: root.height - 1px;
        height: 1px;
        background: root.scrolled ? (Theme.dark ? Theme.glass-edge : Theme.glass-outline) : transparent;
    }
    lay := VerticalLayout {
        HorizontalLayout {
            height: 64px;
            padding-left: root.leading == 0 && !root.searching ? 16px : 4px;
            padding-right: 4px;
            spacing: 0px;
            if root.searching: Mid { IconButton {
                glyph: Icons.back;
                tooltip: @tr("Cancel");
                tint: Theme.s.on-surface;
                width: 48px;
                height: 48px;
                clicked => {
                    root.searching = false;
                    root.query = "";
                    root.search("");
                }
            } }
            if !root.searching && root.leading != 0: Mid { IconButton {
                glyph: root.leading == 2 ? Icons.close : Icons.back;
                tooltip: root.leading == 2 ? @tr("Close") : @tr("Back");
                tint: Theme.s.on-surface;
                width: 48px;
                height: 48px;
                clicked => { Nav.pop(); }
            } }
            if root.searching: Mid { horizontal-stretch: 1; sf := SearchField {
                horizontal-stretch: 1;
                text <=> root.query;
                edited(t) => { root.search(t); }
                init => { self.focus-input(); }
            } }
            if !root.searching: Rectangle {
                horizontal-stretch: 1;
                HorizontalLayout {
                    padding-left: root.leading == 0 ? 0px : 4px;
                    alignment: start;
                    spacing: 4px;
                    title-text := T {
                        text: root.title;
                        role: TextRole.title-large;
                        horizontal-stretch: 0;
                        max-width: root.width - 220px;
                        accessible-role: AccessibleRole.text;
                    }
                    if root.title-menu-key != "": Mid { Icon {
                        glyph: Icons.caret-down;
                        color: Theme.s.on-surface-variant;
                    } }
                }
                if root.title-menu-key != "": TouchArea {
                    clicked => { Nav.open-menu(root.title-menu-key, self.absolute-position.x, self.absolute-position.y + self.height); }
                }
            }
            if !root.searching && root.searchable: Mid { IconButton {
                glyph: Icons.search;
                tooltip: @tr("Search");
                tint: Theme.s.on-surface-variant;
                width: 48px;
                height: 48px;
                clicked => { root.searching = true; }
            } }
            if !root.searching: HorizontalLayout {
                spacing: 0px;
                for a in root.actions: Rectangle {
                    width: 48px;
                    if a.loading: Spinner { size: 24px; }
                    if !a.loading: IconButton {
                        glyph: a.glyph;
                        tooltip: a.tooltip;
                        enabled: a.enabled;
                        tint: a.selected ? Theme.s.primary : Theme.s.on-surface-variant;
                        clicked => { root.action(a.id); }
                    }
                }
            }
            if !root.searching && root.menu-key != "": Mid { IconButton {
                glyph: Icons.more;
                tooltip: @tr("More");
                tint: Theme.s.on-surface-variant;
                width: 48px;
                height: 48px;
                clicked => { Nav.open-menu(root.menu-key, self.absolute-position.x + self.width, self.absolute-position.y + self.height); }
            } }
        }
        if root.loading: ProgressBar { border-radius: 0px; }
        if root.keywords.length > 0: Flickable {
            height: 48px;
            content-width: kw.preferred-width;
            kw := HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 8px;
                spacing: 8px;
                for k in root.keywords: FilterChip {
                    label: k.label;
                    selected: k.selected;
                    removable: k.removable;
                    clicked => { root.keyword(k.key, k.removable); }
                }
            }
        }
    }
}

// A page: the top app bar over a padded, scrolling column.
export component ScrollPage inherits Rectangle {
    in property <string> title;
    in property <int> leading: 1;
    in property <[BarAction]> actions;
    in property <string> menu-key;
    in property <bool> loading;
    in property <length> side: Nav.side(self.width);
    callback action(string);
    background: Theme.s.surface;
    // The column scrolls under the glass top app bar.
    flick := Flickable {
        y: 0;
        height: parent.height;
        content-height: body.preferred-height;
        body := VerticalLayout {
            padding-left: root.side;
            padding-right: root.side;
            padding-top: bar.height + 8px;
            padding-bottom: 24px + Nav.inset-bottom;
            @children
        }
    }
    bar := TopBar {
        y: 0;
        title: root.title;
        leading: root.leading;
        actions: root.actions;
        menu-key: root.menu-key;
        loading: root.loading;
        scrolled: flick.content-y < 0;
        action(id) => { root.action(id); }
    }
}
