// Navigation, menus, dialogs and messages shared by every page
// (compose/ui/Navigator.kt, Popup.kt, Dialog.kt and BoxApp's snackbar).
// Rust (src/app.rs, src/nav.rs) owns the state; pages only call back.

import { Glyph } from "icons.slint";

// PopupMenuItem: a menu row; `section` starts a titled section, `divider` a plain one.
export struct MenuItem {
    label: string,
    glyph: Glyph,
    has-glyph: bool,
    checked: bool,
    enabled: bool,
    danger: bool,
    section: string,
    divider: bool,
    submenu: bool,
}

// IconAction: a bar button.
export struct BarAction {
    id: string,
    glyph: Glyph,
    tooltip: string,
    enabled: bool,
    selected: bool,
    loading: bool,
}

// A route over the home page: a pushed page or a form (NavLevel).
// `pane` is the destination whose content pane a page stays in outside the
// phone layout (NestedNavigatorHost); -1 for the root navigator.
export struct Route {
    id: int,
    kind: string,
    arg: string,
    form: bool,
    pane: int,
    // True for the first page of a form: its bar leads with close (LocalSheetRoot).
    sheet-root: bool,
}

// ScaffoldKeyword: a chip under the bar.
export struct Keyword {
    key: string,
    label: string,
    removable: bool,
    selected: bool,
    section-start: bool,
}

export global Nav {
    // The window, for the view mode (ui/Layout.kt: ≤600 phone, ≤840 laptop).
    in-out property <length> width: 400px;
    in-out property <length> height: 800px;
    out property <bool> mobile: width <= 600px;
    out property <int> view-mode: width <= 600px ? 0 : width <= 840px ? 1 : 2;
    // cardSpacingOf
    out property <length> gap: view-mode == 0 ? 8px : view-mode == 1 ? 12px : 16px;
    // System bar insets: Window.safe-area-insets, unless the host reports its
    // own (host-insets; Android does, since Slint reads screen-level insets
    // that are wrong in floating and split-screen windows). The host's
    // values are physical pixels (host-*-px); the window turns them into
    // lengths with its current scale factor, so a window whose scale factor
    // arrives after the insets (a new surface or activity after the
    // background) still places them right, and a value sent twice replaces
    // the last one.
    in-out property <bool> host-insets;
    in-out property <float> host-top-px;
    in-out property <float> host-bottom-px;
    in-out property <float> host-left-px;
    in-out property <float> host-right-px;
    in-out property <length> inset-top;
    in-out property <length> inset-bottom;
    in-out property <length> inset-left;
    in-out property <length> inset-right;
    in-out property <length> keyboard-height;
    // The floating navigation bar (phones): its height, its margin, and the room
    // the home pages leave under their content so the bar never covers it.
    out property <length> bar-height: 64px;
    out property <length> bar-margin: 12px;
    out property <length> home-bottom: mobile ? inset-bottom + bar-height + 2 * bar-margin : inset-bottom;
    // The navigation rail on wider windows; extended, it shows its labels
    // beside the icons (saved as the railExtended preference).
    in-out property <bool> rail-extended;
    out property <length> rail-width: mobile ? 0px : rail-extended ? 220px : 88px;
    // The side padding that keeps a reading column (lists, settings, forms)
    // at most 760 dp wide in a window of `width`. Only the window's width
    // decides the layout, so every platform shares it.
    public pure function side(width: length) -> length {
        return max(16px, (width - 760px) / 2);
    }

    in property <[Route]> routes;
    // The selected home destination, by label (HomePage `current`).
    in-out property <string> tab: "Dashboard";
    in property <bool> ready;
    in property <string> startup-error;
    // Bumped by Rust after a route or dialog closes: the window takes key focus back for Back.
    in property <int> focus-tick;
    // The destinations the layout shows (HomePage destinationsOf).
    out property <[string]> destinations: mobile ? ["Dashboard", "Proxies", "Profiles", "Tools"] : ["Dashboard", "Proxies", "Profiles", "Requests", "Logs", "Tools"];

    callback select-tab(string);
    callback push(string, string);
    callback form(string, string);
    // maybePop: closes the innermost route, asking its guard.
    callback pop();
    // System back; false lets the activity handle it.
    callback back() -> bool;
    // Closes the form a scrim tap dismisses.
    callback dismiss-form(int);
    // Page actions, dispatched by name in Rust.
    callback act(string, string);
    // Two-argument variant for forms and lists.
    callback act2(string, string, string);
    callback retry-startup();

    // The popup menu (CommonPopupBox / ContextMenuRegion).
    callback open-menu(string, length, length);
    in property <bool> menu-open;
    in property <[MenuItem]> menu-items;
    in property <length> menu-x;
    in property <length> menu-y;
    callback menu-pick(int);
    callback menu-dismiss();

    // The dialog (DialogHost: confirm, choice and input dialogs). The last
    // action is the confirm button; `dialog-danger` paints it in the error colour.
    in property <bool> dialog-open;
    in property <string> dialog-title;
    in property <string> dialog-message;
    in property <bool> dialog-mono;
    in property <[string]> dialog-actions;
    in property <bool> dialog-danger;
    in property <bool> dialog-input;
    in property <bool> dialog-multiline;
    in property <bool> dialog-number;
    in-out property <string> dialog-text;
    in property <string> dialog-hint;
    in property <string> dialog-suffix;
    in property <string> dialog-error;
    // A list of choices (radio rows) above the actions; -1 for none.
    in property <[string]> dialog-options;
    in property <int> dialog-option: -1;
    callback dialog-action(int, string);
    callback dialog-edited(string);
    callback dialog-pick(int);
    callback dialog-dismiss();

    // The snackbar: errors stay longer; a new message replaces the current one.
    in property <string> toast;
    in property <bool> toast-error;
    callback dismiss-toast();
}

// What a native editor needs to stand in for one TextInput (NativeTextInput).
// Lengths are logical; `frame` is where the editor goes, in window
// coordinates. input: 0 text, 1 password, 2 number.
export struct NativeImeSpec {
    text: string,
    x: length,
    y: length,
    width: length,
    height: length,
    multiline: bool,
    wrap: bool,
    // 0 left, 1 center, 2 right
    align: int,
    // 0 top, 1 center, 2 bottom
    valign: int,
    mono: bool,
    font-size: length,
    color: color,
    input: int,
}

// The Android EditText that edits the focused NativeTextInput: the system's
// own cursor, selection, handles and input connection, laid over the field
// (src/native_ime.rs, bridge/NativeEditor.kt). Off Android `enabled` stays
// false and the TextInputs edit themselves.
export global NativeIme {
    in property <bool> enabled;
    // The editing field's id; 0 when the native editor is closed.
    in property <int> active;
    // The native editor's text, and a tick that moves with each change.
    in property <string> text;
    in property <int> text-tick;
    // Moves when the keyboard's action (Done) was pressed.
    in property <int> accept-tick;
    // How far the native editor scrolled its text (the code editor's gutter).
    in property <length> scroll-y;
    callback begin(NativeImeSpec) -> int;
    callback frame(int, length, length, length, length);
    callback set-text(int, string);
    callback set-selection(int, int, int);
    callback end(int);
}
