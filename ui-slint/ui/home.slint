// The home page: Dashboard, Proxies, Profiles and Tools on the floating
// navigation bar in compact windows (< 600 dp); in medium and wider windows the M3
// navigation rail, which adds Requests and Logs (destination order is the
// same in both). On phones the pages slide like a pager (FlClash's PageView:
// a tap slides the new page in, a horizontal drag pulls the neighbour in and
// settles on release), or fade through when the appearance setting asks for
// it (Look.tab-motion "fade"); the rail's pages always fade through (the old
// page fades out, the new one fades in growing slightly). The core pages
// stay instantiated behind the shown one, only the shown and the moving ones
// visible; Requests and Logs exist only while shown. On phones the floating
// bar slides away while the page scrolls down.

import { Theme, TextRole } from "theme.slint";
import { Icons, Glyph } from "icons.slint";
import { Nav, Motion } from "globals.slint";
import { Icon, IconButton, T, StateLayer, Ripple, FocusRing, Surface } from "kit.slint";
import { DashboardPage } from "pages/dashboard.slint";
import { ProxiesPage } from "pages/proxies.slint";
import { ProfilesPage } from "pages/profiles.slint";
import { ToolsPage } from "pages/tools.slint";
import { RequestsPage, LogsPage } from "pages/requests.slint";
import { Look } from "pages/appearance.slint";
import { Dash, Proxies } from "data.slint";

global Destinations {
    public pure function glyph(label: string) -> Glyph {
        if (label == "Dashboard") { return Icons.dashboard; }
        if (label == "Proxies") { return Icons.proxies; }
        if (label == "Profiles") { return Icons.profiles; }
        if (label == "Requests") { return Icons.requests; }
        if (label == "Logs") { return Icons.logs; }
        return Icons.tools;
    }

    public pure function label(label: string) -> string {
        if (label == "Dashboard") { return @tr("Dashboard"); }
        if (label == "Proxies") { return @tr("Proxies"); }
        if (label == "Profiles") { return @tr("Profiles"); }
        if (label == "Requests") { return @tr("Requests"); }
        if (label == "Logs") { return @tr("Logs"); }
        return @tr("Tools");
    }
}

// The M3 navigation bar / rail destination: a 64 × 32 active indicator
// (56 × 32 on the rail) in secondary-container behind a 24 dp icon — filled
// when selected, outlined otherwise, so selection is not shown by color
// alone — and the label in label-medium 4 dp below. The indicator grows from
// its centre when the destination is selected. Unselected items show a
// state layer on the indicator area. Positioned without layouts so an item
// takes its full share of the bar.
component DestinationItem inherits Rectangle {
    in property <string> key;
    in property <bool> selected;
    in property <bool> rail;
    callback clicked();
    accessible-role: tab;
    accessible-label: Destinations.label(key);
    accessible-checked: selected;
    accessible-action-default => { root.clicked(); }
    property <length> pill-width: rail ? 56px : 64px;
    property <length> block: 32px + 4px + label.preferred-height;
    property <Glyph> g: Destinations.glyph(root.key);
    pill := Rectangle {
        width: root.pill-width;
        height: 32px;
        x: (root.width - self.width) / 2;
        y: (root.height - root.block) / 2;
        border-radius: self.height / 2;
        // The active indicator, expanding from the centre.
        Rectangle {
            width: root.selected ? parent.width : 0px;
            x: (parent.width - self.width) / 2;
            border-radius: parent.border-radius;
            background: Theme.s.secondary-container;
            opacity: root.selected ? 1 : 0;
            animate width { duration: Theme.motion-medium; easing: Theme.easing-emphasized; }
            animate opacity { duration: Theme.motion-short; easing: Theme.easing-standard; }
        }
        StateLayer {
            border-radius: parent.border-radius;
            ink: root.selected ? Theme.s.on-secondary-container : Theme.s.on-surface-variant;
            pressed: ta.pressed;
            hover: ta.has-hover;
            focused: fs.has-focus;
        }
        rip := Ripple {
            border-radius: parent.border-radius;
            ink: root.selected ? Theme.s.on-secondary-container : Theme.s.on-surface-variant;
            centered: true;
        }
        // The outlined and the filled icon cross-fade; the filled one grows in.
        Icon {
            glyph: { code: root.g.code, outlined: true };
            color: Theme.s.on-surface-variant;
            opacity: root.selected ? 0 : 1;
            transform-scale: root.selected ? 0.8 : 1;
            animate opacity, transform-scale { duration: Theme.motion-short; easing: Theme.easing-standard; }
        }
        Icon {
            glyph: { code: root.g.code, outlined: false };
            color: Theme.s.on-secondary-container;
            opacity: root.selected ? 1 : 0;
            transform-scale: root.selected ? 1 : 0.8;
            animate opacity { duration: Theme.motion-short; easing: Theme.easing-standard; }
            animate transform-scale { duration: Theme.motion-medium; easing: Theme.easing-back; }
        }
        FocusRing { shown: fs.has-focus; corner: parent.border-radius; }
    }
    label := T {
        x: 2px;
        width: root.width - 4px;
        y: pill.y + 32px + 4px;
        height: self.preferred-height;
        text: Destinations.label(root.key);
        role: TextRole.label-medium;
        emphasized: root.selected;
        color: root.selected ? Theme.s.on-surface : Theme.s.on-surface-variant;
        horizontal-alignment: center;
    }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == Key.Space) { root.clicked(); return EventResult.accept; }
            EventResult.reject
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { rip.down(0px, 0px); }
            else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { rip.up(); }
        }
        changed pressed => { if (!self.pressed) { rip.up(); } }
        changed has-hover => { if (!self.has-hover) { rip.up(); } }
    }
}

// An expanded rail item: a 56 dp full-width indicator with the icon and
// the label in label-large.
component ExtendedItem inherits Rectangle {
    in property <string> key;
    in property <bool> selected;
    callback clicked();
    accessible-role: tab;
    accessible-label: Destinations.label(key);
    accessible-checked: selected;
    accessible-action-default => { root.clicked(); }
    property <Glyph> g: Destinations.glyph(root.key);
    height: 56px;
    border-radius: self.height / 2;
    background: root.selected ? Theme.s.secondary-container : transparent;
    animate background { duration: Theme.motion-short; easing: Theme.easing-standard; }
    StateLayer {
        border-radius: root.border-radius;
        ink: root.selected ? Theme.s.on-secondary-container : Theme.s.on-surface-variant;
        pressed: ta.pressed;
        hover: ta.has-hover;
        focused: fs.has-focus;
    }
    rip := Ripple {
        border-radius: root.border-radius;
        ink: root.selected ? Theme.s.on-secondary-container : Theme.s.on-surface-variant;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 24px;
        spacing: 12px;
        Icon {
            glyph: { code: root.g.code, outlined: !root.selected };
            color: root.selected ? Theme.s.on-secondary-container : Theme.s.on-surface-variant;
            y: (parent.height - self.height) / 2;
        }
        T {
            text: Destinations.label(root.key);
            role: TextRole.label-large;
            color: root.selected ? Theme.s.on-secondary-container : Theme.s.on-surface-variant;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
    FocusRing { shown: fs.has-focus; corner: root.border-radius; }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == Key.Space) { root.clicked(); return EventResult.accept; }
            EventResult.reject
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { rip.down(self.mouse-x, self.mouse-y); }
            else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { rip.up(); }
        }
        changed pressed => { if (!self.pressed) { rip.up(); } }
        changed has-hover => { if (!self.has-hover) { rip.up(); } }
    }
}

// The M3 navigation rail (medium and wider windows): 80 dp on the surface,
// the app mark at the top, the destinations in the same order as the
// phone's bar, and at the foot a button that expands it to 220 dp with
// labels beside the icons. A 1 dp outline-variant edge separates it from
// the pages.
component Rail inherits Rectangle {
    width: Nav.rail-width;
    background: Theme.s.surface;
    animate width { duration: Theme.motion-medium; easing: Theme.easing-emphasized; }
    clip: true;
    accessible-role: tab-list;
    Rectangle { x: parent.width - 1px; width: 1px; background: Theme.s.outline-variant; }
    VerticalLayout {
        padding-top: 12px;
        padding-bottom: 12px + Nav.inset-bottom;
        padding-left: Nav.rail-extended ? 12px : 0px;
        padding-right: Nav.rail-extended ? 12px : 0px;
        spacing: Nav.rail-extended ? 0px : 12px;
        HorizontalLayout {
            height: 56px;
            alignment: Nav.rail-extended ? start : center;
            padding-left: Nav.rail-extended ? 8px : 0px;
            spacing: 12px;
            Image {
                source: @image-url("box_icon.png");
                width: 40px;
                height: 40px;
                y: (parent.height - self.height) / 2;
                accessible-role: none;
            }
            if Nav.rail-extended: T {
                text: "fk-box";
                role: TextRole.title-large;
                vertical-alignment: center;
            }
        }
        Rectangle { height: Nav.rail-extended ? 12px : 4px; }
        for d in Nav.destinations: Rectangle {
            height: Nav.rail-extended ? 56px : 56px;
            if !Nav.rail-extended: DestinationItem {
                key: d;
                rail: true;
                selected: d == Nav.tab;
                clicked => { Nav.select-tab(d); }
            }
            if Nav.rail-extended: ExtendedItem {
                key: d;
                selected: d == Nav.tab;
                clicked => { Nav.select-tab(d); }
            }
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            alignment: Nav.rail-extended ? start : center;
            padding-left: Nav.rail-extended ? 4px : 0px;
            IconButton {
                glyph: Nav.rail-extended ? Icons.back : Icons.chevron-forward;
                tooltip: Nav.rail-extended ? @tr("Hide labels") : @tr("Show labels");
                clicked => { Nav.act("rail-extended", Nav.rail-extended ? "0" : "1"); }
            }
        }
    }
}

// One home destination's page in the pager, placed by Pages: `offset`
// (slide), `fade` and `grow` (fade-through); hidden unless shown or moving.
component HomeSlot inherits Rectangle {
    in property <bool> shown;
    in property <length> offset;
    in property <float> fade: 1;
    in property <float> grow: 1;
    visible: root.shown;
    x: root.offset;
    opacity: root.fade;
    transform-scale: root.grow;
    @children
}

component Pages inherits Rectangle {
    property <string> current: Nav.tab;
    // Slide like a pager on phones (unless the fade setting is on); fade
    // through on the rail.
    property <bool> slide: Nav.mobile && Look.tab-motion != "fade";
    // The transition: the page being left, the direction (+1: the new page
    // comes from the right), where it starts (a drag hands over its
    // progress) and when (animation-tick()).
    property <string> shown;
    property <string> leaving;
    property <float> dir: 1;
    property <float> from: 0;
    property <duration> start;
    property <bool> moving;
    property <duration> span: root.slide ? Theme.motion-tab : Theme.motion-exit + Theme.motion-enter;
    // Read only while a transition runs, so an idle home page draws no frames.
    property <float> t: root.moving ? Theme.progress(animation-tick(), root.start, root.span) : 1;
    property <float> e: root.from + (1 - root.from) * Theme.ease-out(root.t);
    // Fade-through shares (fade mode).
    property <float> exit-share: Theme.motion-exit / max(1ms, root.span);
    property <float> enter: Theme.ease-out((root.t - root.exit-share) / max(0.001, 1 - root.exit-share));
    // A horizontal drag (slide mode): the neighbour it pulls in, from which
    // side, and how far (0–1 of the width). A press only becomes a drag past
    // Theme.touch-slop and mostly horizontal, so a tap's jitter never moves
    // the page; the drag is measured from the slop.
    property <bool> dragging;
    property <string> drag-to;
    property <float> drag-dir: 1;
    property <float> drag-p;
    property <length> rubber;
    // A rubber-band pull past the first or last page springs back from
    // `rubber-from` when released.
    property <length> rubber-from;
    property <bool> springing;
    property <length> spring: root.springing ? root.rubber-from * (1 - Theme.ease-out(Theme.progress(animation-tick(), root.start, Theme.motion-medium))) : 0px;
    // Where the current page sits (0 at rest), for the harness and its tests.
    property <length> current-offset: root.offset-of(root.current);
    changed current-offset => { Motion.home-offset = self.current-offset; }
    // The host reset the gestures (background, foreground, resume).
    property <int> resets: Motion.gesture-resets;
    changed resets => { root.settle(); }

    pure function index(key: string) -> int {
        if (key == "Dashboard") { return 0; }
        if (key == "Proxies") { return 1; }
        if (key == "Profiles") { return 2; }
        if (Nav.mobile) { return key == "Tools" ? 3 : -1; }
        if (key == "Requests") { return 3; }
        if (key == "Logs") { return 4; }
        return 5;
    }
    pure function visible-of(key: string) -> bool {
        return key == root.current || (root.moving && key == root.leaving) || (root.dragging && key == root.drag-to);
    }
    pure function offset-of(key: string) -> length {
        if (!root.slide) { return 0px; }
        if (root.dragging) {
            if (key == root.current) { return root.drag-to == "" ? root.rubber : -root.drag-dir * root.drag-p * root.width; }
            return root.drag-dir * (1 - root.drag-p) * root.width;
        }
        if (root.springing) { return key == root.current ? root.spring : 0px; }
        if (!root.moving) { return 0px; }
        if (key == root.leaving) { return -root.dir * root.e * root.width; }
        return root.dir * (1 - root.e) * root.width;
    }
    pure function fade-of(key: string) -> float {
        if (root.slide || !root.moving) { return 1; }
        if (key == root.leaving) { return 1 - clamp(root.t / max(0.001, root.exit-share), 0, 1); }
        return root.enter;
    }
    pure function grow-of(key: string) -> float {
        if (root.slide || !root.moving || key != root.current) { return 1; }
        return Theme.motion-enter-scale + (1 - Theme.motion-enter-scale) * root.enter;
    }
    // Starts a transition from `leave` to the current page.
    function begin(leave: string, direction: float, progress: float) {
        root.leaving = leave;
        root.shown = root.current;
        root.dir = direction;
        root.from = progress;
        if (leave == "" || leave == root.current) {
            root.moving = false;
            Motion.pages-moving = false;
            return;
        }
        root.start = animation-tick();
        root.moving = true;
        Motion.pages-moving = true;
        done.interval = root.span + 16ms;
        if (done.running) { done.restart(); } else { done.start(); }
    }
    init => { root.shown = root.current; }
    changed current => {
        // A tab picked while a drag is under the finger ends the drag first.
        if (root.dragging) { root.reset-drag(); }
        // A drag that settled on this page already started its transition.
        if (root.current != root.shown) {
            root.begin(root.shown, root.index(root.current) >= root.index(root.shown) ? 1 : -1, 0);
        }
    }
    done := Timer {
        running: false;
        interval: Theme.motion-medium;
        triggered => {
            self.stop();
            root.moving = false;
            root.springing = false;
            Motion.pages-moving = root.dragging;
        }
    }
    // A drag whose release never arrived (no move for Theme.touch-drag-idle)
    // is settled all the same.
    idle := Timer {
        running: false;
        interval: Theme.touch-drag-idle;
        triggered => {
            self.stop();
            root.settle();
        }
    }
    clip: true;
    // A horizontal drag pulls in the neighbouring destination. Off where the
    // page's own horizontal gestures need it: the dashboard editor (cards are
    // dragged) and the proxies' scrolling group tabs.
    SwipeGestureHandler {
        enabled: root.slide && !Motion.vertical-lock && !Dash.editing && !(root.current == "Proxies" && !Proxies.list && Proxies.groups.length > 0);
        handle-swipe-left: true;
        handle-swipe-right: true;
        moved => {
            // Below Slint's own threshold the handler reports moves without
            // ever reporting the release (no swiped or cancelled follows a
            // tap), so only a gesture it took over (`swiping`) may drag.
            if (!self.swiping) { return; }
            let dx = self.current-position.x - self.pressed-position.x;
            if (!root.dragging) {
                // The axis was decided before the handler took the touch
                // (src/gesture.rs: a scroll locks it out, Motion.vertical-lock);
                // what remains is the slop.
                if (abs(dx) <= Theme.touch-slop) { return; }
                root.dragging = true;
                root.moving = false;
                root.springing = false;
                done.stop();
                Motion.swiping = true;
                Motion.pages-moving = true;
            }
            // Measured from the slop, so the page does not jump by it.
            let d = dx < 0 ? min(0px, dx + Theme.touch-slop) : max(0px, dx - Theme.touch-slop);
            let i = root.index(root.current) + (dx < 0 ? 1 : -1);
            root.drag-dir = dx < 0 ? 1 : -1;
            root.drag-to = i >= 0 && i < Nav.destinations.length ? Nav.destinations[i] : "";
            root.drag-p = clamp(abs(d) / max(1px, root.width), 0, 1);
            // Past the first or last page the page follows a third of the drag.
            root.rubber = d / 3;
            idle.interval = Theme.touch-drag-idle;
            if (idle.running) { idle.restart(); } else { idle.start(); }
        }
        changed swiping => { if (!self.swiping) { root.settle(); } }
        swiped => { root.settle(); }
        cancelled => { root.settle(); }
        HomeSlot { shown: root.visible-of("Dashboard"); offset: root.offset-of("Dashboard"); fade: root.fade-of("Dashboard"); grow: root.grow-of("Dashboard"); DashboardPage { } }
        HomeSlot { shown: root.visible-of("Proxies"); offset: root.offset-of("Proxies"); fade: root.fade-of("Proxies"); grow: root.grow-of("Proxies"); ProxiesPage { } }
        HomeSlot { shown: root.visible-of("Profiles"); offset: root.offset-of("Profiles"); fade: root.fade-of("Profiles"); grow: root.grow-of("Profiles"); ProfilesPage { } }
        HomeSlot { shown: root.visible-of("Tools"); offset: root.offset-of("Tools"); fade: root.fade-of("Tools"); grow: root.grow-of("Tools"); ToolsPage { } }
        if root.visible-of("Requests"): HomeSlot { shown: true; offset: root.offset-of("Requests"); fade: root.fade-of("Requests"); grow: root.grow-of("Requests"); RequestsPage { } }
        if root.visible-of("Logs"): HomeSlot { shown: true; offset: root.offset-of("Logs"); fade: root.fade-of("Logs"); grow: root.grow-of("Logs"); LogsPage { } }
    }
    // Drops a drag without moving anywhere: every drag value back to rest.
    function reset-drag() {
        idle.stop();
        root.dragging = false;
        root.drag-to = "";
        root.drag-p = 0;
        root.rubber = 0px;
        Motion.swiping = false;
        Motion.pages-moving = root.moving;
    }
    // The drag ends: past a quarter of the width it carries on to the
    // neighbour, otherwise it slides back; a rubber-band pull springs back.
    // Every branch leaves the drag values at rest.
    function settle() {
        idle.stop();
        if (!root.dragging) {
            Motion.swiping = false;
            Motion.pages-moving = root.moving;
            return;
        }
        let to = root.drag-to;
        let p = root.drag-p;
        let pull = root.rubber;
        let dir = root.drag-dir;
        root.dragging = false;
        root.drag-to = "";
        root.drag-p = 0;
        root.rubber = 0px;
        Motion.swiping = false;
        if (to != "" && p > 0.25) {
            let leave = root.current;
            root.shown = to;
            Nav.select-tab(to);
            root.begin(leave, dir, p);
        } else if (to != "" && p > 0) {
            // Back: the neighbour leaves the way it came.
            root.leaving = to;
            root.dir = -dir;
            root.from = 1 - p;
            root.start = animation-tick();
            root.moving = true;
            Motion.pages-moving = true;
            done.interval = root.span + 16ms;
            if (done.running) { done.restart(); } else { done.start(); }
        } else if (pull != 0px) {
            // Past the first or last page: spring back to 0.
            root.rubber-from = pull;
            root.leaving = "";
            root.start = animation-tick();
            root.springing = true;
            root.moving = true;
            Motion.pages-moving = true;
            done.interval = Theme.motion-medium + 16ms;
            if (done.running) { done.restart(); } else { done.start(); }
        } else {
            root.moving = false;
            Motion.pages-moving = false;
        }
    }
}

export component HomePage inherits Rectangle {
    background: Theme.s.surface;
    // Compact windows: the floating navigation bar, a pill inset from the
    // sides and above the gesture inset; the pages scroll under it (they pad
    // their ends by Nav.home-bottom). It is an opaque surface-container with
    // a level 2 shadow (M3's navigation bar role, lifted off the content),
    // so nothing under it is blurred or read back while the pages scroll.
    if Nav.mobile: Rectangle {
        Pages { }
        bar := Surface {
            level: 2;
            elevation: 2;
            width: min(parent.width - 2 * Nav.bar-side, 480px);
            x: (parent.width - self.width) / 2;
            height: Nav.bar-height;
            // Fixed above the gesture inset; it does not hide while scrolling.
            y: parent.height - self.height - Nav.bar-margin - Nav.inset-bottom;
            border-radius: self.height / 2;
            accessible-role: tab-list;
            // Taps between the items stay on the bar.
            TouchArea { }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 4px;
                for d in Nav.destinations: DestinationItem {
                    key: d;
                    horizontal-stretch: 1;
                    selected: d == Nav.tab;
                    clicked => { Nav.select-tab(d); }
                }
            }
        }
    }
    if !Nav.mobile: HorizontalLayout {
        Rail { }
        Pages { horizontal-stretch: 1; }
    }
}
