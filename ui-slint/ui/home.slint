// The home page (pages/HomePage.kt): Dashboard, Proxies, Profiles and Tools
// on a Material 3 navigation bar on phones; on wider windows a navigation
// rail that adds Requests and Logs. A destination change is instant; the core
// pages stay instantiated behind the shown one, Requests and Logs only while shown.

import { Theme, TextRole } from "theme.slint";
import { Icons, Glyph } from "icons.slint";
import { Nav } from "globals.slint";
import { Icon, IconButton, T } from "kit.slint";
import { DashboardPage } from "pages/dashboard.slint";
import { ProxiesPage } from "pages/proxies.slint";
import { ProfilesPage } from "pages/profiles.slint";
import { ToolsPage } from "pages/tools.slint";
import { RequestsPage, LogsPage } from "pages/requests.slint";

global Destinations {
    public pure function glyph(label: string) -> Glyph {
        if (label == "Dashboard") { return Icons.dashboard; }
        if (label == "Proxies") { return Icons.proxies; }
        if (label == "Profiles") { return Icons.profiles; }
        if (label == "Requests") { return Icons.requests; }
        if (label == "Logs") { return Icons.logs; }
        return Icons.tools;
    }

    public pure function label(label: string) -> string {
        if (label == "Dashboard") { return @tr("Dashboard"); }
        if (label == "Proxies") { return @tr("Proxies"); }
        if (label == "Profiles") { return @tr("Profiles"); }
        if (label == "Requests") { return @tr("Requests"); }
        if (label == "Logs") { return @tr("Logs"); }
        return @tr("Tools");
    }
}

// NavigationBarItem / NavigationRailItem: a 64 × 32 indicator pill (56 × 32 on
// the rail) behind a 24 dp icon, the label 4 dp below; the pair is centred in
// the item. Positioned without layouts so an item takes its full share of the bar.
component DestinationItem inherits Rectangle {
    in property <string> key;
    in property <bool> selected;
    in property <bool> rail;
    callback clicked();
    accessible-role: tab;
    accessible-label: Destinations.label(key);
    property <length> pill-width: rail ? 56px : 64px;
    property <length> block: 32px + 4px + label.preferred-height;
    pill := Rectangle {
        width: root.pill-width;
        height: 32px;
        x: (root.width - self.width) / 2;
        y: (root.height - root.block) / 2;
        border-radius: 16px;
        background: root.selected ? Theme.s.secondary-container : ta.pressed ? Theme.s.on-surface.with-alpha(0.08) : transparent;
        Icon {
            glyph: Destinations.glyph(root.key);
            color: root.selected ? Theme.s.on-secondary-container : Theme.s.on-surface-variant;
        }
    }
    label := T {
        x: 2px;
        width: root.width - 4px;
        y: pill.y + 32px + 4px;
        height: self.preferred-height;
        text: Destinations.label(root.key);
        role: TextRole.caption1;
        emphasized: true;
        color: root.selected ? Theme.s.on-surface : Theme.s.on-surface-variant;
        horizontal-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// An extended rail item: the icon and the label in one 56 dp pill.
component ExtendedItem inherits Rectangle {
    in property <string> key;
    in property <bool> selected;
    callback clicked();
    accessible-role: tab;
    accessible-label: Destinations.label(key);
    height: 52px;
    border-radius: self.height / 2;
    background: root.selected ? Theme.s.secondary-container : ta.pressed ? Theme.s.on-surface.with-alpha(0.08) : transparent;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        Icon {
            glyph: Destinations.glyph(root.key);
            color: root.selected ? Theme.s.on-secondary-container : Theme.s.on-surface-variant;
            y: (parent.height - self.height) / 2;
        }
        T {
            text: Destinations.label(root.key);
            role: TextRole.subheadline;
            emphasized: root.selected;
            color: root.selected ? Theme.s.on-secondary-container : Theme.s.on-surface-variant;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// The navigation rail (FlClash's tablet and desktop layout): the app icon,
// the destinations, and at the foot a button that shows or hides the labels.
// A tinted surface separates it from the pages instead of a divider.
component Rail inherits Rectangle {
    width: Nav.rail-width;
    background: Theme.s.surface-container-low;
    animate width { duration: 180ms; easing: ease-out; }
    clip: true;
    VerticalLayout {
        padding-top: 12px;
        padding-bottom: 12px + Nav.inset-bottom;
        padding-left: Nav.rail-extended ? 12px : 0px;
        padding-right: Nav.rail-extended ? 12px : 0px;
        spacing: 8px;
        HorizontalLayout {
            height: 56px;
            alignment: Nav.rail-extended ? start : center;
            padding-left: Nav.rail-extended ? 8px : 0px;
            spacing: 12px;
            Image {
                source: @image-url("box_icon.png");
                width: 40px;
                height: 40px;
                y: (parent.height - self.height) / 2;
            }
            if Nav.rail-extended: T {
                text: "FK-box";
                role: TextRole.headline;
                emphasized: true;
                vertical-alignment: center;
            }
        }
        Rectangle { height: 8px; }
        for d in Nav.destinations: Rectangle {
            height: Nav.rail-extended ? 52px : 64px;
            if !Nav.rail-extended: DestinationItem {
                key: d;
                rail: true;
                selected: d == Nav.tab;
                clicked => { Nav.select-tab(d); }
            }
            if Nav.rail-extended: ExtendedItem {
                key: d;
                selected: d == Nav.tab;
                clicked => { Nav.select-tab(d); }
            }
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            alignment: Nav.rail-extended ? start : center;
            padding-left: Nav.rail-extended ? 4px : 0px;
            IconButton {
                glyph: Nav.rail-extended ? Icons.back : Icons.chevron-forward;
                tooltip: Nav.rail-extended ? @tr("Hide labels") : @tr("Show labels");
                clicked => { Nav.act("rail-extended", Nav.rail-extended ? "0" : "1"); }
            }
        }
    }
}

component Pages inherits Rectangle {
    property <string> current: Nav.tab;
    clip: true;
    DashboardPage { visible: current == "Dashboard"; }
    ProxiesPage { visible: current == "Proxies"; }
    ProfilesPage { visible: current == "Profiles"; }
    ToolsPage { visible: current == "Tools"; }
    if current == "Requests": RequestsPage { }
    if current == "Logs": LogsPage { }
}

export component HomePage inherits Rectangle {
    background: Theme.s.surface;
    // Phones: the pages run under a floating navigation bar (FlClash's mobile
    // layout), a rounded bar inset from the edges and above the gesture inset.
    if Nav.mobile: Rectangle {
        Pages { }
        bar := Rectangle {
            x: 16px;
            width: parent.width - 32px;
            height: Nav.bar-height;
            y: parent.height - self.height - Nav.inset-bottom - Nav.bar-margin;
            border-radius: self.height / 2;
            background: Theme.s.surface-container-high;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: #00000030;
            // Taps between the items stay on the bar.
            TouchArea { }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                for d in Nav.destinations: DestinationItem {
                    key: d;
                    horizontal-stretch: 1;
                    selected: d == Nav.tab;
                    clicked => { Nav.select-tab(d); }
                }
            }
        }
    }
    if !Nav.mobile: HorizontalLayout {
        Rail { }
        Pages { horizontal-stretch: 1; }
    }
}
