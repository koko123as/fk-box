// The routes over the home page (ui/Navigator.kt NavigatorHost,
// NestedNavigatorHost, PageRoute, FormPage, FormCard). On a phone every route
// fills the window; on wider windows a pushed page stays in the content pane
// of the destination it was pushed from, and a form is a card centred over a
// scrim that dismisses it. Pages pushed inside a form stay in its card.

import { Theme, TextRole } from "theme.slint";
import { Icons } from "icons.slint";
import { Nav, Route } from "globals.slint";
import { T, ScrollPage, EmptyState, RouteSurface } from "kit.slint";
import { MemoryPage, EgressPage, IntranetPage, NewLanProxyPage } from "pages/dashboard.slint";
import { ProxiesPage, NodeDetailsPage } from "pages/proxies.slint";
import { ProfileRoutes } from "pages/profiles.slint";
import { ToolRoutes } from "pages/tools.slint";
import { SettingRoutes } from "pages/settings.slint";
import { RequestRoutes } from "pages/requests.slint";
import { RowsPage } from "pages/rows.slint";
import { AppearanceRoutes } from "pages/appearance.slint";
import { Pages } from "data.slint";

// One route's page, by kind.
component RoutePage inherits Rectangle {
    in property <Route> route;
    in property <int> index;
    property <int> leading: route.sheet-root ? 2 : 1;
    property <string> k: route.kind;
    // A route opened from Slint by kind that a page adopted as Rust-built rows.
    property <bool> generic: k == "rows" || Pages.data[root.index].generic;
    property <bool> known: generic || k == "memory" || k == "egress" || k == "intranet" || k == "lan-add" || k == "proxies" || k == "node-details"
        || appearance.handles || profiles.handles || tools.handles || settings.handles || requests.handles;
    background: Theme.s.surface;
    TouchArea { }
    if generic: RowsPage { d: Pages.data[root.index]; leading: root.leading; }
    if k == "memory": MemoryPage { leading: root.leading; }
    if k == "egress": EgressPage { leading: root.leading; }
    if k == "intranet": IntranetPage { leading: root.leading; }
    if k == "lan-add": NewLanProxyPage { leading: root.leading; }
    if k == "proxies": ProxiesPage { form: true; }
    if k == "node-details": NodeDetailsPage { leading: root.leading; }
    appearance := AppearanceRoutes { kind: root.k; leading: root.leading; }
    profiles := ProfileRoutes { kind: root.k; arg: root.route.arg; leading: root.leading; }
    tools := ToolRoutes { kind: root.k; arg: root.route.arg; leading: root.leading; }
    settings := SettingRoutes { kind: root.k; arg: root.route.arg; leading: root.leading; }
    requests := RequestRoutes { kind: root.k; arg: root.route.arg; leading: root.leading; }
    if !root.known: ScrollPage {
        title: root.k;
        leading: root.leading;
        EmptyState { glyph: Icons.info; title: @tr("Unavailable"); }
    }
}

export component RouteHost inherits Rectangle {
    property <length> pane-x: Nav.mobile ? 0px : 81px;
    for r[i] in Nav.routes: Rectangle {
        property <bool> card: r.form && !Nav.mobile;
        // A page of another destination stays hidden in its pane.
        property <bool> shown: r.form || Nav.mobile || r.pane < 0 || Nav.destinations[r.pane] == Nav.tab;
        if card && r.sheet-root: Rectangle {
            background: Theme.s.scrim.with-alpha(0.32);
            TouchArea { clicked => { Nav.dismiss-form(r.id); } }
        }
        RoutePage {
            visible: shown;
            route: r;
            index: i;
            width: card ? min(580px, root.width * 0.9) : r.form || r.pane < 0 ? root.width : root.width - root.pane-x;
            height: card ? min(720px, (root.height - Nav.keyboard-height) * 0.85) : root.height;
            x: card ? (root.width - self.width) / 2 : r.form || r.pane < 0 ? 0px : root.pane-x;
            y: card ? (root.height - Nav.keyboard-height - self.height) / 2 : 0px;
            border-radius: card ? Theme.radius : 0px;
            clip: card;
        }
    }
}
