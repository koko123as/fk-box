// Proxies: the groups as M3 scrollable tabs over a grid of outlined node
// cards, or the groups as folding sections; a node card selects on tap
// (secondary-container fill and a check badge) and opens a menu on long
// press. Sorting, filtering and folding state live in Rust.

import { Theme, TextRole } from "../theme.slint";
import { Icons, Glyph } from "../icons.slint";
import { Nav, BarAction, Motion } from "../globals.slint";
import { App, Proxies, GroupRow, NodeRow } from "../data.slint";
import { Mid, Icon, T, Spinner, IconButton, TonalIconButton, SelectionBadge, Card, EmptyState, TopBar, ScrollPage, ListItem, StateLayer, Tap, ListMotion, Entrance, Appear } from "../kit.slint";

// ProxyCardMetrics
global Metrics {
    out property <length> name-height: Theme.leading(TextRole.body-medium) * (Proxies.compact ? 1 : 2);
    out property <length> detail-height: Theme.leading(TextRole.body-small);
    out property <length> delay-height: Theme.leading(TextRole.label-small);
    out property <length> extent: 28px + name-height + detail-height + (Proxies.loose ? delay-height + 6px : 0px);
    out property <length> row-extent: extent + 8px;

    // proxyColumns
    public pure function columns(width: length) -> int {
        return clamp(clamp(ceil(width / 250px), 2, 8) + Proxies.density-adjust, 1, 8);
    }
}

// ProxyNodeCard
export component NodeCard inherits Card {
    in property <GroupRow> group;
    in property <NodeRow> node;
    // Unfolding (a group opening in the list view): the cards fade in and
    // grow into place one after another, `order` steps of Theme.motion-stagger
    // apart (only the first Theme.motion-stagger-items are staggered).
    in property <bool> revealed: true;
    in property <int> order;
    opacity: root.revealed ? 1 : 0;
    transform-scale: root.revealed ? 1 : Theme.motion-enter-scale;
    animate opacity, transform-scale {
        duration: Theme.motion-short;
        delay: root.revealed ? min(root.order, Theme.motion-stagger-items) * Theme.motion-stagger : 0ms;
        easing: Theme.easing-decelerate;
    }
    // A new latency counts to its value.
    property <float> delay-shown: root.node.delay-ms;
    animate delay-shown { duration: Theme.motion-medium; easing: Theme.easing-decelerate; }
    property <color> delay-color: !node.tested ? Theme.s.on-surface-variant : node.delay-ms <= 0 ? Theme.s.error : node.delay-ms < 300 ? Theme.s.success : Theme.s.warning;
    // Outlined; the selected node fills with secondary-container and shows
    // the check badge.
    variant: 2;
    selected: node.selected;
    fills: true;
    long-press-menu: true;
    enabled: true;
    clicked => {
        if (group.selectable && App.running) {
            Nav.act2("select-node", group.tag, node.tag);
        }
    }
    long-pressed(x, y) => { Nav.open-menu("node:" + group.tag + "\n" + node.tag, x, y); }
    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        HorizontalLayout {
            T {
                text: root.node.tag;
                role: TextRole.title-small;
                color: root.node.selected ? Theme.s.on-secondary-container : Theme.s.on-surface;
                wrap: Proxies.compact ? no-wrap : word-wrap;
                height: Metrics.name-height;
                vertical-alignment: top;
                horizontal-stretch: 1;
            }
            if root.node.selected: Rectangle {
                width: 26px;
                SelectionBadge { x: 4px; y: 0; }
            }
        }
        Rectangle { height: 8px; }
        if Proxies.loose: T {
            text: root.node.kind;
            role: TextRole.body-small;
            color: root.node.selected ? Theme.s.on-secondary-container : Theme.s.on-surface-variant;
            height: Metrics.detail-height;
        }
        if Proxies.loose: Rectangle { height: 6px; }
        HorizontalLayout {
            height: Proxies.loose ? Metrics.delay-height : Metrics.detail-height;
            spacing: 4px;
            if !Proxies.loose: T {
                text: root.node.kind;
                role: TextRole.body-small;
                color: root.node.selected ? Theme.s.on-secondary-container : Theme.s.on-surface-variant;
                horizontal-stretch: 1;
            }
            Rectangle {
                horizontal-stretch: Proxies.loose ? 1 : 0;
                width: Proxies.loose ? self.preferred-width : max(Metrics.delay-height, delay-label.preferred-width);
                if root.node.testing: Spinner {
                    size: Metrics.delay-height;
                    x: Proxies.loose ? 0 : parent.width - self.width;
                }
                if !root.node.testing && !root.node.tested: Icon {
                    glyph: Icons.bolt;
                    size: Metrics.delay-height;
                    color: Theme.s.on-surface-variant;
                    x: Proxies.loose ? 0 : parent.width - self.width;
                }
                delay-label := T {
                    visible: !root.node.testing && root.node.tested;
                    text: root.node.delay-ms > 0 && root.node.delay == root.node.delay-ms + " ms" ? round(root.delay-shown) + " ms" : root.node.delay;
                    role: TextRole.label-small;
                    emphasized: true;
                    color: root.delay-color;
                    horizontal-alignment: Proxies.loose ? left : right;
                    width: parent.width;
                }
                Tap {
                    border-radius: Theme.corner-extra-small;
                    enabled: App.running && !root.node.testing;
                    clicked => { Nav.act("test-node", root.node.tag); }
                }
            }
        }
    }
}

// The node grid of one group (ProxyGrid / ProxyRow): absolute positions in
// `columns` columns, 8 px apart.
component NodeGrid inherits Rectangle {
    in property <GroupRow> group;
    in property <int> columns: 2;
    in property <length> inset: 0px;
    in property <bool> revealed: true;
    property <length> cell-width: (self.width - 2 * inset - (columns - 1) * 8px) / columns;
    property <int> rows: ceil(group.items.length / columns);
    height: rows * Metrics.row-extent;
    for n[i] in root.group.items: NodeCard {
        x: root.inset + mod(i, root.columns) * (root.cell-width + 8px);
        y: floor(i / root.columns) * Metrics.row-extent;
        width: root.cell-width;
        height: Metrics.extent;
        group: root.group;
        node: n;
        revealed: root.revealed;
        order: i;
    }
}

// The groups of the current destination as M3 scrollable primary tabs:
// 48 dp, labels in title-small (primary when active, on-surface-variant
// otherwise), a 3 dp primary indicator under the active label and a
// divider under the row; a trailing button lists every group.
component GroupTabs inherits Rectangle {
    in property <[GroupRow]> groups;
    in-out property <int> selected;
    height: 48px;
    accessible-role: tab-list;
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.s.outline-variant; }
    flick := Flickable {
        width: parent.width - (more.visible ? 64px : 0px);
        x: 0;
        content-width: strip.preferred-width;
        strip := HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            spacing: 0px;
            for g[i] in root.groups: tb := Rectangle {
                property <bool> on: i == root.selected;
                height: 48px;
                width: max(90px, tab-label.preferred-width + 32px);
                accessible-role: tab;
                accessible-label: g.tag;
                accessible-checked: on;
                accessible-action-default => { root.selected = i; }
                Tap { ink: tb.on ? Theme.s.primary : Theme.s.on-surface; clicked => { root.selected = i; } }
                tab-label := T {
                    text: g.tag;
                    role: TextRole.title-small;
                    color: tb.on ? Theme.s.primary : Theme.s.on-surface-variant;
                    horizontal-alignment: center;
                }
                if tb.on: Rectangle {
                    y: parent.height - 3px;
                    height: 3px;
                    width: max(24px, tab-label.preferred-width);
                    border-top-left-radius: 3px;
                    border-top-right-radius: 3px;
                    background: Theme.s.primary;
                }
            }
        }
    }
    more := IconButton {
        visible: strip.preferred-width > root.width;
        x: parent.width - 8px - self.width;
        glyph: Icons.chevron-down;
        tooltip: @tr("Proxy groups");
        clicked => { Nav.open-menu("proxy-tabs", self.absolute-position.x, self.absolute-position.y + self.height); }
    }
}

// GroupMonogram inside its tile (GroupIcon)
component GroupIcon inherits Rectangle {
    in property <string> mark;
    width: Proxies.icon-style == "Hidden" ? 4px : self.height + (Proxies.icon-style == "Filled" ? 12px : 12px);
    if Proxies.icon-style == "Filled": Rectangle {
        x: 0;
        width: root.height;
        height: root.height;
        border-radius: Theme.corner-medium;
        background: Theme.s.secondary-container;
        T { text: root.mark; font-size: (root.height - 12px) * 0.62; font-weight: 500; color: Theme.s.on-secondary-container; horizontal-alignment: center; }
    }
    if Proxies.icon-style == "Plain": T {
        x: 2px;
        width: root.height;
        text: root.mark;
        font-size: root.height * 0.62;
        font-weight: 500;
        color: Theme.s.primary;
        horizontal-alignment: center;
    }
}

// ProxyGroupHeader
component GroupHeader inherits Rectangle {
    in property <GroupRow> group;
    // The node grid under it is (partly) open: the header joins it.
    in property <bool> joined: group.expanded;
    property <bool> expanded: group.expanded;
    height: 20px + Theme.leading(TextRole.body-large) + 2px + Theme.leading(TextRole.body-small) + 2px;
    border-top-left-radius: Theme.corner-large;
    border-top-right-radius: Theme.corner-large;
    border-bottom-left-radius: joined ? 0 : Theme.corner-large;
    border-bottom-right-radius: joined ? 0 : Theme.corner-large;
    background: Theme.level(1);
    Card {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        background: transparent;
        clicked => { Nav.act("toggle-group", root.group.tag); }
        HorizontalLayout {
            padding: 6px;
            spacing: 0px;
            GroupIcon { mark: root.group.monogram; }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                T { text: root.group.tag; role: TextRole.title-medium; }
                T { text: root.group.selected; role: TextRole.label-medium; color: Theme.s.on-surface-variant; }
            }
            if root.expanded: HorizontalLayout {
                spacing: 0px;
                Mid { TonalIconButton {
                    glyph: Icons.bolt;
                    tooltip: @tr("Test latency");
                    grouped: true;
                    size: 36px;
                    icon-size: 20px;
                    loading: root.group.testing;
                    enabled: App.running;
                    
                    clicked => { Nav.act("test-group", root.group.tag); }
                } }
            }
            if !root.expanded: T {
                text: root.group.kind;
                role: TextRole.label-medium;
                color: Theme.s.on-surface-variant;
                horizontal-stretch: 0;
            }
            Rectangle { width: 6px; }
            Mid { TonalIconButton {
                // One arrow that turns over as the group folds and unfolds.
                glyph: Icons.caret-down;
                icon-rotation: root.expanded ? 180deg : 0deg;
                tooltip: root.expanded ? @tr("Show less") : @tr("Show more");
                size: 36px;
                icon-size: 20px;
                
                clicked => { Nav.act("toggle-group", root.group.tag); }
            } }
        }
    }
}

export component ProxiesPage inherits Rectangle {
    in property <bool> form;
    property <GroupRow> current: Proxies.groups.length > 0 ? Proxies.groups[min(Proxies.tab, Proxies.groups.length - 1)] : { };
    property <int> columns: Metrics.columns(self.width - 32px - (Proxies.list ? 20px : 0px));
    property <length> scroll-target;
    property <int> scroll-tick;
    background: Theme.s.surface;
    property <bool> scrolled;
    // The groups of the list view come and go with the configuration.
    groups-motion := ListMotion { count: Proxies.groups.length; }
    if Proxies.groups.length == 0: Appear { y: bar.height; height: parent.height - bar.height; EmptyState {
        glyph: Icons.proxies;
        title: App.running ? @tr("No proxy groups in this configuration") : @tr("Start the service to view proxy groups");
    } }
    if Proxies.groups.length > 0 && !Proxies.list: Appear { y: bar.height; height: parent.height - bar.height; VerticalLayout {
        padding-top: 8px;
        spacing: 0px;
        Rectangle {
            height: 56px;
            GroupTabs {
                width: parent.width;
                y: 0;
                groups: Proxies.groups;
                selected <=> Proxies.tab;
            }
        }
        if !root.current.selectable: T {
            text: @tr("Automatic selection");
            role: TextRole.body-small;
            color: Theme.s.on-surface-variant;
            horizontal-alignment: center;
            height: self.preferred-height + 8px;
        }
        if root.current.items.length == 0: EmptyState { glyph: Icons.proxies; title: @tr("No results"); }
        grid-flick := Flickable {
            property <int> tick: root.scroll-tick;
            changed tick => { self.content-y = max(root.scroll-target, self.height - self.content-height); }
            vertical-stretch: 1;
            content-height: grid.height + 16px + (root.form ? Nav.inset-bottom : Nav.home-bottom);
            grid := NodeGrid {
                y: 0;
                width: parent.width;
                inset: 16px;
                columns: root.columns;
                group: root.current;
            }
        }
    } }
    // The list view scrolls under the top app bar.
    if Proxies.groups.length > 0 && Proxies.list: Appear { Flickable {
        y: 0;
        height: parent.height;
        content-height: list.preferred-height;
        changed content-y => {
            root.scrolled = self.content-y < 0;
        }
        list := VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: bar.height + 8px;
            padding-bottom: 16px + (root.form ? Nav.inset-bottom : Nav.home-bottom);
            spacing: 0px;
            // A group added to the list grows into its place as it fades in; a
            // slot that now shows another group (the model updates rows in
            // place) fades back in with a short rise; a group moved up by a
            // removal above it slides up from where it was.
            for g[gi] in Proxies.groups: gslot := Rectangle {
                property <string> tag: g.tag;
                property <int> index: gi;
                property <int> seen-index;
                property <length> slide-from;
                grow := Entrance { enter: groups-motion.adding; }
                swap := Entrance { }
                slide := Entrance { }
                init => { self.seen-index = self.index; }
                changed tag => { if (groups-motion.on) { swap.play(); } }
                changed index => {
                    if (groups-motion.removing && self.index < self.seen-index) {
                        self.slide-from = (self.seen-index - self.index) * self.height;
                        slide.play();
                    }
                    self.seen-index = self.index;
                }
                height: group-lay.preferred-height * grow.t;
                clip: grow.t < 1;
                opacity: min(grow.t, swap.t);
                group-lay := VerticalLayout {
                    y: Theme.motion-list-rise * (1 - swap.t) + gslot.slide-from * (1 - slide.t);
                    height: self.preferred-height;
                    spacing: 0px;
                    GroupHeader { group: g; joined: fold.open || fold.height > 0.5px; }
                    // The nodes unfold: the box grows to the grid's height (it
                    // clips the grid meanwhile) while the cards fade in one after
                    // another; folding shrinks it and the grid goes once it is shut.
                    fold := Rectangle {
                        property <bool> open: g.expanded && g.items.length > 0;
                        property <bool> reveal;
                        background: Theme.level(1);
                        border-bottom-left-radius: Theme.corner-large;
                        border-bottom-right-radius: Theme.corner-large;
                        clip: true;
                        height: self.open ? ceil(g.items.length / root.columns) * Metrics.row-extent + 2px : 0px;
                        animate height { duration: Theme.motion-medium; easing: Theme.easing-emphasized; }
                        init => { self.reveal = self.open; }
                        changed open => {
                            self.reveal = false;
                            if (self.open) { if (reveal-next.running) { reveal-next.restart(); } else { reveal-next.start(); } }
                        }
                        reveal-next := Timer {
                            running: false;
                            interval: 1ms;
                            triggered => {
                                self.stop();
                                fold.reveal = true;
                            }
                        }
                        if fold.open || fold.height > 0.5px: NodeGrid {
                            y: 0;
                            width: parent.width;
                            inset: 10px;
                            columns: root.columns;
                            group: g;
                            revealed: fold.reveal;
                        }
                    }
                    Rectangle { height: Nav.gap; }
                }
            }
        }
    } }
    bar := TopBar {
        y: 0;
        title: @tr("Proxies");
        leading: root.form ? 2 : 0;
        searchable: true;
        menu-key: "proxies";
        actions: Proxies.list ? [] : [
            { id: "proxies-test", glyph: Icons.bolt, tooltip: @tr("Test latency"), enabled: App.running && Proxies.groups.length > 0, loading: root.current.testing },
            { id: "proxies-locate", glyph: Icons.locate, tooltip: @tr("Scroll to selected"), enabled: Proxies.groups.length > 0 },
        ];
        action(id) => {
            if (id == "proxies-locate") {
                if (root.current.selected-index >= 0) {
                    root.scroll-target = -floor(root.current.selected-index / root.columns) * Metrics.row-extent;
                    root.scroll-tick += 1;
                }
            } else {
                Nav.act(id, root.current.tag);
            }
        }
        scrolled: root.scrolled && Proxies.groups.length > 0 && Proxies.list;
        search(q) => { Nav.act("proxies-search", q); }
    }
}

// The node details form.
export component NodeDetailsPage inherits ScrollPage {
    title: @tr("Details");
    leading: 2;
    Rectangle { height: 8px; }
    VerticalLayout {
        for r[i] in Proxies.details: ListItem {
            position: Proxies.details.length == 1 ? 4 : i == 0 ? 1 : i == Proxies.details.length - 1 ? 3 : 2;
            title: r.key;
            subtitle: r.value;
        }
    }
}
