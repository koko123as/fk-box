// Requests and Logs as home destinations (sidebar layouts): Rust-built rows
// (src/pages/requests.rs); as routes they are adopted rows pages too.
import { Pages } from "../data.slint";
import { RowsPage } from "rows.slint";

export component RequestsPage inherits Rectangle {
    RowsPage { d: Pages.requests; leading: 0; }
}

export component LogsPage inherits Rectangle {
    RowsPage { d: Pages.logs; leading: 0; }
}

export component RequestRoutes inherits Rectangle {
    in property <string> kind;
    in property <string> arg;
    in property <int> leading;
    out property <bool> handles: false;
}
