// Profiles: the grid of outlined profile cards (single selection: the
// selected card fills with secondary-container and shows a check), the code
// editor and the QR code page. The add, form, details, order and
// configuration pages are Rust-built rows (src/pages/profiles.rs).

import { Theme, TextRole } from "../theme.slint";
import { Icons, Glyph } from "../icons.slint";
import { Nav, BarAction, Motion } from "../globals.slint";
import { App, Profiles, ProfileRow } from "../data.slint";
import { Mid, Icon, T, Spinner, ProgressBar, IconButton, TonalIconButton, Button, SelectionBadge, Card, EmptyState, TopBar, ScrollPage, SearchField, NativeTextInput, SelectableText, ListMotion, Entrance, Appear } from "../kit.slint";

// A small status label (expiry, core): 0 neutral on secondary-container,
// 1 warning, 2 error on their container roles; the text names the state.
component TonePill inherits Rectangle {
    in property <string> label;
    in property <int> tone;
    // On a selected (secondary-container) card the neutral label is outlined.
    in property <bool> on-fill;
    height: t.preferred-height + 4px;
    width: t.preferred-width + 16px;
    border-radius: Theme.corner-small;
    background: tone == 2 ? Theme.s.error-container : tone == 1 ? Theme.s.warning-container : on-fill ? transparent : Theme.s.secondary-container;
    border-width: tone == 0 && on-fill ? 1px : 0px;
    border-color: Theme.s.on-secondary-container;
    accessible-role: AccessibleRole.text;
    accessible-label: label;
    t := T {
        text: root.label;
        role: TextRole.label-medium;
        color: root.tone == 2 ? Theme.s.on-error-container : root.tone == 1 ? Theme.s.on-warning-container : Theme.s.on-secondary-container;
        x: 8px;
    }
}

// ProfileCard
component ProfileCard inherits Card {
    in property <ProfileRow> p;
    in property <bool> picker;
    property <color> bar-tone: p.bar-tone == 2 ? Theme.s.error : p.bar-tone == 1 ? Theme.s.warning : Theme.s.primary;
    // Outlined; the selected profile fills with secondary-container and
    // shows the check badge.
    variant: 2;
    fills: true;
    selected: p.selected;
    long-press-menu: !p.updating && !picker;
    enabled: !App.transitioning;
    clicked => { Nav.act2("profile-select", p.id, picker ? "1" : "0"); }
    long-pressed(x, y) => { Nav.open-menu("profile:" + p.id, x, y); }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;
            HorizontalLayout {
                spacing: 8px;
                T { text: root.p.name; role: TextRole.title-medium; horizontal-stretch: 0; min-width: 40px; color: root.p.selected ? Theme.s.on-secondary-container : Theme.s.on-surface; }
                if root.p.days != "": Mid { TonePill { label: root.p.days; tone: root.p.days-tone; on-fill: root.p.selected; } }
                Rectangle { horizontal-stretch: 1; }
            }
            HorizontalLayout {
                spacing: 6px;
                if root.p.core != "": Mid { TonePill { label: root.p.core; on-fill: root.p.selected; } }
                T { text: root.p.source; role: TextRole.body-small; color: root.p.selected ? Theme.s.on-secondary-container : Theme.s.on-surface-variant; horizontal-stretch: 1; }
            }
            if root.p.has-usage: Rectangle {
                height: 10px;
                ProgressBar { y: 6px; value: clamp(root.p.ratio, 0, 1); tint: root.bar-tone; }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            if root.p.updating: Mid { Spinner { } }
            if !root.p.updating: T { text: root.p.updated; role: TextRole.body-small; color: root.p.selected ? Theme.s.on-secondary-container : Theme.s.on-surface-variant; horizontal-stretch: 0; }
            if root.p.selected: Mid { SelectionBadge { size: 24px; } }
        }
    }
}

export component ProfilesPage inherits Rectangle {
    in property <bool> picker;
    in property <int> leading: picker ? 2 : 0;
    property <length> gap: Nav.gap;
    property <int> columns: clamp(floor((self.width - 32px + gap) / (300px + gap)), 1, 3);
    property <length> card-height: Theme.leading(TextRole.title-medium) + 4px + Theme.leading(TextRole.body-small) + (Profiles.any-usage ? 10px : 0px) + 20px;
    background: Theme.s.surface;
    property <bool> scrolled;
    profiles-motion := ListMotion { count: Profiles.rows.length; }
    if App.remote: Appear { y: bar.height; height: parent.height - bar.height; EmptyState {
        glyph: Icons.profiles;
        title: @tr("Disconnect remote session to edit local profiles");
    } }
    if !App.remote && Profiles.rows.length == 0: Appear { y: bar.height; height: parent.height - bar.height; EmptyState {
        glyph: Icons.profiles;
        title: @tr("No profiles yet");
        message: @tr("Import a sing-box JSON configuration to get started.");
        action-label: @tr("Add profile");
        action => { Nav.open-menu("add-profile", root.width / 2, root.height / 2); }
    } }
    // The cards scroll under the top app bar (and the floating navigation bar).
    if !App.remote && Profiles.rows.length > 0: Appear { Flickable {
        y: 0;
        height: parent.height;
        content-height: bar.height + grid.height + 8px + 16px + (root.picker ? Nav.inset-bottom : Nav.home-bottom);
        changed content-y => {
            root.scrolled = self.content-y < 0;
        }
        grid := Rectangle {
            property <length> cell: (root.width - 32px - (root.columns - 1) * root.gap) / root.columns;
            y: bar.height + 8px;
            height: ceil(Profiles.rows.length / root.columns) * (root.card-height + root.gap);
            // List motion (kit.slint ListMotion): an added card fades in and
            // settles from just above its cell; when a profile is removed the
            // cards after it move into the cells before them (a card whose
            // cell now shows a later profile, the model updating in place,
            // or whose index fell, slides there from that profile's old cell).
            for p[i] in Profiles.rows: card := ProfileCard {
                property <string> pid: p.id;
                property <int> index: i;
                property <int> seen-index;
                property <length> from-x;
                property <length> from-y;
                enter := Entrance { enter: profiles-motion.adding; }
                slide := Entrance { }
                init => { self.seen-index = self.index; }
                // The cell `j` places a card at, relative to this card's.
                function slide-from(j: int) {
                    self.from-x = (mod(j, root.columns) - mod(i, root.columns)) * (grid.cell + root.gap);
                    self.from-y = (floor(j / root.columns) - floor(i / root.columns)) * (root.card-height + root.gap);
                    slide.play();
                }
                changed pid => {
                    if (profiles-motion.removing) { self.slide-from(i - profiles-motion.delta); }
                }
                changed index => {
                    if (profiles-motion.removing && self.index < self.seen-index) { self.slide-from(self.seen-index); }
                    self.seen-index = self.index;
                }
                x: 16px + mod(i, root.columns) * (grid.cell + root.gap) + self.from-x * (1 - slide.t);
                y: floor(i / root.columns) * (root.card-height + root.gap) + self.from-y * (1 - slide.t) - Theme.motion-list-rise * (1 - enter.t);
                opacity: enter.t;
                width: grid.cell;
                height: root.card-height;
                p: p;
                picker: root.picker;
            }
        }
    } }
    bar := TopBar {
        y: 0;
        title: @tr("Profiles");
        leading: root.leading;
        actions: root.picker ? [] : Profiles.bar-actions;
        scrolled: root.scrolled && !App.remote && Profiles.rows.length > 0;
        action(id) => { Nav.act("profiles-bar", id); }
    }
}

// CodeEditor: a gutter of line numbers beside a monospace field, no wrapping.
export component CodeEditorPage inherits Rectangle {
    in property <int> leading: 1;
    property <length> line-height: Theme.sp(13) * 1.6;
    background: Theme.s.surface;
    bar := TopBar {
        y: 0;
        title: Profiles.editor-title;
        leading: root.leading;
        loading: Profiles.config-loading;
        actions: Profiles.editor-actions;
        menu-key: "code-editor";
        action(id) => { Nav.act("editor-" + id, ""); }
    }
    VerticalLayout {
        y: bar.height;
        height: parent.height - bar.height - max(Nav.keyboard-height, Nav.inset-bottom);
        if Profiles.editor-search: HorizontalLayout {
            padding: 12px;
            spacing: 4px;
            SearchField {
                horizontal-stretch: 1;
                text <=> Profiles.editor-find;
                edited(t) => { Nav.act("editor-find", t); }
            }
            Mid { IconButton { glyph: Icons.arrow-down; tooltip: @tr("Search"); clicked => { Nav.act("editor-next", Profiles.editor-find); } } }
        }
        if Profiles.editor-error != "": Rectangle {
            background: Theme.s.error-container;
            height: err.preferred-height + 24px;
            err := SelectableText {
                x: 12px;
                width: parent.width - 24px;
                height: self.preferred-height;
                text: Profiles.editor-error;
                color: Theme.s.on-error-container;
                font-size: Theme.size(TextRole.body-large);
            }
        }
        if Profiles.editor-note != "": T {
            text: Profiles.editor-note;
            role: TextRole.body-small;
            color: Theme.s.on-surface-variant;
            wrap: word-wrap;
            height: self.preferred-height + 24px;
            x: 12px;
            width: parent.width - 24px;
        }
        if Profiles.editor-ready: HorizontalLayout {
            vertical-stretch: 1;
            gutter := Rectangle {
                width: numbers.preferred-width + 24px;
                background: Theme.s.surface-container-low;
                clip: true;
                numbers := Text {
                    x: 12px;
                    y: 16px + flick.content-y;
                    width: parent.width - 24px;
                    height: self.preferred-height;
                    text: Profiles.editor-lines;
                    font-family: Theme.mono;
                    font-size: Theme.sp(13);
                    horizontal-alignment: right;
                    color: Theme.s.on-surface-variant;
                }
            }
            flick := Flickable {
                horizontal-stretch: 1;
                content-height: max(self.height, editor.preferred-height + 32px);
                content-width: max(self.width, editor.preferred-width + 28px);
                editor := NativeTextInput {
                    x: 12px;
                    y: 16px;
                    width: max(flick.width - 28px, self.preferred-width);
                    height: max(flick.height - 32px, self.preferred-height);
                    // The native editor covers the viewport and scrolls the
                    // text itself; the gutter follows it.
                    frame-x: flick.absolute-position.x;
                    frame-y: flick.absolute-position.y;
                    frame-width: flick.width;
                    frame-height: flick.height;
                    mono: true;
                    native-scrolled(y) => { flick.content-y = -y; }
                    property <int> sel-tick: Profiles.editor-select-tick;
                    changed sel-tick => {
                        self.select(Profiles.editor-select-start, Profiles.editor-select-end);
                        flick.content-y = -max(0px, min(Profiles.editor-select-line * root.line-height - flick.height / 3, flick.content-height - flick.height));
                    }
                    property <int> text-tick: Profiles.editor-text-tick;
                    changed text-tick => { self.text = Profiles.config-text; }
                    init => { self.text = Profiles.config-text; }
                    single-line: false;
                    read-only: Profiles.editor-busy;
                    font-family: Theme.mono;
                    font-size: Theme.sp(13);
                    ink: Theme.s.on-surface;
                    edited => { Nav.act("editor-edited", self.text); }
                }
            }
        }
        if !Profiles.editor-ready && Profiles.editor-error == "": Rectangle { vertical-stretch: 1; }
        if !Profiles.editor-ready && Profiles.editor-error != "": EmptyState {
            vertical-stretch: 1;
            glyph: Icons.info;
            title: @tr("Retry");
            action-label: @tr("Retry");
            action => { Nav.act("editor-reload", ""); }
        }
    }
}

// QrCodeView: dark modules on white with the quiet zone, on a rounded card.
export component QrPage inherits ScrollPage {
    title: @tr("QR code");
    Rectangle { height: 8px; }
    HorizontalLayout {
        alignment: center;
        if Profiles.qr-path != "": Rectangle {
            width: min(240px, root.width - 32px);
            height: self.width;
            background: white;
            border-radius: Theme.radius;
            Path {
                viewbox-width: Profiles.qr-size;
                viewbox-height: Profiles.qr-size;
                commands: Profiles.qr-path;
                fill: black;
            }
        }
        if Profiles.qr-path == "": SelectableText {
            text: Profiles.qr-text;
            horizontal-alignment: center;
            color: Theme.s.on-surface;
        }
    }
}

export component ProfileRoutes inherits Rectangle {
    in property <string> kind;
    in property <int> leading;
    out property <bool> handles: kind == "profiles-picker" || kind == "code-editor" || kind == "profile-qr";
    if root.kind == "profiles-picker": ProfilesPage { picker: true; leading: root.leading; }
    if root.kind == "code-editor": CodeEditorPage { leading: root.leading; }
    if root.kind == "profile-qr": QrPage { leading: root.leading; }
}
