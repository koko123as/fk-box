// A service's mark on a tile with its status dot in a notch at the bottom end
// (FlClash _ServiceBadge; the marks are in src/pages/service_icons.rs).
component ServiceBadge inherits Rectangle {
    in property <string> fill-path;
    in property <string> stroke-path;
    // 0 no dot, 1 available, 2 warning, 3 error, 4 checking.
    in property <int> tone;
    in property <color> ring;
    in property <length> size: 32px;
    in property <bool> enabled: true;
    property <color> ink: root.enabled ? Theme.s.on-surface-variant : Theme.s.on-surface-variant.with-alpha(0.38);
    width: root.size;
    height: root.size;
    border-radius: Theme.corner-small;
    background: Theme.s.surface-container-high;
    if root.fill-path != "": Path {
        x: root.size * 0.22;
        y: root.size * 0.22;
        width: root.size * 0.56;
        height: root.size * 0.56;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.ink;
        commands: root.fill-path;
    }
    if root.stroke-path != "": Path {
        x: root.size * 0.22;
        y: root.size * 0.22;
        width: root.size * 0.56;
        height: root.size * 0.56;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.ink;
        stroke-width: root.size * 0.56 / 12;
        stroke-line-cap: round;
        commands: root.stroke-path;
    }
    // The status dot in a notch of the surrounding colour at the bottom end.
    if root.tone > 0: Rectangle {
        x: parent.width - 9px;
        y: parent.height - 9px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: root.ring;
        Rectangle {
            x: 2px;
            y: 2px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.tone == 1 ? Theme.s.success : root.tone == 2 ? Theme.s.warning : root.tone == 3 ? Theme.s.error : Theme.s.on-surface-variant;
        }
    }
}

// One service on the card (FlClash _ServiceCell): its mark and its latency
// or why it is not available.
component ServiceCell inherits Rectangle {
    in property <ServiceItem> s;
    height: 48px;
    horizontal-stretch: 1;
    border-radius: Theme.corner-medium;
    background: Theme.s.surface-container-low;
    accessible-role: AccessibleRole.text;
    accessible-label: root.s.label + " " + root.s.status;
    HorizontalLayout {
        padding-left: 7px;
        padding-right: 12px;
        spacing: 8px;
        Mid { ServiceBadge { fill-path: root.s.fill; stroke-path: root.s.stroke; tone: root.s.loading ? 0 : root.s.tone; ring: Theme.s.surface-container-low; } }
        if root.s.loading: Mid { Skeleton { width: 44px; pill-height: Theme.sp(12); } }
        if !root.s.loading: T {
            text: root.s.status;
            role: TextRole.label-medium;
            horizontal-stretch: 1;
            color: root.s.tone == 3 ? Theme.s.error : root.s.tone == 2 ? Theme.s.warning : Theme.s.on-surface-variant;
        }
    }
}

// Service status (FlClash ServiceStatusCard): the first four enabled
// services, two to a row, with a verdict chip; a tap opens every service.
export component ServicePanel inherits Panel {
    clickable: true;
    clicked => { Nav.act("service-open", ""); }
    PanelTitle {
        title: @tr("Service status");
        glyph: Icons.verified;
        if Dash.services-checking && Dash.service-verdict == "": Mid { Spinner { size: 16px; } }
        if Dash.service-verdict != "": Mid { Chip { label: Dash.service-verdict; tone: Dash.service-verdict-tone; } }
        Mid { Icon { glyph: Icons.chevron-forward; color: Theme.s.on-surface-variant; } }
    }
    Rectangle { height: 4px; }
    VerticalLayout {
        spacing: 8px;
        for row in ceil(Dash.services.length / 2): HorizontalLayout {
            spacing: 8px;
            ServiceCell { s: Dash.services[row * 2]; }
            if row * 2 + 1 < Dash.services.length: ServiceCell { s: Dash.services[row * 2 + 1]; }
            if row * 2 + 1 >= Dash.services.length: Rectangle { horizontal-stretch: 1; }
        }
    }
}

// A service in the page or the manager (FlClash _ServiceRow,
// _ServiceManageItem): grouped rows like ListItem with the mark leading.
component ServiceRow inherits Rectangle {
    in property <ServiceItem> s;
    in property <int> position: 4;
    in property <bool> clickable: true;
    in property <bool> manage;
    in property <bool> first;
    in property <bool> last;
    callback clicked();
    property <bool> top: position == 1 || position == 4;
    property <bool> bottom: position == 3 || position == 4;
    min-height: max(72px, lay.preferred-height);
    border-top-left-radius: top ? Theme.corner-large : Theme.corner-none;
    border-top-right-radius: top ? Theme.corner-large : Theme.corner-none;
    border-bottom-left-radius: bottom ? Theme.corner-large : Theme.corner-none;
    border-bottom-right-radius: bottom ? Theme.corner-large : Theme.corner-none;
    background: Theme.level(1);
    clip: true;
    accessible-role: button;
    accessible-label: root.s.label + " " + root.s.status;
    Tap {
        border-top-left-radius: root.border-top-left-radius;
        border-top-right-radius: root.border-top-right-radius;
        border-bottom-left-radius: root.border-bottom-left-radius;
        border-bottom-right-radius: root.border-bottom-right-radius;
        enabled: root.clickable;
        clicked => { root.clicked(); }
    }
    lay := HorizontalLayout {
        padding-left: 12px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 16px;
        Mid { ServiceBadge {
            size: 40px;
            fill-path: root.s.fill;
            stroke-path: root.s.stroke;
            enabled: root.s.enabled;
            tone: root.manage ? 0 : root.s.loading ? 4 : root.s.tone;
            ring: Theme.level(1);
        } }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            T {
                text: root.s.label;
                color: root.s.enabled ? Theme.s.on-surface : Theme.s.on-surface-variant;
            }
            if root.manage && root.s.on-card: T {
                text: @tr("Shown on dashboard");
                role: TextRole.body-small;
                color: Theme.s.on-surface-variant;
            }
            // The line is always there so a check does not resize the row.
            if !root.manage && root.s.loading: Skeleton { width: 96px; pill-height: Theme.sp(12); }
            if !root.manage && !root.s.loading: T {
                text: root.s.subtitle == "" ? "—" : root.s.subtitle;
                role: TextRole.body-small;
                color: Theme.s.on-surface-variant;
            }
        }
        if !root.manage && root.s.loading: Mid { Skeleton { width: 44px; pill-height: Theme.sp(12); } }
        if !root.manage && !root.s.loading: T {
            text: root.s.status;
            role: TextRole.label-medium;
            horizontal-alignment: right;
            max-width: 150px;
            wrap: word-wrap;
            color: root.s.tone == 3 ? Theme.s.error : root.s.tone == 2 ? Theme.s.warning : Theme.s.on-surface-variant;
        }
        if root.manage: Mid { IconButton {
            glyph: Icons.arrow-up;
            enabled: !root.first;
            tooltip: @tr("Move up");
            clicked => { Nav.act("service-up", root.s.id); }
        } }
        if root.manage: Mid { IconButton {
            glyph: Icons.arrow-down;
            enabled: !root.last;
            tooltip: @tr("Move down");
            clicked => { Nav.act("service-down", root.s.id); }
        } }
        if root.manage: Mid { Switch {
            checked: root.s.enabled;
            toggled(v) => { Nav.act("service-toggle", root.s.id); }
        } }
    }
    if !root.bottom: Rectangle {
        x: 68px;
        y: parent.height - 1px;
        width: parent.width - self.x - 16px;
        height: 1px;
        background: Theme.s.outline-variant;
    }
}

// ServiceStatusSheet: every enabled service; a row checks its service again,
// the bar checks all and opens the manager.
export component ServicesPage inherits ScrollPage {
    title: @tr("Service status");
    loading: Dash.services-checking-all;
    actions: [
        { id: "service-check-all", glyph: Icons.bolt, tooltip: @tr("Check all"), enabled: !Dash.services-checking-all },
        { id: "service-manage", glyph: Icons.sliders, tooltip: @tr("Manage services"), enabled: true },
    ];
    action(id) => { Nav.act(id, ""); }
    SectionTitle { first: true; }
    VerticalLayout {
        for s[i] in Dash.services-all: ServiceRow {
            s: s;
            position: Dash.services-all.length == 1 ? 4 : i == 0 ? 1 : i == Dash.services-all.length - 1 ? 3 : 2;
            clickable: !s.loading;
            clicked => { Nav.act("service-check", s.id); }
        }
    }
}

// ServiceManageView: every service, turned on or off and ordered; the first
// four enabled are the card's.
export component ServicesManagePage inherits ScrollPage {
    title: @tr("Manage services");
    SectionTitle { first: true; }
    VerticalLayout {
        for s[i] in Dash.services-manage: ServiceRow {
            s: s;
            manage: true;
            first: i == 0;
            last: i == Dash.services-manage.length - 1;
            position: Dash.services-manage.length == 1 ? 4 : i == 0 ? 1 : i == Dash.services-manage.length - 1 ? 3 : 2;
            clickable: false;
        }
    }
}

component ConnStat inherits Rectangle {
    in property <string> value;
    in property <string> label;
    in property <string> feed;
    // Whole counts count to their new value; "12.3k" and "—" show as they are.
    property <float> n: root.value.is-float() ? root.value.to-float() : -1;
    property <float> shown: max(0, root.n);
    animate shown { duration: Theme.motion-medium; easing: Theme.easing-decelerate; }
    horizontal-stretch: 1;
    border-radius: Theme.corner-medium;
    accessible-role: button;
    accessible-label: root.label + " " + root.value;
    StateLayer { border-radius: root.border-radius; enabled: root.feed != ""; pressed: cta.pressed; hover: cta.has-hover; }
    crip := Ripple { border-radius: root.border-radius; enabled: root.feed != ""; }
    VerticalLayout {
        alignment: center;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 4px;
        T { text: root.n < 0 ? root.value : round(root.shown) + ""; role: TextRole.headline-small; emphasized: true; horizontal-alignment: center; }
        T { text: root.label; role: TextRole.body-small; color: Theme.s.on-surface-variant; horizontal-alignment: center; }
    }
    cta := TouchArea {
        enabled: root.feed != "";
        clicked => { Nav.act("open-requests", root.feed); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { crip.down(self.mouse-x, self.mouse-y); }
            else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { crip.up(); }
        }
        changed pressed => { if (!self.pressed) { crip.up(); } }
        changed has-hover => { if (!self.has-hover) { crip.up(); } }
    }
}

// Connection statistics (FlClash ConnectionStatsCard): live connections and
// recent requests, each opening its list, and the DNS lookups.
export component ConnStatsPanel inherits Rectangle {
    background: Theme.s.surface-container-highest;
    border-radius: Theme.radius;
    min-height: lay.min-height;
    preferred-height: lay.preferred-height;
    lay := HorizontalLayout {
        padding: 8px;
        ConnStat { value: Dash.conn-live; label: @tr("Live connections"); feed: "live"; }
        ConnStat { value: Dash.conn-recent; label: @tr("Recent requests"); feed: "recent"; }
        ConnStat { value: Dash.conn-dns; label: @tr("DNS queries"); }
    }
}

// The remote, restart and deprecation rows (DashboardBanners).
component Banners inherits VerticalLayout {
    in property <bool> top: true;
    spacing: Nav.gap;
    if root.top && App.remote: ListItem {
        title: App.remote-name;
        subtitle: @tr("Remote control");
        Mid { Button {
            label: @tr("Disconnect");
            kind: 2;
            
            clicked => { Nav.act("remote-disconnect", ""); }
        } }
    }
    if root.top && Dash.apply-required: ListItem {
        title: @tr("Restart required");
        Mid { Button {
            label: @tr("Apply");
            kind: 2;
            
            clicked => { Nav.act("apply-restart", ""); }
        } }
    }
    if !root.top: VerticalLayout {
        spacing: Nav.gap;
        for n in Dash.deprecated: ListItem {
            title: n.message;
            clickable: n.url != "";
            clicked => { Nav.act("open-url", n.url); }
        }
    }
}

// A card in a grid row: as tall as the row, its panel filling it. The
// network speed takes its two columns as separate upload and download cards.
component GridCard inherits Rectangle {
    in property <string> card;
    min-height: lay.min-height;
    preferred-height: lay.preferred-height;
    lay := VerticalLayout {
        if root.card == "Status": StatusPanel { }
        if root.card == "Network speed": HorizontalLayout {
            spacing: Nav.gap;
            SpeedCard { upload: true; horizontal-stretch: 1; }
            SpeedCard { upload: false; horizontal-stretch: 1; }
        }
        if root.card == "Outbound mode": ModePanel { compact: true; }
        if root.card == "VPN": VpnPanel { }
        if root.card == "Current profile": ProfilePanel { }
        if root.card == "Service status": ServicePanel { }
        if root.card == "Connection stats": ConnStatsPanel { }
        if root.card == "Proxy groups": GroupsPanel { }
        if root.card == "Memory": MemoryPanel { }
        if root.card == "Intranet IP": IntranetPanel { }
        if root.card == "System HTTP proxy": SystemProxyPanel { }
    }
}

component DashboardCard inherits Rectangle {
    in property <string> card;
    height: lay.preferred-height;
    lay := VerticalLayout {
        if root.card == "Status": StatusPanel { }
        if root.card == "Network speed": SpeedPanel { }
        if root.card == "Outbound mode": ModePanel { }
        if root.card == "VPN": VpnPanel { }
        if root.card == "Current profile": ProfilePanel { }
        if root.card == "Service status": ServicePanel { }
        if root.card == "Connection stats": ConnStatsPanel { }
        if root.card == "Proxy groups": GroupsPanel { }
        if root.card == "Memory": MemoryPanel { }
        if root.card == "Intranet IP": IntranetPanel { }
        if root.card == "System HTTP proxy": SystemProxyPanel { }
    }
}

// The dashboard editor (FlClash dashboard/edit.dart), in place: the shown
// cards as they are, swaying slightly (Theme.motion-sway-*, driven by
// animation-tick()) and not interactive; a long press lifts a card, which
// then follows the finger while the cards it passes make room for it
// (Theme.motion-yield), and on release it settles into its new place before
// the order is saved (dash-move). The minus badge removes a card: it fades
// (Theme.motion-appear), then its room closes (Theme.motion-yield); a card
// added from the hidden list first makes its room, then appears. Status
// cannot be removed. The cards' places come from the layout; the drag only
// offsets the cards inside their slots, so nothing reads back a layout it
// changes.
component DashboardEditor inherits VerticalLayout {
    property <length> gap: Nav.gap;
    // The lifted card: its index and key, how far the finger moved it, its
    // slot's top and height (with the gap under it).
    property <int> from: -1;
    property <string> from-key;
    property <length> drag-dy;
    property <length> from-top;
    property <length> drag-h;
    // The slot the lifted card is over, and its edges.
    property <int> target: -1;
    property <length> target-top;
    property <length> target-bottom;
    // Released: the card glides to `settle-dy`, then the move is saved.
    property <bool> settling;
    property <length> settle-dy;
    property <bool> pending;
    // One frame without animation while the reordered list lands under the cards.
    property <bool> snap;
    // After the first frame: cards created from now on make an entrance.
    property <bool> ready;
    init => { if (ready-next.running) { ready-next.restart(); } else { ready-next.start(); } }
    ready-next := Timer {
        running: false;
        interval: 1ms;
        triggered => {
            self.stop();
            root.ready = true;
        }
    }
    function lift(index: int, key: string, top: length, h: length) {
        root.from = index;
        root.from-key = key;
        root.from-top = top;
        root.drag-h = h;
        root.drag-dy = 0px;
        root.target = index;
        root.target-top = top;
        root.target-bottom = top + h;
        root.settling = false;
        Motion.card-dragging = true;
    }
    function drop() {
        if (root.from < 0 || root.settling) { return; }
        Motion.card-dragging = false;
        root.settle-dy = root.target > root.from ? root.target-bottom - root.drag-h - root.from-top
            : root.target < root.from ? root.target-top - root.from-top : 0px;
        root.settling = true;
        settle-end.interval = Theme.motion-yield + 16ms;
        if (settle-end.running) { settle-end.restart(); } else { settle-end.start(); }
    }
    // The cards changed under the slots (moved, removed, added): drop the
    // drag offsets at once, without animating them.
    function reflow() {
        root.snap = true;
        root.from = -1;
        root.target = -1;
        root.settling = false;
        root.pending = false;
        if (snap-end.running) { snap-end.restart(); } else { snap-end.start(); }
    }
    settle-end := Timer {
        running: false;
        interval: Theme.motion-yield;
        triggered => {
            self.stop();
            if (root.target != root.from && root.target >= 0) {
                root.pending = true;
                if (give-up.running) { give-up.restart(); } else { give-up.start(); }
                Nav.act2("dash-move", root.from-key, root.target - root.from);
            } else {
                root.reflow();
            }
        }
    }
    // The saved order did not arrive (a failed save): put the cards back.
    give-up := Timer {
        running: false;
        interval: 1000ms;
        triggered => {
            self.stop();
            if (root.pending) { root.reflow(); }
        }
    }
    snap-end := Timer {
        running: false;
        interval: 32ms;
        triggered => {
            self.stop();
            root.snap = false;
        }
    }
    SectionTitle { text: @tr("Long-press a card to drag it"); first: true; }
    for c[i] in Dash.edit-shown: slot := Rectangle {
        property <string> k: c.key;
        property <bool> lifted: root.from == i;
        // Entrance and exit (FlClash _Presence): room, then the card.
        property <bool> entered: !root.ready;
        property <bool> removing;
        init => { self.entered = true; }
        changed k => {
            self.removing = false;
            root.reflow();
        }
        // The lifted card's centre decides which slot it is over.
        property <length> center: root.from-top + root.drag-dy + root.drag-h / 2;
        property <bool> hit: root.from >= 0 && !root.settling && self.center >= self.y && self.center < self.y + self.height;
        changed hit => {
            if (self.hit) {
                root.target = i;
                root.target-top = self.y;
                root.target-bottom = self.y + self.height;
            }
        }
        // The cards between the lifted card's place and the slot it is over
        // move one place towards where it came from.
        property <length> shift: root.from < 0 || self.lifted ? 0px
            : root.target > root.from && i > root.from && i <= root.target ? -root.drag-h
            : root.target < root.from && i >= root.target && i < root.from ? root.drag-h : 0px;
        // How open the slot's room is. Only this factor animates: an animated
        // height would keep the content height it had when its animation
        // started, so a card arriving in a reused slot (a move, a removal)
        // would sit in a room sized for the previous card.
        property <float> room: self.entered && !self.removing ? 1 : 0;
        animate room {
            duration: root.snap ? 0ms : Theme.motion-yield;
            delay: self.removing ? Theme.motion-appear : 0ms;
            easing: Theme.easing-standard;
        }
        height: self.room * (holder.preferred-height + root.gap);
        clip: self.room < 0.999;
        z: self.lifted ? 1 : 0;
        accessible-role: list-item;
        accessible-label: c.value;
        holder := Rectangle {
            y: slot.lifted ? (root.settling ? root.settle-dy : root.drag-dy) : slot.shift;
            animate y {
                duration: (slot.lifted && !root.settling) || root.snap ? 0ms : Theme.motion-yield;
                easing: Theme.easing-standard;
            }
            height: self.preferred-height;
            preferred-height: card.preferred-height;
            opacity: slot.entered && !slot.removing ? 1 : 0;
            transform-scale: slot.lifted ? 1.03 : slot.entered && !slot.removing ? 1 : Theme.motion-enter-scale;
            animate opacity, transform-scale {
                duration: Theme.motion-appear;
                delay: slot.entered && !slot.removing && !slot.lifted && !root.snap ? Theme.motion-yield : 0ms;
                easing: Theme.easing-decelerate;
            }
            // A shadow needs a fill of its own; the card covers it.
            background: slot.lifted ? Theme.s.surface-container-highest : transparent;
            drop-shadow-blur: slot.lifted ? Theme.shadow-blur(3) : 0px;
            drop-shadow-offset-y: slot.lifted ? Theme.shadow-offset(3) : 0px;
            drop-shadow-color: slot.lifted ? Theme.shadow-color(3) : transparent;
            border-radius: Theme.radius;
            // The sway: each card turns and bobs on its own phase while editing.
            swayer := Rectangle {
                property <bool> swaying: Theme.motion-on && !slot.lifted && !slot.removing;
                property <angle> turn: self.swaying
                    ? (mod(animation-tick() / Theme.motion-sway-period, 1) * [6, 7, 5][mod(i, 3)] * 360 + i * 97.4) * 1deg
                    : 0deg;
                y: self.swaying ? cos(self.turn) * Theme.motion-sway-bob : 0px;
                height: card.preferred-height;
                transform-rotation: self.swaying ? sin(self.turn) * Theme.motion-sway-turn : 0deg;
                card := DashboardCard { card: c.key; }
                // The card's own controls do not react while editing.
                TouchArea {
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            if (hold.running) { hold.restart(); } else { hold.start(); }
                        } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                            hold.stop();
                            if (slot.lifted) { root.drop(); }
                        }
                    }
                    moved => {
                        if (slot.lifted && !root.settling) {
                            root.drag-dy = self.mouse-y - self.pressed-y;
                        } else if (abs(self.mouse-x - self.pressed-x) > 12px || abs(self.mouse-y - self.pressed-y) > 12px) {
                            hold.stop();
                        }
                    }
                }
                hold := Timer {
                    running: false;
                    interval: 450ms;
                    triggered => {
                        self.stop();
                        root.lift(i, c.key, slot.y, slot.height);
                    }
                }
                // On the card's top corner, over its edge (FlClash's remove badge).
                if c.key != "Status": Rectangle {
                    x: parent.width - self.width + 6px;
                    y: -8px;
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: Theme.s.error-container;
                    drop-shadow-blur: Theme.shadow-blur(1);
                    drop-shadow-offset-y: Theme.shadow-offset(1);
                    drop-shadow-color: Theme.shadow-color(1);
                    accessible-role: button;
                    accessible-label: @tr("Remove");
                    accessible-action-default => { if (remove-now.running) { remove-now.restart(); } else { remove-now.start(); } slot.removing = true; }
                    Icon { glyph: Icons.remove; size: 18px; color: Theme.s.on-error-container; }
                    xrip := Ripple { border-radius: parent.border-radius; ink: Theme.s.on-error-container; centered: true; }
                    TouchArea {
                        width: Theme.min-target;
                        height: Theme.min-target;
                        enabled: !slot.removing && root.from < 0;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) { xrip.down(0px, 0px); }
                            else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { xrip.up(); }
                        }
                        changed pressed => { if (!self.pressed) { xrip.up(); } }
                        changed has-hover => { if (!self.has-hover) { xrip.up(); } }
                        clicked => {
                            slot.removing = true;
                            remove-now.interval = Theme.motion-appear + Theme.motion-yield + 16ms;
                            if (remove-now.running) { remove-now.restart(); } else { remove-now.start(); }
                        }
                    }
                }
                remove-now := Timer {
                    running: false;
                    interval: Theme.motion-yield;
                    triggered => {
                        self.stop();
                        Nav.act2("dash-hide", c.key, "");
                    }
                }
            }
        }
    }
    if Dash.edit-hidden.length > 0: SectionTitle { text: @tr("Hidden"); }
    for c[i] in Dash.edit-hidden: ListItem {
        position: Dash.edit-hidden.length == 1 ? 4 : i == 0 ? 1 : i == Dash.edit-hidden.length - 1 ? 3 : 2;
        title: c.value;
        Mid { IconButton {
            glyph: Icons.add;
            tooltip: @tr("Add");

            clicked => { Nav.act2("dash-show", c.key, ""); }
        } }
    }
}

export component DashboardPage inherits Rectangle {
    background: Theme.s.surface;
    // Phones: one column. Wider windows: a grid of 2 to 4 columns at least
    // 260 dp wide (FlClash's dashboard grid), the cards packed into rows by
    // dashboard.rs pack(). The editor keeps a reading width.
    property <length> grid-side: Nav.mobile ? 16px : 24px;
    property <length> grid-width: root.width - 2 * grid-side;
    property <int> columns: Nav.mobile ? 1 : clamp(floor((grid-width + Nav.gap) / (260px + Nav.gap)), 2, 4);
    property <length> unit: (grid-width - (columns - 1) * Nav.gap) / columns;
    // The cards scroll under the top app bar and the floating navigation bar.
    flick := Flickable {
        y: 0;
        height: parent.height;
        content-height: body.preferred-height;
        // A dragged card (the editor) moves instead of the page.
        interactive: !Motion.card-dragging;
        body := VerticalLayout {
            property <length> side: Dash.editing || Nav.mobile ? Nav.side(root.width) : root.grid-side;
            padding-left: side;
            padding-right: side;
            padding-top: bar.height + 8px;
            padding-bottom: 16px + Nav.home-bottom;
            spacing: Dash.editing ? 0px : Nav.gap;
            if Dash.editing: DashboardEditor { }
            if !Dash.editing && (App.remote || Dash.apply-required): Banners { }
            if !Dash.editing && Nav.mobile: VerticalLayout {
                spacing: Nav.gap;
                for c in Dash.cards: DashboardCard { card: c; }
            }
            if !Dash.editing && !Nav.mobile: VerticalLayout {
                spacing: Nav.gap;
                for row in root.columns >= 4 ? Dash.grid4 : root.columns == 3 ? Dash.grid3 : Dash.grid2: HorizontalLayout {
                    spacing: Nav.gap;
                    alignment: start;
                    for cell in row.cells: GridCard {
                        card: cell.card;
                        width: root.unit * cell.span + (cell.span - 1) * Nav.gap;
                    }
                }
            }
            if !Dash.editing && Dash.deprecated.length > 0: Banners { top: false; }
        }
    }
    bar := TopBar {
        y: 0;
        title: Dash.editing ? @tr("Edit dashboard") : @tr("Dashboard");
        loading: Dash.saving;
        actions: Dash.editing
            ? [{ id: "dash-done", glyph: Icons.check, tooltip: @tr("Done"), enabled: !Dash.saving }]
            : [{ id: "dash-edit", glyph: Icons.edit, tooltip: @tr("Dashboard cards"), enabled: true }];
        scrolled: flick.content-y < 0;
        action(id) => { Nav.act(id, ""); }
    }
}

// MemoryDetails
export component MemoryPage inherits ScrollPage {
    title: @tr("Memory");
    Rectangle { height: 8px; }
    T { text: @tr("Total"); role: TextRole.title-medium; }
    Rectangle { height: 4px; }
    MemorySummary { }
    Rectangle { height: 12px; }
    T {
        text: Dash.memory-remote ? @tr("Memory reported by the remote core. Detailed accounting is unavailable.")
            : @tr("App and core share one process. Core runtime memory is separated from process RSS, not added twice.");
        role: TextRole.body-small;
        color: Theme.s.on-surface-variant;
        wrap: word-wrap;
    }
    if !Dash.memory-remote: SectionTitle { text: @tr("App"); }
    if !Dash.memory-remote: VerticalLayout {
        for r[i] in Dash.memory-app-rows: ListItem {
            position: Dash.memory-app-rows.length == 1 ? 4 : i == 0 ? 1 : i == Dash.memory-app-rows.length - 1 ? 3 : 2;
            title: r.key;
            trailing-text: r.value;
        }
    }
    SectionTitle { text: @tr("Core"); }
    VerticalLayout {
        for r[i] in Dash.memory-core-rows: ListItem {
            position: Dash.memory-core-rows.length == 1 ? 4 : i == 0 ? 1 : i == Dash.memory-core-rows.length - 1 ? 3 : 2;
            title: r.key;
            subtitle: i < Dash.memory-core-percents.length && Dash.memory-core-percents[i] != "" ? r.value : "";
            trailing-text: i < Dash.memory-core-percents.length && Dash.memory-core-percents[i] != "" ? Dash.memory-core-percents[i] : r.value;
        }
    }
}

// EgressDetails
export component EgressPage inherits ScrollPage {
    title: @tr("Outbound IP");
    actions: [{ id: "egress-copy", glyph: Icons.copy, tooltip: @tr("Copy"), enabled: Dash.egress-ip != "" }];
    action(id) => { Nav.act(id, ""); }
    SectionTitle { first: true; }
    VerticalLayout {
        for r[i] in Dash.egress-rows: ListItem {
            position: Dash.egress-rows.length == 1 ? 4 : i == 0 ? 1 : i == Dash.egress-rows.length - 1 ? 3 : 2;
            title: r.key;
            subtitle: r.value == "" ? "—" : r.value;
        }
    }
}

// IntranetDetails
export component IntranetPage inherits ScrollPage {
    title: @tr("Intranet IP");
    actions: [{ id: "lan-refresh", glyph: Icons.refresh, tooltip: @tr("Reload"), enabled: !Dash.lan-changing }];
    action(id) => { Nav.act(id, ""); }
    SectionTitle { text: @tr("This device"); first: true; }
    if Dash.lan-addresses.length == 0: ListItem { title: @tr("No network"); }
    VerticalLayout {
        for a[i] in Dash.lan-addresses: ListItem {
            position: Dash.lan-addresses.length == 1 ? 4 : i == 0 ? 1 : i == Dash.lan-addresses.length - 1 ? 3 : 2;
            title: a;
            Mid { IconButton {
                glyph: Icons.copy;
                tooltip: @tr("Copy");
                
                clicked => { Nav.act("copy", a); }
            } }
        }
    }
    if !App.remote: Rectangle { height: 24px; }
    if !App.remote: LanProxyRow { value: Dash.lan-enabled; subtitle: Dash.lan-subtitle; enabled: Dash.lan-can-toggle; }
    if !App.remote && Dash.lan-error != "": VerticalLayout {
        padding-top: 16px;
        spacing: 8px;
        T { text: Dash.lan-error; role: TextRole.body-medium; color: Theme.s.error; wrap: word-wrap; horizontal-alignment: center; }
        HorizontalLayout { alignment: center; Button { label: @tr("Retry"); clicked => { Nav.act("lan-refresh", ""); } } }
    }
    if !App.remote: SectionTitle { text: @tr("Local proxy listeners"); }
    if !App.remote: VerticalLayout {
        for r[i] in Dash.lan-listeners: ListItem {
            position: Dash.lan-listeners.length == 1 ? 4 : i == 0 ? 1 : i == Dash.lan-listeners.length - 1 ? 3 : 2;
            title: r.key;
            subtitle: r.value == "copy" ? "" : r.value;
            if r.value == "copy": Mid { IconButton {
                glyph: Icons.copy;
                tooltip: @tr("Copy");
                
                clicked => { Nav.act("copy", r.key); }
            } }
        }
    }
    if !App.remote && Dash.has-profile: Rectangle { height: 24px; }
    if !App.remote && Dash.has-profile: ListItem {
        title: @tr("Open configuration");
        has-leading: true;
        leading: Icons.code;
        chevron: true;
        clickable: true;
        clicked => { Nav.push("profile-config", "selected"); }
    }
}

// NewLANProxy
export component NewLanProxyPage inherits ScrollPage {
    title: @tr("Add proxy listener");
    loading: Dash.lan-changing;
    actions: [{ id: "lan-add-save", glyph: Icons.check, tooltip: @tr("Save"), enabled: Dash.lan-can-toggle }];
    action(id) => { Nav.act(id, Dash.lan-port); }
    Rectangle { height: 8px; }
    Field {
        label: @tr("Port");
        text <=> Dash.lan-port;
        invalid: Dash.lan-port-invalid;
        input-type: number;
        edited => { Nav.act("lan-port-edited", ""); }
    }
    if Dash.lan-port-invalid: HorizontalLayout { padding-left: 16px; T { text: @tr("Invalid proxy port"); role: TextRole.body-small; color: Theme.s.error; } }
    Rectangle { height: 16px; }
    T { text: @tr("Adds an HTTP and SOCKS proxy to the selected profile."); role: TextRole.body-small; color: Theme.s.on-surface-variant; wrap: word-wrap; }
}
