// The dashboard and its panels (layout after FlClash, GPL-3.0), in M3:
// filled cards on the surface, card headers in title-medium, figures in the
// display/headline roles, nested tiles on surface-container-low, the start
// action as a large FAB, the outbound mode as a segmented button, toggles as
// switches, and grouped lists for the detail pages.

import { Theme, TextRole } from "../theme.slint";
import { Icons, Glyph } from "../icons.slint";
import { Nav, BarAction, Motion } from "../globals.slint";
import { App, Dash, ModeItem, KeyValue, ServiceItem } from "../data.slint";
import { Mid, Icon, T, Spinner, ProgressBar, IconButton, Button, Switch, IconBadge, Skeleton, Chip, Panel, PanelTitle, ListItem, SectionTitle, Footer, TopBar, ScrollPage, Field, StateLayer, Ripple, Tap, FocusRing, Appear } from "../kit.slint";

// Figures that count to their new value (rates, memory, counts). The texts
// Rust formats (src/format.rs bytes() and count()) are read back into a
// number, animated, and formatted again the same way; a text that is not a
// number ("—") shows as it is.
global Tween {
    public pure function unit-index(unit: string) -> int {
        if (unit == "B") { return 0; }
        if (unit == "KB") { return 1; }
        if (unit == "MB") { return 2; }
        if (unit == "GB") { return 3; }
        if (unit == "TB") { return 4; }
        return -1;
    }
    // A bytes() figure and unit as bytes; -1 when they are not numbers.
    public pure function bytes-of(figure: string, unit: string) -> float {
        return figure.is-float() && unit-index(unit) >= 0 ? figure.to-float() * pow(1024, unit-index(unit)) : -1;
    }
    public pure function unit-step(bytes: float) -> int {
        return bytes < 1024 ? 0 : bytes < pow(1024, 2) ? 1 : bytes < pow(1024, 3) ? 2 : bytes < pow(1024, 4) ? 3 : 4;
    }
    public pure function unit(bytes: float) -> string {
        return ["B", "KB", "MB", "GB", "TB"][unit-step(bytes)];
    }
    // bytes(): whole bytes, else one decimal.
    public pure function figure(bytes: float) -> string {
        return unit-step(bytes) == 0 ? round(bytes) + "" : one-decimal(bytes / pow(1024, unit-step(bytes)));
    }
    public pure function one-decimal(v: float) -> string {
        return floor(round(v * 10) / 10) + "." + mod(round(v * 10), 10);
    }
    // figure()'s shape with every digit a "0" ("00.0", "000"): the width the
    // figure keeps while its digits count, so the unit after it does not jump
    // when "9.9" becomes "10.0" only at a new digit count.
    public pure function pattern(bytes: float) -> string {
        let v = unit-step(bytes) == 0 ? round(bytes) : round(bytes / pow(1024, unit-step(bytes)) * 10) / 10;
        let whole = v < 10 ? "0" : v < 100 ? "00" : v < 1000 ? "000" : "0000";
        return unit-step(bytes) == 0 ? whole : whole + ".0";
    }
}

// A rate figure: Slint cannot select tabular figures, so the box is as wide
// as the wider of the text and its digit pattern (Tween.pattern), plus room
// for the last glyph's overhang (no negative tracking, which drew the last
// glyph past the measured width), and as tall as the role's line height.
// When `avail` is narrower than the widest figure (large font scales on a
// phone) the figure shrinks, to 75 % at most, before it would be cut.
component RateFigure inherits Rectangle {
    in property <string> text;
    in property <string> pattern;
    in property <TextRole> role;
    in property <length> avail;
    property <length> natural: max(pattern-measure.preferred-width, text-measure.preferred-width) + root.overhang;
    property <length> overhang: 0.08 * Theme.size(root.role);
    // Fit for the widest figure a rate shows (three digits and a decimal),
    // so both tiles and every value keep one size.
    property <float> fit: clamp(root.avail / max(1px, max(root.natural, widest-measure.preferred-width + root.overhang)), 0.75, 1);
    width: root.natural * root.fit;
    height: Theme.leading(root.role);
    horizontal-stretch: 0;
    widest-measure := T { visible: false; text: "000.0"; role: root.role; emphasized: true; }
    pattern-measure := T { visible: false; text: root.pattern; role: root.role; emphasized: true; }
    text-measure := T { visible: false; text: root.text; role: root.role; emphasized: true; }
    T {
        x: 0;
        width: parent.width;
        height: parent.height;
        text: root.text;
        role: root.role;
        emphasized: true;
        font-size: Theme.size(root.role) * root.fit;
        vertical-alignment: bottom;
        accessible-role: none;
    }
}

// The service's start/stop: the screen's dominant action, an M3 large FAB
// (extra-large corners) in primary-container whether running or not; the
// icon (start or stop) and the corner morph carry the state. It sits in
// the status card, so it is lowered (level 1 shadow).
component StartToggle inherits Rectangle {
    in property <length> size: 96px;
    in property <bool> enabled: true;
    in property <bool> running;
    in property <bool> busy;
    callback clicked();
    property <color> ink: !enabled ? Theme.s.on-surface.with-alpha(Theme.disabled-content) : Theme.s.on-primary-container;
    // Starting and stopping morph the button with an overshoot (ease-out-back,
    // FlClash's status decoration): the corners tighten and the icon turns.
    property <float> morph: root.running ? 1 : 0;
    animate morph { duration: Theme.motion-long; easing: Theme.easing-back; }
    width: size;
    height: size;
    border-radius: Theme.corner-extra-large - (Theme.corner-extra-large - Theme.corner-large) * root.morph;
    background: !enabled ? Theme.s.on-surface.with-alpha(Theme.disabled-container) : Theme.s.primary-container;
    animate background { duration: Theme.motion-short; easing: Theme.easing-standard; }
    drop-shadow-blur: enabled ? Theme.shadow-blur(ta.has-hover ? 2 : 1) : 0px;
    drop-shadow-offset-y: enabled ? Theme.shadow-offset(1) : 0px;
    drop-shadow-color: enabled ? Theme.shadow-color(1) : transparent;
    accessible-role: button;
    accessible-label: running ? @tr("Stop") : @tr("Start");
    accessible-enabled: enabled && !busy;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    StateLayer { border-radius: root.border-radius; ink: root.ink; enabled: root.enabled; pressed: ta.pressed; hover: ta.has-hover; focused: fs.has-focus; }
    rip := Ripple { border-radius: root.border-radius; ink: root.ink; enabled: root.enabled; }
    if root.busy: Spinner { size: root.size * 0.36; tint: root.ink; }
    if !root.busy: Icon {
        glyph: root.running ? Icons.pause : Icons.start;
        size: 36px;
        color: root.ink;
        transform-rotation: root.morph * 180deg;
    }
    FocusRing { shown: fs.has-focus; corner: root.border-radius; }
    fs := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == Key.Space) { root.clicked(); return EventResult.accept; }
            EventResult.reject
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { rip.down(self.mouse-x, self.mouse-y); }
            else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { rip.up(); }
        }
        changed pressed => { if (!self.pressed) { rip.up(); } }
        changed has-hover => { if (!self.has-hover) { rip.up(); } }
    }
}

// CountryBadge
component CountryBadge inherits Rectangle {
    in property <length> size: 48px;
    in property <string> country;
    in property <bool> active;
    in property <bool> checking;
    in property <bool> can-retry;
    callback retry();
    property <color> fg: active ? Theme.s.on-secondary-container : Theme.s.on-secondary-container.with-alpha(0.72);
    width: size;
    height: size;
    border-radius: size / 2;
    accessible-role: button;
    accessible-label: root.country;
    // A new exit (another outbound, country or check) pops in with an
    // overshoot (ease-out-back) from 60 %.
    property <bool> popping;
    property <duration> pop-start;
    changed country => {
        if (Theme.motion-on) {
            self.pop-start = animation-tick();
            self.popping = true;
            pop-end.interval = Theme.motion-long + 16ms;
            if (pop-end.running) { pop-end.restart(); } else { pop-end.start(); }
        }
    }
    pop-end := Timer {
        running: false;
        interval: Theme.motion-long;
        triggered => {
            self.stop();
            root.popping = false;
        }
    }
    // Scaled inside the root: a root element's own transform-scale is ignored.
    face := Rectangle {
        border-radius: root.border-radius;
        background: Theme.s.secondary-container;
        transform-scale: root.popping ? 0.6 + 0.4 * Theme.ease-out-back(Theme.progress(animation-tick(), root.pop-start, Theme.motion-long)) : 1;
        if root.checking: Spinner { size: root.size * 0.5; tint: root.fg; }
        if !root.checking && root.country != "": T {
            text: root.country;
            role: TextRole.label-medium;
            color: root.fg;
            horizontal-alignment: center;
        }
        if !root.checking && root.country == "": Icon { glyph: Icons.proxies; size: root.size * 0.42; color: root.fg; }
        Tap {
            border-radius: root.border-radius;
            ink: Theme.s.on-secondary-container;
            centered: true;
            enabled: root.can-retry;
            clicked => { root.retry(); }
        }
    }
}

// A label over a value. `keep`: the value keeps its whole width (the run
// time); otherwise the cell takes what is left and the value elides (the
// organization's name).
component StatusCell inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> loading;
    in property <bool> keep;
    spacing: 2px;
    horizontal-stretch: root.keep ? 0 : 1;
    T {
        text: root.label;
        role: TextRole.body-small;
        color: Theme.s.on-surface-variant;
        min-width: root.keep ? self.preferred-width : 0px;
    }
    if root.loading: Skeleton { width: 96px; pill-height: Theme.sp(14); }
    if !root.loading: T {
        text: root.value;
        role: TextRole.title-small;
        height: Theme.leading(TextRole.title-small);
        // Room for the last glyph's overhang so it is never trimmed.
        min-width: root.keep ? self.preferred-width + 0.08 * Theme.size(TextRole.title-small) : 0px;
    }
}

export component StatusPanel inherits Rectangle {
    background: Theme.s.surface-container-highest;
    border-radius: Theme.radius;
    min-height: lay.min-height;
    preferred-height: lay.preferred-height;
    lay := HorizontalLayout {
        padding-left: 16px;
        padding-top: 12px;
        padding-bottom: 16px;
        padding-right: 16px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: start;
            HorizontalLayout {
                height: max(Theme.min-target, Theme.leading(TextRole.title-medium));
                spacing: 8px;
                Mid { Icon { glyph: Icons.status; size: 20px; color: Theme.s.primary; } }
                T { text: @tr("Status"); role: TextRole.title-medium; horizontal-stretch: 0; }
                Rectangle {
                    horizontal-stretch: 1;
                    Chip {
                        x: 0;
                        label: Dash.status-label;
                        tone: App.running ? 1 : 0;
                        dot: App.running;
                    }
                }
            }
            Rectangle { height: 12px; }
            HorizontalLayout {
                spacing: 12px;
                Mid { CountryBadge {
                    country: Dash.egress-country;
                    active: App.running;
                    checking: Dash.egress-loading;
                    can-retry: Dash.egress-can-retry;
                    
                    retry => { Nav.act("egress-retry", ""); }
                } }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    // Title2 on a phone (DashboardDensity.Mobile), Title1 wider; the IP
                    // shrinks to fit down to 75% (TextAutoSize.StepBased), then elides.
                    ip-box := Rectangle {
                        property <TextRole> ip-role: Nav.mobile ? TextRole.headline-small : TextRole.headline-medium;
                        height: Theme.leading(self.ip-role);
                        ip-measure := T {
                            visible: false;
                            text: Dash.egress-ip;
                            role: parent.ip-role;
                            emphasized: true;
                        }
                        if Dash.egress-ip != "": T {
                            x: 0;
                            width: parent.width;
                            text: Dash.egress-ip;
                            role: parent.ip-role;
                            emphasized: true;
                            font-size: clamp(Theme.size(parent.ip-role) * parent.width / max(1px, ip-measure.preferred-width), Theme.size(parent.ip-role) * 0.75, Theme.size(parent.ip-role));
                            color: App.running ? Theme.s.on-surface : Theme.s.on-surface-variant;
                            Tap { border-radius: Theme.corner-small; clicked => { Nav.form("egress", ""); } }
                        }
                        if Dash.egress-ip == "" && Dash.egress-skeleton: Skeleton {
                            x: 0;
                            width: 140px;
                            pill-height: Theme.sp(24);
                        }
                        if Dash.egress-ip == "" && !Dash.egress-skeleton: T {
                            x: 0;
                            width: parent.width;
                            text: Dash.egress-failed ? @tr("Check failed") : "—";
                            role: parent.ip-role;
                            emphasized: true;
                            color: Dash.egress-failed ? Theme.s.error : App.running ? Theme.s.on-surface : Theme.s.on-surface-variant;
                        }
                    }
                    // As tall as the chips it holds (they grow with the font
                    // scale), so their borders are never cut; the clip only
                    // trims a row too wide for the card.
                    Rectangle {
                        height: Theme.chip-height-large;
                        clip: true;
                        if Dash.egress-failed && Dash.egress-ip == "": T {
                            x: 0;
                            text: @tr("Tap icon to retry");
                            role: TextRole.body-small;
                            color: Theme.s.on-surface-variant;
                        }
                        if !(Dash.egress-failed && Dash.egress-ip == ""): HorizontalLayout {
                            alignment: start;
                            spacing: 6px;
                            if Dash.egress-skeleton || (Dash.organization-loading && Dash.egress-ip == ""): Skeleton { width: 48px; pill-height: Theme.chip-height-large; }
                            if Dash.egress-skeleton || (Dash.organization-loading && Dash.egress-ip == ""): Skeleton { width: 72px; pill-height: Theme.chip-height-large; }
                            if !(Dash.egress-skeleton || (Dash.organization-loading && Dash.egress-ip == "")): Chip { label: Dash.egress-type; large: true; }
                            if !(Dash.egress-skeleton || (Dash.organization-loading && Dash.egress-ip == "")) && Dash.egress-quality != "": Chip {
                                label: @tr("Quality") + " " + Dash.egress-quality;
                                large: true;
                                tone: Dash.egress-quality-tone;
                            }
                        }
                    }
                }
            }
            Rectangle { height: 16px; }
            HorizontalLayout {
                spacing: 24px;
                StatusCell { label: @tr("Run time"); value: Dash.runtime; keep: true; }
                StatusCell {
                    label: @tr("Organization");
                    value: Dash.organization == "" ? "—" : Dash.organization;
                    loading: Dash.organization == "" && Dash.organization-loading;
                }
            }
        }
        // The start and stop button sits in the card on every width.
        Rectangle {
            property <length> size: Nav.mobile ? 80px : 96px;
            width: self.size + (Nav.mobile ? 0px : 24px);
            if App.remote: Icon { glyph: Icons.proxies; size: 60px; }
            if !App.remote: StartToggle {
                size: parent.size;
                enabled: Dash.start-enabled;
                running: App.running;
                busy: Dash.start-busy;
                clicked => { Nav.act("toggle-service", ""); }
            }
        }
    }
}

// The line chart (ui/LineChart.kt): smoothed and scaled in Rust (src/pages/
// dashboard.rs chart()) in this element's own logical px, so the viewbox is
// the element size; a 2 dp round stroke over a 14% fill.
component LineChart inherits Rectangle {
    in property <string> line;
    in property <string> area;
    in property <color> tint;
    in property <bool> reports-size;
    clip: true;
    init => { if (root.reports-size) { Dash.chart-w = root.width; Dash.chart-h = root.height; Dash.chart-resized(); } }
    changed width => { if (root.reports-size) { Dash.chart-w = root.width; Dash.chart-resized(); } }
    changed height => { if (root.reports-size) { Dash.chart-h = root.height; Dash.chart-resized(); } }
    if root.area != "": Path {
        x: 0;
        y: 0;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        commands: root.area;
        fill: root.tint.with-alpha(0.14);
    }
    if root.line != "": Path {
        x: 0;
        y: 0;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        commands: root.line;
        stroke: root.tint;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

component SpeedTile inherits Rectangle {
    in property <bool> upload;
    // The rate in bytes, counting to each new sample.
    property <float> rate: Tween.bytes-of(root.upload ? Dash.up-figure : Dash.down-figure, root.upload ? Dash.up-unit : Dash.down-unit);
    property <float> shown: max(0, root.rate);
    animate shown { duration: Theme.motion-medium; easing: Theme.easing-decelerate; }
    property <color> fg: upload ? Theme.s.tertiary : Theme.s.primary;
    // The top padding, the label row, the gap, the figure's and the total's
    // line heights, all from the type scale so they grow with the font scale.
    property <length> text-height: 14px + max(16px, Theme.leading(TextRole.label-medium)) + 4px + Theme.leading(TextRole.headline-medium) + Theme.leading(TextRole.body-small);
    // Square-ish on a phone; capped on wider windows, where the card spans
    // two grid columns.
    property <length> chart-height: Nav.mobile ? max(36px, self.width / 1.06 - text-height - 12px + 2px) : clamp(self.width / 1.06 - text-height - 12px + 2px, 36px, 84px);
    border-radius: Theme.corner-medium;
    background: Theme.s.surface-container-low;
    clip: true;
    height: chart-height - 2px + 12px + text-height;
    LineChart {
        x: 0;
        y: parent.height - self.height;
        width: parent.width;
        height: root.chart-height;
        reports-size: root.upload;
        line: root.upload ? Dash.up-line : Dash.down-line;
        area: root.upload ? Dash.up-area : Dash.down-area;
        tint: root.upload ? Theme.s.tertiary : Theme.s.primary;
    }
    VerticalLayout {
        x: 16px;
        y: 14px;
        width: parent.width - 32px;
        height: root.text-height - 14px;
        alignment: start;
        HorizontalLayout {
            spacing: 4px;
            alignment: start;
            Icon { glyph: root.upload ? Icons.arrow-up : Icons.arrow-down; size: 16px; color: root.fg; y: (parent.height - 16px) / 2; }
            T { text: root.upload ? @tr("Upload") : @tr("Download"); role: TextRole.label-medium; color: Theme.s.on-surface-variant; }
        }
        Rectangle { height: 4px; }
        HorizontalLayout {
            alignment: start;
            RateFigure {
                text: root.rate < 0 ? (root.upload ? Dash.up-figure : Dash.down-figure) : Tween.figure(root.shown);
                pattern: root.rate < 0 ? self.text : Tween.pattern(root.shown);
                role: TextRole.headline-medium;
                avail: root.width - 32px - tile-unit.preferred-width;
            }
            tile-unit := T {
                text: " " + (root.rate < 0 ? (root.upload ? Dash.up-unit : Dash.down-unit) : Tween.unit(root.shown)) + "/s";
                role: TextRole.label-medium;
                color: Theme.s.on-surface-variant;
                vertical-alignment: bottom;
                height: Theme.leading(TextRole.headline-medium) - 4px;
            }
        }
        T {
            text: @tr("Total") + " " + (root.upload ? Dash.up-total : Dash.down-total);
            role: TextRole.body-small;
            color: Theme.s.on-surface-variant;
        }
    }
}

export component SpeedPanel inherits Panel {
    PanelTitle { title: @tr("Network speed"); glyph: Icons.speed; }
    Rectangle { height: 12px; }
    HorizontalLayout {
        spacing: 10px;
        SpeedTile { upload: true; horizontal-stretch: 1; }
        SpeedTile { upload: false; horizontal-stretch: 1; }
    }
}

// The upload or the download on its own card in the grid (FlClash SpeedCard):
// the rate, its peak over the charted window and the total, the chart along
// the bottom edge.
component SpeedCard inherits Rectangle {
    in property <bool> upload;
    property <float> rate: Tween.bytes-of(root.upload ? Dash.up-figure : Dash.down-figure, root.upload ? Dash.up-unit : Dash.down-unit);
    property <float> shown: max(0, root.rate);
    animate shown { duration: Theme.motion-medium; easing: Theme.easing-decelerate; }
    background: Theme.s.surface-container-highest;
    border-radius: Theme.radius;
    clip: true;
    min-height: lay.preferred-height + 56px;
    LineChart {
        x: 0;
        width: parent.width;
        height: 88px;
        y: parent.height - self.height;
        reports-size: root.upload;
        line: root.upload ? Dash.up-line : Dash.down-line;
        area: root.upload ? Dash.up-area : Dash.down-area;
        tint: root.upload ? Theme.s.tertiary : Theme.s.primary;
    }
    lay := VerticalLayout {
        y: 0;
        height: self.preferred-height;
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        HorizontalLayout {
            height: max(Theme.min-target, Theme.leading(TextRole.title-medium));
            spacing: 8px;
            Mid { Icon {
                glyph: root.upload ? Icons.arrow-up : Icons.arrow-down;
                size: 20px;
                color: root.upload ? Theme.s.tertiary : Theme.s.primary;
            } }
            T { text: root.upload ? @tr("Upload") : @tr("Download"); role: TextRole.title-medium; horizontal-stretch: 0; }
            T {
                text: @tr("Peak") + " " + (root.upload ? Dash.up-peak : Dash.down-peak) + "/s";
                role: TextRole.body-small;
                color: Theme.s.on-surface-variant;
                horizontal-alignment: right;
                horizontal-stretch: 1;
            }
        }
        Rectangle { height: 10px; }
        HorizontalLayout {
            alignment: start;
            RateFigure {
                text: root.rate < 0 ? (root.upload ? Dash.up-figure : Dash.down-figure) : Tween.figure(root.shown);
                pattern: root.rate < 0 ? self.text : Tween.pattern(root.shown);
                role: TextRole.display-small;
                avail: root.width - 32px - card-unit.preferred-width;
            }
            // On the figure's baseline: bottom-aligned, raised by the
            // difference of the two descents (about a quarter of the size).
            VerticalLayout {
                alignment: end;
                padding-bottom: 0.25 * (Theme.size(TextRole.display-small) - Theme.size(TextRole.body-medium));
                card-unit := T {
                    text: " " + (root.rate < 0 ? (root.upload ? Dash.up-unit : Dash.down-unit) : Tween.unit(root.shown)) + "/s";
                    role: TextRole.title-small;
                    color: Theme.s.on-surface-variant;
                }
            }
        }
        T {
            text: @tr("Total") + " " + (root.upload ? Dash.up-total : Dash.down-total);
            role: TextRole.body-small;
            color: Theme.s.on-surface-variant;
        }
    }
}

// The outbound mode: an M3 segmented button (single select, outlined, full
// corners at the ends; the selected segment secondary-container with a
// check in place of its icon). In the grid the card is one row: the title,
// then the segments.
component ModeSegments inherits Rectangle {
    height: 40px;
    border-radius: self.height / 2;
    HorizontalLayout {
        for m[i] in Dash.modes: seg := Rectangle {
            property <bool> on: m.key == Dash.mode;
            horizontal-stretch: 1;
            preferred-width: 0px;
            min-width: 48px;
            background: on ? Theme.s.secondary-container : transparent;
            border-top-left-radius: i == 0 ? root.height / 2 : 0px;
            border-bottom-left-radius: i == 0 ? root.height / 2 : 0px;
            border-top-right-radius: i == Dash.modes.length - 1 ? root.height / 2 : 0px;
            border-bottom-right-radius: i == Dash.modes.length - 1 ? root.height / 2 : 0px;
            accessible-role: button;
            accessible-label: m.label;
            accessible-checked: on;
            accessible-action-default => { if (!seg.on) { Nav.act("set-mode", m.mode); } }
            StateLayer {
                border-top-left-radius: seg.border-top-left-radius;
                border-bottom-left-radius: seg.border-bottom-left-radius;
                border-top-right-radius: seg.border-top-right-radius;
                border-bottom-right-radius: seg.border-bottom-right-radius;
                ink: seg.on ? Theme.s.on-secondary-container : Theme.s.on-surface;
                pressed: mta.pressed;
                hover: mta.has-hover;
            }
            mrip := Ripple {
                border-top-left-radius: seg.border-top-left-radius;
                border-bottom-left-radius: seg.border-bottom-left-radius;
                border-top-right-radius: seg.border-top-right-radius;
                border-bottom-right-radius: seg.border-bottom-right-radius;
                ink: seg.on ? Theme.s.on-secondary-container : Theme.s.on-surface;
            }
            if i > 0: Rectangle { x: 0; width: 1px; background: Theme.s.outline; }
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                padding-left: 8px;
                padding-right: 8px;
                Mid { Icon { glyph: seg.on ? Icons.check : m.glyph; size: 18px; color: seg.on ? Theme.s.on-secondary-container : Theme.s.on-surface; } }
                T {
                    text: m.label;
                    role: TextRole.label-large;
                    horizontal-stretch: 0;
                    color: seg.on ? Theme.s.on-secondary-container : Theme.s.on-surface;
                }
            }
            mta := TouchArea {
                height: max(parent.height, Theme.min-target);
                clicked => { if (!seg.on) { Nav.act("set-mode", m.mode); } }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) { mrip.down(self.x + self.mouse-x, self.y + self.mouse-y); }
                    else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { mrip.up(); }
                }
                changed pressed => { if (!self.pressed) { mrip.up(); } }
                changed has-hover => { if (!self.has-hover) { mrip.up(); } }
            }
        }
    }
    Rectangle { border-radius: root.border-radius; border-width: 1px; border-color: Theme.s.outline; }
}

export component ModePanel inherits Panel {
    in property <bool> compact;
    content-alignment: compact ? center : start;
    if !root.compact: PanelTitle { title: @tr("Outbound mode"); glyph: Icons.split; }
    if !root.compact: Rectangle { height: 4px; }
    if root.compact: HorizontalLayout {
        spacing: 16px;
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 8px;
            Mid { Icon { glyph: Icons.split; size: 20px; color: Theme.s.primary; } }
            T { text: @tr("Outbound mode"); role: TextRole.title-medium; }
        }
        Mid { horizontal-stretch: 1; ModeSegments { } }
    }
    if !root.compact: ModeSegments { }
    if !root.compact: Rectangle { height: 4px; }
}

// SubscriptionUsageMeter
export component UsageMeter inherits VerticalLayout {
    in property <string> used;
    in property <string> total;
    in property <float> ratio;
    in property <string> percent;
    spacing: 6px;
    HorizontalLayout {
        T { text: root.used + " / " + root.total; role: TextRole.body-small; color: Theme.s.on-surface-variant; horizontal-stretch: 1; }
        T { text: root.percent; role: TextRole.label-medium; color: root.ratio >= 0.9 ? Theme.s.error : Theme.s.on-surface-variant; }
    }
    ProgressBar {
        value: clamp(root.ratio, 0, 1);
        tint: root.ratio >= 0.9 ? Theme.s.error : root.ratio >= 0.7 ? Theme.s.warning : Theme.s.primary;
    }
}

component StatFigure inherits VerticalLayout {
    in property <string> value;
    in property <string> label;
    in property <bool> loading;
    if root.loading: Skeleton { width: 34px; pill-height: Theme.sp(22); }
    if !root.loading: T { text: root.value; role: TextRole.title-large; emphasized: true; }
    T { text: root.label; role: TextRole.body-small; color: Theme.s.on-surface-variant; }
}

export component ProfilePanel inherits Panel {
    clickable: true;
    clicked => { Nav.act("profile-panel", ""); }
    PanelTitle {
        title: @tr("Profile");
        glyph: Icons.profiles;
        if Dash.profile-remote: Rectangle {
            width: 40px;
            if Dash.profile-updating: Spinner { size: 20px; }
            if !Dash.profile-updating: IconButton {
                glyph: Icons.sync;
                tooltip: @tr("Update");
                icon-size: 20px;
                clicked => { Nav.act("update-selected-profile", ""); }
            }
        }
        Mid { Icon { glyph: Icons.chevron-forward; color: Theme.s.on-surface-variant; } }
    }
    Rectangle { height: 4px; }
    // Compose: the name (weight 1, fill = false), 8 dp, the core chip, then the 32 dp switch button right after it.
    HorizontalLayout {
        alignment: start;
        T {
            text: App.remote ? @tr("Remote configuration") : Dash.has-profile ? Dash.profile-name : @tr("Add profile");
            role: TextRole.title-medium;
            emphasized: true;
            horizontal-stretch: 0;
        }
        if Dash.has-profile && Dash.profile-core != "": Rectangle { width: 8px; }
        if Dash.has-profile && Dash.profile-core != "": Mid { Rectangle {
            width: core-chip.preferred-width + 16px;
            core-chip := T {
                text: Dash.profile-core;
                role: TextRole.label-medium;
                color: Theme.s.on-secondary-container;
            }
            height: core-chip.preferred-height + 4px;
            border-radius: Theme.corner-small;
            background: Theme.s.secondary-container;
        } }
        if !App.remote && App.profile-count > 1: Mid { IconButton {
            glyph: Icons.swap;
            tooltip: @tr("Switch profile");
            icon-size: 20px;
            enabled: !App.transitioning;
            
            clicked => { Nav.form("profiles-picker", ""); }
        } }
    }
    if Dash.has-profile || App.remote: VerticalLayout {
        HorizontalLayout {
            spacing: 12px;
            T { text: Dash.profile-updated; role: TextRole.body-small; color: Theme.s.on-surface-variant; horizontal-stretch: 1; }
            T {
                text: Dash.profile-days != "" ? Dash.profile-days : Dash.profile-source;
                role: TextRole.body-small;
                color: Dash.profile-days-tone == 2 ? Theme.s.error : Dash.profile-days-tone == 1 ? Theme.s.warning : Theme.s.on-surface-variant;
                horizontal-stretch: 0;
            }
        }
        Rectangle { height: 14px; }
        if Dash.profile-usage: UsageMeter {
            used: Dash.usage-used;
            total: Dash.usage-total;
            ratio: Dash.usage-ratio;
            percent: Dash.usage-percent;
        }
        if !Dash.profile-usage: HorizontalLayout {
            StatFigure { value: Dash.stat-groups; label: @tr("Proxy groups"); loading: Dash.stats-loading; }
            Rectangle { horizontal-stretch: 1; }
            StatFigure { value: Dash.stat-outbounds; label: @tr("Outbounds"); loading: Dash.stats-loading; }
            Rectangle { horizontal-stretch: 1; }
            StatFigure { value: Dash.stat-rules; label: @tr("Routing rules"); loading: Dash.stats-loading; }
        }
    }
}

// GroupIconStack
component GroupIconStack inherits Rectangle {
    in property <[string]> letters;
    in property <int> rest;
    property <length> size: 40px;
    property <length> step: size - 8px;
    property <int> count: letters.length + (rest > 0 ? 1 : 0);
    width: count * size - (count - 1) * 8px;
    height: size;
    for l[i] in root.letters: Rectangle {
        x: i * root.step - 3px;
        y: -3px;
        width: root.size + 6px;
        height: root.size + 6px;
        border-radius: Theme.corner-medium + 3px;
        background: Theme.s.surface-container-highest;
        Rectangle {
            x: 3px;
            y: 3px;
            width: root.size;
            height: root.size;
            border-radius: Theme.corner-medium;
            background: Theme.s.secondary-container;
            T { text: l; role: TextRole.label-medium; color: Theme.s.on-secondary-container; horizontal-alignment: center; }
        }
    }
    if root.rest > 0: Rectangle {
        x: root.letters.length * root.step - 3px;
        y: -3px;
        width: root.size + 6px;
        height: root.size + 6px;
        border-radius: Theme.corner-medium + 3px;
        background: Theme.s.surface-container-highest;
        Rectangle {
            x: 3px;
            y: 3px;
            width: root.size;
            height: root.size;
            border-radius: Theme.corner-medium;
            background: Theme.s.surface-container-high;
            T { text: "+" + root.rest; role: TextRole.label-medium; color: Theme.s.on-surface-variant; horizontal-alignment: center; }
        }
    }
}

export component GroupsPanel inherits Panel {
    clickable: Dash.group-count > 0;
    clicked => { Nav.form("proxies", ""); }
    PanelTitle {
        title: @tr("Proxy groups");
        glyph: Icons.layers;
        HorizontalLayout {
            spacing: 6px;
            if Dash.timeout-count > 0: Mid { Chip { label: @tr("Timeout") + " " + Dash.timeout-count; tone: 2; } }
            if Dash.group-count > 0: Mid { Icon { glyph: Icons.chevron-forward; color: Theme.s.on-surface-variant; } }
        }
    }
    Rectangle { height: 4px; }
    if Dash.group-count == 0: VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 12px;
        padding-bottom: 24px;
        spacing: 6px;
        IconBadge { glyph: Icons.layers; size: 56px; x: (parent.width - 56px) / 2; }
        T {
            text: App.running ? @tr("No proxy groups in this configuration") : @tr("Start the service to view proxy groups");
            role: TextRole.title-small;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
