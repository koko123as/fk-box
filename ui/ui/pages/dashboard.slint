            T { text: Dash.group-count; role: TextRole.display-small; emphasized: true; vertical-alignment: bottom; }
            T { text: " " + @tr("Groups"); role: TextRole.body-medium; color: Theme.s.on-surface-variant; vertical-alignment: bottom; height: Theme.leading(TextRole.display-small) - 8px; }
        }
        Mid { GroupIconStack { letters: Dash.group-letters; rest: Dash.group-rest; } }
    }
}

// MemoryBar + legend (MemorySummary)
export component MemorySummary inherits VerticalLayout {
    // The total counts to each new sample.
    property <float> mem: Dash.memory-empty ? -1 : Tween.bytes-of(Dash.memory-figure, Dash.memory-unit);
    property <float> mem-shown: max(0, root.mem);
    animate mem-shown { duration: Theme.motion-medium; easing: Theme.easing-decelerate; }
    T {
        text: root.mem < 0 ? Dash.memory-figure + (Dash.memory-empty ? "" : " " + Dash.memory-unit) : Tween.figure(root.mem-shown) + " " + Tween.unit(root.mem-shown);
        role: TextRole.headline-medium;
        emphasized: true;
    }
    Rectangle { height: 14px; }
    bar := Rectangle {
        height: 8px;
        border-radius: 4px;
        clip: true;
        background: Theme.s.secondary-container;
        property <float> sum: Dash.memory-app-weight + Dash.memory-core-weight;
        if bar.sum > 0 && !Dash.memory-remote: Rectangle {
            x: 0;
            width: (bar.width - (Dash.memory-core-weight > 0 && Dash.memory-app-weight > 0 ? 2px : 0)) * Dash.memory-app-weight / bar.sum;
            background: Theme.s.primary;
        }
        if bar.sum > 0: Rectangle {
            width: (bar.width - (Dash.memory-core-weight > 0 && Dash.memory-app-weight > 0 && !Dash.memory-remote ? 2px : 0)) * Dash.memory-core-weight / bar.sum;
            x: bar.width - self.width;
            background: Theme.s.tertiary;
        }
    }
    Rectangle { height: 10px; }
    HorizontalLayout {
        spacing: 16px;
        alignment: start;
        if !Dash.memory-remote: HorizontalLayout {
            spacing: 6px;
            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.s.primary; y: (parent.height - 8px) / 2; }
            T { text: @tr("App"); role: TextRole.body-small; color: Theme.s.on-surface-variant; }
            T { text: Dash.memory-app; role: TextRole.label-medium; }
        }
        HorizontalLayout {
            spacing: 6px;
            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.s.tertiary; y: (parent.height - 8px) / 2; }
            T { text: @tr("Core"); role: TextRole.body-small; color: Theme.s.on-surface-variant; }
            T { text: Dash.memory-core; role: TextRole.label-medium; }
        }
    }
}

