        padding-left: 16px;
        padding-right: 20px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 14px;
        Mid { IconBadge {
            glyph: Icons.vpn;
            size: 44px;
            container: App.running ? Theme.s.primary : Theme.s.surface-container-high;
            tint: App.running ? Theme.s.on-primary : Theme.s.on-surface-variant;
        } }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            T { text: "VPN"; role: TextRole.title-medium; }
            T {
                text: App.transitioning ? Dash.status-label : App.running ? @tr("Turned on") : @tr("Turned off");
                role: TextRole.body-small;
                color: Theme.s.on-surface-variant;
            }
        }
